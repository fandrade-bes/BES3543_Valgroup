            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM M1_LA_EMP_GARRA
VAR
	fb_POWER				: MC_Power;
	fb_RESET				: MC_Reset;
	fb_LER_POS_ATUAL		: MC_ReadActualPosition;
	fb_HOME					: MC_Home;
	fb_MOVER_ABS			: MC_MoveAbsolute;
	fb_MOVER_REL			: MC_MoveRelative;
	fb_MOVER_JOG			: MC_JOG;
	fb_MOVER_STOP			: MC_STOP;

	bit_POWER_ERRO			: BOOL;
	bit_HOME_ERRO			: BOOL;
	bit_MOVE_ABS_ERRO		: BOOL;
	bit_MOVE_REL_ERRO		: BOOL;
	bit_MOVE_JOG_ERRO		: BOOL;
	
	bit_HABILITADO			: BOOL;
	bit_HOME_FEITO			: BOOL;
	bit_HOME_FAZENDO		: BOOL;
	bit_MOVE_ABS_FEITO		: BOOL;
	bit_MOVE_ABS_FAZENDO	: BOOL;
	bit_MOVE_REL_FEITO		: BOOL;
	bit_MOVE_REL_FAZENDO	: BOOL;
	bit_HABILITAR_EIXOS		: BOOL;
	bit_EIXO_DRV_MOVER_ABS	: BOOL;
	bit_DRV_JOG_FORWARD		: BOOL;
	bit_DRV_JOG_REVERSE		: BOOL;
	bit_DRV_JOG_STOP		: BOOL;
	bit_SERVOS_RESET		: BOOL;
	info_MOTOR_PASSO_POS_ATUAL: LREAL;
END_VAR


VAR_INPUT
	
	ABS_MOVER				: EIXO_MOVER;
	REL_MOVER				: EIXO_MOVER;
	
	bit_FAZER_HOME			: BOOL;
END_VAR</Single>
