            <Single Name="TextBlobForSerialisation" Type="string">TYPE RECEITA :
STRUCT
	NOME 						: STRING;
	
	
//RECEITAS EMPILHADOR
	//CAMADAS MÁXIMAS DE EMPILHAMENTO / POSIÇÕES MÁXIMAS DE PEGA
	int_NUM_MAX_CAMADAS_EMPILHADOR	: INT;
	
	//CAMADA MÁXIMA DE EMPILHAMENTO ANTES DE ABAIXAR ATUADOR
	int_NUM_DESCER_MESA_EMPILHADOR	: INT;

	//GARRA EMPILHADOR
	coord_PRE_PEGA_GARRA_EMPILHADOR				: EIXO_MOVER;
	coord_PEGA_GARRA_EMPILHADOR					: EIXO_MOVER;
	
	sp_PRE_ENTREGA_GARRA_EMPILHADOR_POSICAO		: ARRAY[1..7] OF LREAL;
	sp_ENTREGA_GARRA_EMPILHADOR_VELOCIDADE		: LREAL;
	sp_ENTREGA_GARRA_EMPILHADOR_ACELERACAO		: LREAL;
	sp_ENTREGA_GARRA_EMPILHADOR_DESACELERACAO	: LREAL;
	
	sp_ENTREGA_GARRA_EMPILHADOR_POSICAO				: ARRAY[1..7] OF LREAL;
	sp_PRE_ENTREGA_GARRA_EMPILHADOR_VELOCIDADE		: LREAL;
	sp_PRE_ENTREGA_GARRA_EMPILHADOR_ACELERACAO		: LREAL;
	sp_PRE_ENTREGA_GARRA_EMPILHADOR_DESACELERACAO	: LREAL;
	
	tmr_TRANSICAO_ENTREGA_EMPILHADOR			: ARRAY[1..7] OF TIME;
	
	sp_POSICAO_ABRE_GARRA_EMPILHADOR			: ARRAY[1..7] OF LREAL;
	
	
	//EIXO X EMPILHADOR
	coord_X_EMPILHADOR_POS						: ARRAY[1..7] OF EIXO_MOVER;
	coord_X_EMPILHADOR_ENTREGA					: EIXO_MOVER;
	coord_X_EMPILHADOR_INSPECAO					: EIXO_MOVER;
	
	
	//MESA GIRO EMPILHADOR
	coord_MESA_GIRO_INICIAL				: EIXO_MOVER;
	coord_MESA_GIRO_FINAL				: EIXO_MOVER;
	coord_MESA_GIRO_INSPECAO			: EIXO_MOVER;
	
	
//RECEITAS ENVOLVEDOR
