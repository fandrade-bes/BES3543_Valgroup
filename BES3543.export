	GVL_PESAGEM.est_REJEITO_PRODUTO					:=	FALSE;
	GVL_PESAGEM.est_MESA_DE_TRANSFERENCIA_REVERSE	:=	FALSE;
	GVL_PESAGEM.est_MESA_DE_TRANSFERENCIA			:=	FALSE;
	bit_SHIFT_HIST_PESO								:= 	FALSE;
	LA_IHM.bit_STATUS_PESAGEM						:=	0;
	
	est_BALANCA										:=	FALSE;
	est_BALANCA_REVERSE								:=	FALSE;
	
	passo_PESAGEM	:=	10;
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
10://aguarda feedback de sensor de avanço

	IF sens_TRANSFERENCIA_AV THEN
		GVL_PESAGEM.bit_PESANDO_PILHA_SACOLA := FALSE;
		passo_PESAGEM						 :=	999;
	END_IF


//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
999://inicia ciclo com máquina rodando e sem processo de pesagem de sacola iniciado

	IF (LA_GERAL.bit_MAQUINA_RODANDO OR TESTE) AND NOT GVL_PESAGEM.bit_PESANDO_PILHA_SACOLA	THEN
		passo_PESAGEM				:=	1000;
		LA_IHM.bit_STATUS_PESAGEM	:=	0;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1000://decide em qual direção ligar a esteira de transferencia baseado na prioridade de recebimento de lado da esteira de saída do envolvedor

	IF LA_ENV.bit_ENVOLVEDOR_ENVIANDO_PILHA THEN
		GVL_PESAGEM.est_MESA_DE_TRANSFERENCIA_REVERSE	:=	FALSE;
		GVL_PESAGEM.bit_ENVOLVEDOR_1					:=	TRUE;
		GVL_PESAGEM.bit_ENVOLVEDOR_2					:=	FALSE;
		GVL_PESAGEM.est_MESA_DE_TRANSFERENCIA			:=	TRUE;
		passo_PESAGEM									:=	1001;
	ELSIF GVL_PESAGEM.bit_ENVOLVEDOR_ENVIANDO_PILHA_2 AND NOT LA_ENV.bit_ENVOLVEDOR_ENVIANDO_PILHA	THEN
		GVL_PESAGEM.est_MESA_DE_TRANSFERENCIA_REVERSE	:=	true;
		GVL_PESAGEM.bit_ENVOLVEDOR_1					:=	FALSE;
		GVL_PESAGEM.bit_ENVOLVEDOR_2					:=	TRUE;
		GVL_PESAGEM.est_MESA_DE_TRANSFERENCIA			:=	TRUE;
		passo_PESAGEM									:=	1001;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1001://declara inicio de processo de psagem da pilha de sacola para intertravamento de recebimento de pilha do lado 1 ou lado 2
	
	GVL_PESAGEM.bit_PESANDO_PILHA_SACOLA	:=	TRUE;
	passo_PESAGEM							:=	1002;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1002://aguarda tempo após acionar sensor para desligar esteira de transferência

	IF sens_MESA_TRANSFER_1 OR sens_MESA_TRANSFER_2	THEN
		tmr_TRANSFERINDO_PILHA.IN	:=	TRUE;
	END_IF
	
	IF tmr_TRANSFERINDO_PILHA.Q	THEN
		tmr_TRANSFERINDO_PILHA.IN						:=	FALSE;
		GVL_PESAGEM.est_MESA_DE_TRANSFERENCIA_REVERSE	:=	FALSE;
		GVL_PESAGEM.est_MESA_DE_TRANSFERENCIA			:=	FALSE;
		passo_PESAGEM									:=	1003;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1003://recua atuador de transferencia e aguarda feedback de sensor recuado

	GVL_PESAGEM.bit_valv_ACIONAMENTO_TRANSFERENCIA	:=	FALSE;

	IF sens_TRANSFERENCIA_RC	THEN
		passo_PESAGEM	:=	1004;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1004://Liga esteiraS de transferencia e da balança para transportar pilha para balança

	GVL_PESAGEM.est_TRANSPORTADOR_PESAGEM	:=	TRUE;
	est_BALANCA								:=	TRUE;
	est_BALANCA_REVERSE						:=	FALSE;
	LA_IHM.bit_STATUS_PESAGEM				:=	1;
	
	passo_PESAGEM							:=	1005;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1005: //espera confirmação de borda de descida de sensor de entrada da balança

	IF f_trig_ENTRADA.Q	THEN
		tmr_PARADA_ESTEIRA.IN		:= TRUE;
	END_IF
	
	IF	tmr_PARADA_ESTEIRA.Q	THEN
			tmr_PARADA_ESTEIRA.IN		:= FALSE;
			tmr_VERIFICA_PESO.IN		:= TRUE;
			est_BALANCA					:=	FALSE;
			passo_PESAGEM				:=	3000;
	END_IF
		
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3000://verifica se peso atual está condizente com a receita 

	IF tmr_VERIFICA_PESO.Q	THEN
			GVL_PESAGEM.status_VALOR_PESAGEM		:= Peso_medido;
			LA_IHM.hist_VALOR_PESAGEM_ARRAY[0]	:=	Peso_medido;
			tmr_VERIFICA_PESO.IN					:= FALSE;
			passo_PESAGEM							:=	1006;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1006://verifica se peso atual está condizente com a receita 

	IF GVL_PESAGEM.bit_PESAGEM_OK THEN
		GVL_PESAGEM.bit_PESAGEM_ATUAL	:=	TRUE;
		GVL_PESAGEM.array_HIST_PESO.0	:=	FALSE;
		LA_IHM.bit_STATUS_PESAGEM		:=	2;
		passo_PESAGEM					:=	1007;
	ELSE
		GVL_PESAGEM.bit_PESAGEM_ERRO	:=	TRUE;
		GVL_PESAGEM.array_HIST_PESO.0	:=	TRUE;
		LA_IHM.bit_STATUS_PESAGEM		:=	3;
		passo_PESAGEM					:=	1008;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1007://caso peso esteja ok, aguarda borda de descida do sensor de saída da balança
	est_BALANCA					:=	TRUE;
	
	IF f_trig_SAIDA.Q	THEN
		passo_PESAGEM					:=	1009;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1008://caso peso esteja com erro, gira esteira da balança ao contrário

	est_BALANCA_REVERSE						:=	TRUE;
	passo_PESAGEM							:=	1009;

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1009://Verifica feedback da balança. Se está OK, para a esteira e prepara para reinicio de ciclo. Se não, liga a esteira invertida e prepara para rejeito

	IF GVL_PESAGEM.bit_PESAGEM_ATUAL	THEN
		GVL_PESAGEM.est_TRANSPORTADOR_PESAGEM	:=	FALSE;
		est_BALANCA								:=	FALSE;
		GVL_PESAGEM.bit_PESAGEM_ATUAL				:=	FALSE;
		passo_PESAGEM							:=	1011;
	ELSIF GVL_PESAGEM.bit_PESAGEM_ERRO	THEN
		GVL_PESAGEM.est_TRANSPORTADOR_PESAGEM			:=	TRUE;
		GVL_PESAGEM.bit_ENVOLVEDOR_1					:=	FALSE;
		GVL_PESAGEM.bit_ENVOLVEDOR_2					:=	FALSE;
		GVL_PESAGEM.bit_PESAGEM_ERRO					:=	FALSE;
		GVL_PESAGEM.est_TRANSPORTADOR_PESAGEM_REVERSE	:=	TRUE;
		GVL_PESAGEM.est_REJEITO_PRODUTO					:=	TRUE;
		passo_PESAGEM									:=	1010;
	END_IF

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1010://aguarda pilha chegar no final da esteira de rejeito para desligar esteiras

	IF sens_PRODUTO_REJEITO	THEN
		GVL_PESAGEM.est_TRANSPORTADOR_PESAGEM			:=	FALSE;
		GVL_PESAGEM.est_TRANSPORTADOR_PESAGEM_REVERSE	:=	FALSE;
		GVL_PESAGEM.est_REJEITO_PRODUTO					:=	FALSE;
		est_BALANCA_REVERSE								:=	FALSE;
		passo_PESAGEM									:=	1011;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1011://Desloca informações de peso e etiqueta

	GVL_PESAGEM.array_ETIQUETA		:=	SHL(GVL_PESAGEM.array_ETIQUETA, 1);
	GVL_PESAGEM.array_HIST_PESO		:=	SHL(GVL_PESAGEM.array_HIST_PESO, 1);
	bit_SHIFT_HIST_PESO				:=	TRUE;
	GVL_PESAGEM.array_HIST_PESO.0	:= 	FALSE;
	LA_IHM.bit_STATUS_PESAGEM		:=	0;
	passo_PESAGEM					:=	1012;
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1012://aciona atuador de transferencia  e aguarda feedback do sensor de avanço para reiniciar ciclo e declarar que não está mais pesando sacola

	bit_SHIFT_HIST_PESO								:= FALSE;
	GVL_PESAGEM.bit_valv_ACIONAMENTO_TRANSFERENCIA	:= TRUE;
	
	IF sens_TRANSFERENCIA_AV	THEN
		GVL_PESAGEM.bit_PESANDO_PILHA_SACOLA := FALSE;
		LA_IHM.hist_VALOR_PESAGEM_ARRAY[0]	 := 0;
		passo_PESAGEM						 :=	999;
	END_IF

END_CASE





//------------//-----------LÓGICAS EXTRAS---------------//----------------------//--------------------------//

//-----------CHECAGEM DE PESO-------//--------------------//---------------------//

IF	Peso_medido	&gt;= PVAR.rec_ATUAL.num_PESO_SACOLA - 500	AND
	Peso_medido	&lt;= PVAR.rec_ATUAL.num_PESO_SACOLA + 500	THEN
			GVL_PESAGEM.bit_PESAGEM_OK	:= TRUE;
	ELSE
			GVL_PESAGEM.bit_PESAGEM_OK	:= FALSE;
	END_IF


//-----------ATUADORES-------------//--------------------//---------------------//

//ATUADOR TRANSFERENCIA PARA SEÇÃO DE PESAGEM
IF GVL_PESAGEM.bit_valv_ACIONAMENTO_TRANSFERENCIA	THEN
	valv_TRANSFERENCIA_RC	:=	FALSE;
	valv_TRANSFERENCIA_AV	:=	TRUE;
ELSE
	valv_TRANSFERENCIA_RC	:=	TRUE;
	valv_TRANSFERENCIA_AV	:=	FALSE;
END_IF


//DEFINE SE BIT DA PRIMEIRA CASA SERÁ TRUE OU FALSE PARA DECIDIR ETIQUETA
IF GVL_PESAGEM.bit_ENVOLVEDOR_1	THEN
		GVL_PESAGEM.array_ETIQUETA.0 :=	1;
ELSIF GVL_PESAGEM.bit_ENVOLVEDOR_2	THEN
		GVL_PESAGEM.array_ETIQUETA.0 :=	0;
END_IF


//HISTÓRICO DE VALOR DE PESO MEDIDO
LA_IHM.cop_HIST_PESAGEM(Source:= ADR(LA_IHM.hist_VALOR_PESAGEM_ARRAY[0]) , Dest:= ADR(LA_IHM.hist_VALOR_PESAGEM_ARRAY_AUX[0]), Length:= 10, Trigger:= bit_SHIFT_HIST_PESO);
LA_IHM.cop_HIST_PESAGEM_AUX(Source:= ADR(LA_IHM.hist_VALOR_PESAGEM_ARRAY_AUX[0]) , Dest:= ADR(LA_IHM.hist_VALOR_PESAGEM_ARRAY[1]), Length:= 9, Trigger:= bit_SHIFT_HIST_PESO);


//-----------TIMERS-------------//--------------------//---------------------//

tmr_TRANSFERINDO_PILHA(PT:= T#2.6S );
tmr_PARADA_ESTEIRA	(PT:= T#300MS);
tmr_VERIFICA_PESO	(PT:= T#1000MS);
f_trig_ENTRADA(CLK:= sens_ENTRADA_BALANCA);
f_trig_SAIDA(CLK:= sens_SAIDA_BALANCA);

</Single>
            <Single Name="LineInfoPersistence" Type="string">ac096d08-095f-4ab7-a631-ca97e7a2eb16_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM D00_PESAGEM
VAR
	reset_rotina		: BOOL;
	bit_SHIFT_HIST_PESO : BOOL;
	passo_PESAGEM		: INT := 9;
	
	f_trig_ENTRADA	:	F_TRIG;
	f_trig_SAIDA	:	F_TRIG;
	
	tmr_TRANSFERINDO_PILHA			: TON;
	tmr_PARADA_ESTEIRA				: TON;
	tmr_VERIFICA_PESO				: TON;
	TESTE: BOOL;
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">ac096d08-095f-4ab7-a631-ca97e7a2eb16_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">1341</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">eb5a6f7f-d802-4f6b-b034-33a2293abce7</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">D_PESAGEM</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">a5ea018a-56e4-428a-ad48-8dcb450fb5d6</Single>
        <Single Name="ParentGuid" Type="System.Guid">00000000-0000-0000-0000-000000000000</Single>
        <Single Name="Name" Type="string">D01_EST_ETIQUETA</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">21af5390-2942-461a-bf89-951aaf6999f1</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">eb5a6f7f-d802-4f6b-b034-33a2293abce7</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639240299190280744</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">
CASE passo_ETIQUETA OF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
09://reset rotina

	bit_IMPRIMIR_ETIQUETA_1	:=	FALSE;
	bit_IMPRIMIR_ETIQUETA_2	:=	FALSE;
	tmr_ETIQUETA.IN			:=	FALSE;
	tmr_PARAR_ESTEIRA.IN	:=	FALSE;
	LA_GERAL.do_SAIDA_COLAR_EQUIQUETA	:=	FALSE;
	
	passo_ETIQUETA			:=	999;
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
999://inicia se a máquina estiver rodando

	IF LA_GERAL.bit_MAQUINA_RODANDO OR TESTE	THEN
		passo_ETIQUETA			:=	1000;
	END_IF

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1000://Caso o feedback da balança corresponda como peso OK, liga esteira estagio 1

	IF GVL_PESAGEM.bit_PESAGEM_ATUAL	THEN
		GVL_PESAGEM.est_TRANSPORTADOR_ESTAGIO_1	:=	TRUE;
		passo_ETIQUETA			:=	1001;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1001://assim que chegar ao limite da esteira estágio 1, desliga a esteira

	IF sens_PRODUTO_BALANCA	THEN
		tmr_PARAR_ESTEIRA.IN	:=	TRUE;
	END_IF
	
	IF tmr_PARAR_ESTEIRA.Q	THEN
		tmr_PARAR_ESTEIRA.IN					:=	FALSE;
		GVL_PESAGEM.est_TRANSPORTADOR_ESTAGIO_1	:=	FALSE;
		LA_GERAL.do_SAIDA_COLAR_EQUIQUETA		:=	TRUE;
		passo_ETIQUETA							:=	1002;
	END_IF
	

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1002://aguarda confirmação de que etiquetadora está operante
(*	IF bit_ETIQUETA_PRONTA	THEN
		passo_ETIQUETA			:=	1003;
	END_IF*)
	
	IF NOT sens_ETIQUETADORA AND NOT GVL_PESAGEM.bit_PESAGEM_ATUAL THEN
		
		tmr_ETIQUETA.IN		:=	TRUE;
		
	END_IF
	
	IF tmr_ETIQUETA.Q	THEN
		tmr_ETIQUETA.IN						:=	FALSE;
		LA_GERAL.do_SAIDA_COLAR_EQUIQUETA	:=	FALSE;
		passo_ETIQUETA		:=	999;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1003://decide qual o tipo de etiqueta que vai imprimir

	IF GVL_PESAGEM.array_ETIQUETA.1	THEN
		bit_IMPRIMIR_ETIQUETA_1	:=	TRUE;
	ELSE
		bit_IMPRIMIR_ETIQUETA_2	:=	TRUE;
	END_IF
	
	passo_ETIQUETA			:=	1004;
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1004://aguarda status de impressão

	IF bit_ETIQUETA_IMPRIMINDO	THEN
		passo_ETIQUETA			:=	1005;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1005://aguarda confirmação de impressão e liga esteiras

	IF bit_ETIQUETA_CONCLUIDO AND NOT sens_PRODUTO_MERGER	THEN
		GVL_PESAGEM.est_TRANSPORTADOR_ESTAGIO_1	:=	TRUE;
		GVL_PESAGEM.est_TRANNSPORTADOR_MERGER	:=	TRUE;
		passo_ETIQUETA			:=	1006;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1006://espera pilha de sacolas sair do sensor para reiniciar ciclo

	IF NOT sens_ETIQUETADORA THEN
		passo_ETIQUETA			:=	999;
	END_IF


END_CASE




tmr_PARAR_ESTEIRA(PT:= T#1.8S );
tmr_ETIQUETA(PT:= T#300MS );</Single>
            <Single Name="LineInfoPersistence" Type="string">a5ea018a-56e4-428a-ad48-8dcb450fb5d6_Impl_LineIds</Single>
