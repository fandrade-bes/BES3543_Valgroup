      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">
//BOTÃO CARREGAR: Move a receita selecionada da lista de receitas para ser mostrada na tela
	IF	LA_IHM.bt_CARREGAR_RECEITA	THEN
			LA_GERAL.rec_IHM	:= PVAR.RECEITAS[LA_IHM.int_RECEITA_ATUAL];
			LA_IHM.int_STATUS_RECEITA	:= 1;
	END_IF
	
//BOTÃO SALVAR: Move a receita que está sendo mostrada na tela para a receita selecionada da lista de receitas
	IF	LA_IHM.bt_SALVAR_RECEITA	THEN
			PVAR.RECEITAS[LA_IHM.int_RECEITA_ATUAL] := LA_GERAL.rec_IHM;
			LA_IHM.int_STATUS_RECEITA	:= 2;
	END_IF
	
//BOTÃO UPLOAD: Move a receita que está atualmente sendo executada para ser mostrada na tela
	IF	LA_IHM.bt_UPLOAD_RECEITA	THEN
			LA_GERAL.rec_IHM	:= PVAR.rec_ATUAL;
			LA_IHM.int_STATUS_RECEITA	:= 3;
	END_IF
	
//BOTÃO DOWNLOAD: Move a receita que está sendo mostrada na tela para a que será executada
	IF	LA_IHM.bt_DOWNLOAD_RECEITA	THEN
			PVAR.rec_ATUAL	:= LA_GERAL.rec_IHM;
			LA_IHM.int_STATUS_RECEITA	:= 4;
	END_IF
	
//STATUS RECEITA
	IF tmr_STATUS_RECEITA.Q		THEN
			LA_IHM.int_STATUS_RECEITA	:= 0;
	END_IF
		
//RECEITA SELECIONADA
	LA_GERAL.rec_SELECIONADA	:= PVAR.RECEITAS[LA_IHM.int_RECEITA_ATUAL];
	
//SELECAO DO MODO DE OPERAÇÃO
		
(*	IF GVL_IHM.bit_SELEC_MODO_2	THEN
			GVL_IHM.int_RECEITA_QNTD_CORES := 2;
	END_IF
	
	IF GVL_IHM.bit_SELEC_MODO_3	THEN
			GVL_IHM.int_RECEITA_QNTD_CORES := 3;
	END_IF
	
	IF GVL_IHM.bit_SELEC_MODO_4	THEN
			GVL_IHM.int_RECEITA_QNTD_CORES := 4;
	END_IF*)
		
//SELECAO DE RECEITA PARA DUAS CORES
		IF	LA_IHM.bit_SELEC_RECEITA_1	THEN	
				LA_IHM.int_RECEITA_ATUAL	:= 1;
		END_IF
		
		IF	LA_IHM.bit_SELEC_RECEITA_2	THEN	
				LA_IHM.int_RECEITA_ATUAL	:= 2;
		END_IF
		
		IF	LA_IHM.bit_SELEC_RECEITA_3	THEN	
				LA_IHM.int_RECEITA_ATUAL	:= 3;
		END_IF
		
		IF	LA_IHM.bit_SELEC_RECEITA_4	THEN	
				LA_IHM.int_RECEITA_ATUAL	:= 4;
		END_IF
		
		IF	LA_IHM.bit_SELEC_RECEITA_5	THEN	
				LA_IHM.int_RECEITA_ATUAL	:= 5;
		END_IF
		
		IF	LA_IHM.bit_SELEC_RECEITA_6	THEN	
				LA_IHM.int_RECEITA_ATUAL	:= 6;
		END_IF
		
		IF	LA_IHM.bit_SELEC_RECEITA_7	THEN	
				LA_IHM.int_RECEITA_ATUAL	:= 7;
		END_IF
		
		IF	LA_IHM.bit_SELEC_RECEITA_8	THEN	
				LA_IHM.int_RECEITA_ATUAL	:= 8;
		END_IF
		
		IF	LA_IHM.bit_SELEC_RECEITA_9	THEN	
				LA_IHM.int_RECEITA_ATUAL	:= 9;
		END_IF
		
		IF	LA_IHM.bit_SELEC_RECEITA_10	THEN	
				LA_IHM.int_RECEITA_ATUAL	:= 10;
		END_IF
	
	
//NOMES DAS RECEITAS
				LA_IHM.nome_RECEITA_1	:= PVAR.RECEITAS[1].NOME;
				LA_IHM.nome_RECEITA_2	:= PVAR.RECEITAS[2].NOME;
				LA_IHM.nome_RECEITA_3	:= PVAR.RECEITAS[3].NOME;
				LA_IHM.nome_RECEITA_4	:= PVAR.RECEITAS[4].NOME;
				LA_IHM.nome_RECEITA_5	:= PVAR.RECEITAS[5].NOME;
				LA_IHM.nome_RECEITA_6	:= PVAR.RECEITAS[6].NOME;
				LA_IHM.nome_RECEITA_7	:= PVAR.RECEITAS[7].NOME;
				LA_IHM.nome_RECEITA_8	:= PVAR.RECEITAS[8].NOME;
				LA_IHM.nome_RECEITA_9	:= PVAR.RECEITAS[9].NOME;
				LA_IHM.nome_RECEITA_10	:= PVAR.RECEITAS[10].NOME;
		
	
//================================================================================================================================================================================
//TIMERS
tmr_STATUS_RECEITA (IN:= (NOT LA_IHM.bt_CARREGAR_RECEITA AND NOT LA_IHM.bt_SALVAR_RECEITA AND NOT LA_IHM.bt_UPLOAD_RECEITA AND NOT LA_IHM.bt_DOWNLOAD_RECEITA), PT:= T#5S);
</Single>
