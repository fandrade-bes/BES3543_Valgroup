      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// //ATIVAÇÃO DE ÍCONE DE ALARME
// IF 		GVL_CELULA.status_alarm_EIXO_Y 	 		 &gt; 0	OR
// 		GVL_CELULA.status_alarm_EIXO_Z 	 		 &gt; 0 	OR
// 		GVL_CELULA.status_alarm_EIXO_COLMEIA_1	 &gt; 0	OR 
// 		GVL_CELULA.status_alarm_EIXO_COLMEIA_2	 &gt; 0	OR
// 		GVL_CELULA.status_alarm_HOME_EIXO_Y		 &gt; 0	OR
// 		GVL_CELULA.status_alarm_HOME_EIXO_Z		 &gt; 0	OR
// 		GVL_CELULA.status_alarm_HOME_DIVERTER		 &gt; 0	OR
// 		GVL_CELULA.status_alarm_atu_DIVERTER_FREIO &gt; 0 	OR 
// 		GVL_CELULA.status_alarm_atu_FORM_EMPURADDOR &gt; 0	OR
// 		GVL_CELULA.status_alarm_atu_FORM_FORMADOR	 &gt; 0	OR
// 		GVL_CELULA.status_alarm_atu_FORM_PEGA_CAIXA &gt; 0 	OR
// 		GVL_CELULA.status_alarm_atu_FORM_VACUO	 &gt; 0	OR
// 		GVL_CELULA.status_alarm_atu_MANI_GARRA	 &gt; 0	OR
// 		GVL_CELULA.status_alarm_atu_POSICIONA_PRODUTO &gt; 0 OR
// 		GVL_CELULA.status_alarm_atu_PRODUTO_FREIO	 &gt; 0 	OR
// 		GVL_CELULA.status_alarm_atu_SEPARADOR_Y	 &gt; 0 	OR
// 		GVL_CELULA.status_alarm_atu_SEPARADOR_Z	 &gt; 0 	OR
// 		GVL_CELULA.status_alarm_atu_STOP_ENTREGA	 &gt; 0 	OR
// 		GVL_CELULA.status_alarm_atu_STOP_PRE_ENTREGA &gt; 0	OR
