            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK COP

VAR_INPUT
  Source : POINTER TO DINT;  (* ADR(source[0]) convertido para POINTER TO BYTE *)
  Dest   : POINTER TO DINT;  (* ADR(dest[0]) convertido para POINTER TO BYTE *)
  Length    : UDINT;            (* nº de elementos a copiar *)
  Trigger   : BOOL;             (* sinal para fazer pulso *)
END_VAR

VAR
  prevTrig  : R_TRIG;    (* detecta borda de subida *)
  i         : UDINT;
END_VAR</Single>
