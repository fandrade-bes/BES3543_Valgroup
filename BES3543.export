      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">//SE A MÁQUINA ESTIVER EM MODO MANUAL E NÃO ESTIVER RODANDO, HABILITA SELEÇÃO MANUAL DE ATUADORES
	IF	LA_GERAL.bit_MAQUINA_MANUAL	AND
	NOT	LA_GERAL.bit_MAQUINA_RODANDO	THEN
			
			IF LA_IHM.bit_SELEC_PESAGEM_ACIONAMENTO_TRANSFERENCIA		THEN
					LA_IHM.int_PESAGEM_ATUADOR_SELECIONADO	:= 1;
			END_IF

		
			
			CASE	LA_IHM.int_PESAGEM_ATUADOR_SELECIONADO	OF
					
					0: //SEM ATUADOR SELECIONADO
						LA_IHM.bit_ATU_PESAGEM_AVANCADO	:= FALSE;
						LA_IHM.bit_ATU_PESAGEM_RECUADO		:= FALSE;			
			
					1://ATUADOR ENVOLVEDOR APROX GARRA
						IF LA_IHM.bit_ATU_PESAGEM_AVANCAR	THEN
								GVL_PESAGEM.bit_valv_ACIONAMENTO_TRANSFERENCIA	:= TRUE;
						END_IF
						
						IF LA_IHM.bit_ATU_PESAGEM_RECUAR	THEN
								GVL_PESAGEM.bit_valv_ACIONAMENTO_TRANSFERENCIA	:= FALSE;
						END_IF
						
						LA_IHM.bit_ATU_PESAGEM_AVANCADO	:= sens_TRANSFERENCIA_AV;
						LA_IHM.bit_ATU_PESAGEM_RECUADO		:= sens_TRANSFERENCIA_RC;
							
		
			END_CASE	
	
	ELSE
		
		LA_IHM.int_PESAGEM_ATUADOR_SELECIONADO				:= 0;
		
		LA_IHM.bit_ATU_PESAGEM_AVANCADO					:= FALSE;
		LA_IHM.bit_ATU_PESAGEM_RECUADO						:= FALSE;	
			
		LA_IHM.bit_SELEC_PESAGEM_ACIONAMENTO_TRANSFERENCIA	:= FALSE;
	
	END_IF
	
	
</Single>
