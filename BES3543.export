          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">(* Detect rising edge *)
IF prevTrig.Q  THEN
 

    (* Cópia elemento-a-elemento *)
    FOR i := 0 TO Length - 1 DO
      Dest[i] := Source[i];
      
    END_FOR;

    
  END_IF;


(* armazena estado do trigger para próxima varredura *)
prevTrig(CLK:= Trigger);</Single>
            <Single Name="LineInfoPersistence" Type="string">f0ee6833-dc5d-4346-bd17-ffeb93d96478_Impl_LineIds</Single>
          </Single>
