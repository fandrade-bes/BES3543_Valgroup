    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">99fad349-678a-4c51-9687-30dce6960ef1</Single>
        <Single Name="ParentGuid" Type="System.Guid">00000000-0000-0000-0000-000000000000</Single>
        <Single Name="Name" Type="string">B00_EMPILHA_SACOLA</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">21af5390-2942-461a-bf89-951aaf6999f1</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">d98c8733-485d-47dd-8a8c-2699f8cfeaa4</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639245690937663578</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">	IF 	LA_IHM.bit_EMPILHA_SACOLA_HOME 	OR
		LA_GERAL.bit_RESET_GERAL			THEN
			LA_GERAL.bit_RESET_GERAL 	:= FALSE;
			passo_EMPILHADOR			:=	9;
	END_IF
	
CASE passo_EMPILHADOR OF
	

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
09: //HOME: Reseta variáveis
	
	
	LA_EMP.bit_EIXO_GARRA_EMPILHADOR_FAZER_HOME	:= FALSE;
	LA_EMP.bit_EIXO_GARRA_EMPILHADOR_MOVER_ABS	:= FALSE;
	M1_LA_EMP_GARRA.bit_FAZER_HOME					:= FALSE;
	LA_EMP.bit_ENTREGA_EMPILHADOR_CONCLUIDO		:= FALSE;
	LA_EMP.bit_ENTREGA_PILHA_CONCLUIDO			:= FALSE;
	LA_EMP.bit_LIBERA_PEGA						:= FALSE;
	
	tmr_PASSO_1002.IN										:= FALSE;
	tmr_PASSO_1004.IN										:= FALSE;
	tmr_GARRA.IN											:= FALSE;
	tmr_PASSO_1013.IN										:= FALSE;
	
	passo_EMPILHADOR	:= 10;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
10: //HOME: Se a máquina estiver rodando e não estiver em modo manual, começa o processo de Home recuando atuadores
	
	IF LA_GERAL.bit_MAQUINA_PRONTA  THEN
			LA_EMP.bit_valv_BANDEJA						:=	TRUE;
			LA_EMP.bit_valv_GARRA_SACOLA					:=	TRUE;
			LA_EMP.bit_GARRA_EMPILHADOR_EXECUTANDO_RESET	:=	TRUE;
		
			passo_EMPILHADOR	:= 12;
	END_IF

	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
12: //HOME: Inicia o Home no eixo da garra do empilhador
	
	LA_EMP.bit_EIXO_GARRA_EMPILHADOR_FAZER_HOME		:= TRUE;

	passo_EMPILHADOR							:= 13;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
13: //HOME: Verifica se está se movendo para o Home do Eixo da Garra do empilhador
	
	IF M1_LA_EMP_GARRA.bit_HOME_FAZENDO	THEN
			
			passo_EMPILHADOR					:= 14;
	END_IF
	

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
14: //HOME: Se o Home do eixo da garra do empilhador for concluído, vai para próximo passo. 

	IF	M1_LA_EMP_GARRA.bit_HOME_FEITO	THEN
			M1_LA_EMP_GARRA.bit_FAZER_HOME					:= FALSE;
			LA_EMP.bit_EIXO_GARRA_EMPILHADOR_FAZER_HOME	:= FALSE;
			passo_EMPILHADOR										:= 100;
	END_IF

	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
100: //HOME: aguarda máquina rodando

	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
		passo_EMPILHADOR	:=	102;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
102: //HOME: resetando variavel de home do eixo

	M1_LA_EMP_GARRA.bit_FAZER_HOME		:= 	FALSE;
		
	passo_EMPILHADOR	:=	103;

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
103: //HOME: resetando atuadores
 
	IF	LA_EMP.di_SENS_APOIO_BANDEJA_RC 			AND
		LA_EMP.di_SENS_PINCA_GARRA_EMPILHADOR_RC OR
		force_1							THEN
			passo_EMPILHADOR	:=	105;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
104://HOME: caso a camada atual seja a máxima antes de bater na bandeja, recua atuador da mesa de giro. Se não, avança para deixa próximo da bandeja

		LA_EMP.bit_valv_DESCE_MESA_GIRO	:=	FALSE;
		passo_EMPILHADOR							:=	105;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
105://aguarda feedback do sensor de recuo do atuador da mesa de giro

	IF	LA_EMP.di_SENS_MESA_GIRO_RC OR LA_EMP.di_SENS_MESA_GIRO_AV THEN
			passo_EMPILHADOR		:=	998;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
106://aguarda feedback do sensor de avanço do atuador da mesa de giro

	IF	LA_EMP.di_SENS_MESA_GIRO_AV THEN
			passo_EMPILHADOR		:=	998;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
998://fim do home
	
	LA_EMP.bit_GARRA_EMPILHADOR_EXECUTANDO_RESET	:=	FALSE;
	passo_EMPILHADOR		:=	999;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
999://se estiver rodando e tiver status OK da mesa de giro e do eixo X do empilhador, comanda posição da garra para pré pega

	IF 	LA_GERAL.bit_MAQUINA_RODANDO 			 	THEN	
			M1_LA_EMP_GARRA.ABS_MOVER	:= LA_GERAL.coord_GARRA_EMPILHADOR_PRE_PEGA;
			passo_EMPILHADOR	:=	2000;	
	END_IF
	

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
2000://se estiver rodando, libera movimento do eixo da garra

	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
		LA_EMP.bit_EIXO_GARRA_EMPILHADOR_MOVER_ABS	:= TRUE;
		passo_EMPILHADOR	:=	2001;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
2001://verifica se eixo da garra do empilhador está se movimentando

	IF	M1_LA_EMP_GARRA.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_GARRA_EMPILHADOR_POSICIONADO	THEN
		LA_EMP.bit_EIXO_GARRA_EMPILHADOR_MOVER_ABS		:= FALSE;
		
		passo_EMPILHADOR 					:= 2002;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
2002://verifica se eixo da garra completou movimento

	IF	M1_LA_EMP_GARRA.bit_MOVE_ABS_FEITO OR LA_EMP.bit_EIXO_GARRA_EMPILHADOR_POSICIONADO	THEN
		LA_EMP.bit_EIXO_GARRA_EMPILHADOR_MOVER_ABS		:= FALSE;
		LA_EMP.tmr_RTON_MOVE_5.T_IN	:=	FALSE;
		
		passo_EMPILHADOR 					:= 2003;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
2003://se a máquina estiver rodando, comanda garra do empilhador para posição de pega
	
	IF LA_GERAL.bit_MAQUINA_RODANDO (*AND GVL_EMPILHAMENTO.bit_EIXO_X_MOVE_CONCLUIDO*)	 THEN
		M1_LA_EMP_GARRA.ABS_MOVER	:= LA_GERAL.coord_GARRA_EMPILHADOR_PEGA;
		passo_EMPILHADOR	:=	1000;	
	END_IF
	
//---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1000://INICIO DE CICLO. Caso a máquina esteja rodando e a bandeja esteja recuada, e a pinça avançada, movimenta eixo do empilhador para posição de pega, além de garantir que a bandeja esteja acionada

	IF LA_GERAL.bit_MAQUINA_RODANDO 	AND
	   	LA_EMP.di_SENS_PINCA_GARRA_EMPILHADOR_RC 	AND 
		LA_EMP.di_SENS_APOIO_BANDEJA_RC			AND
	NOT LA_EMP.bit_REALIZANDO_INSPECAO		AND
	NOT LA_EMP.bit_ENTREGANDO_PILHA_COMPLETA  AND
		LA_EMP.bit_LIBERA_PEGA				AND
		LA_IHM.bit_SIMULA_PEGA							AND
	(NOT	LA_GERAL.bit_SACOLA_POSICIONADA	OR LA_IHM.int_CAMADA_ATUAL &gt; 1)				THEN
			LA_EMP.bit_EIXO_GARRA_EMPILHADOR_MOVER_ABS	:= 	TRUE;
			LA_EMP.bit_valv_BANDEJA						:=	TRUE;
			LA_EMP.tmr_RTON_MOVE_1.T_IN					:= 	TRUE;
			LA_EMP.bit_LIBERA_PEGA						:=	FALSE;
			passo_EMPILHADOR										:=	1001;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1001://verifica se eixo da garra do empilhador está se movimentando

	IF	M1_LA_EMP_GARRA.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_GARRA_EMPILHADOR_POSICIONADO	THEN
		LA_EMP.bit_EIXO_GARRA_EMPILHADOR_MOVER_ABS	:= FALSE;
		
		passo_EMPILHADOR 										:= 1002;
	END_IF

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1002://verifica se eixo da garra do empilhador completou movimento

	IF	M1_LA_EMP_GARRA.bit_MOVE_ABS_FEITO OR LA_EMP.bit_EIXO_GARRA_EMPILHADOR_POSICIONADO	THEN
		LA_EMP.bit_EIXO_GARRA_EMPILHADOR_MOVER_ABS	:= FALSE;
		tmr_PASSO_1002.IN										:= TRUE;
		
		passo_EMPILHADOR 					:= 1003;
	END_IF
	

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1003://espera timer para fechar pinça e pegar sacolas

	IF tmr_PASSO_1002.Q THEN
		LA_EMP.bit_valv_GARRA_SACOLA	:=	FALSE;
		passo_EMPILHADOR 						:= 	1004;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1004://aguarda feedback do sensor de recuo da pinça, aciona timer e vai para próximo passo

	tmr_PASSO_1002.IN				:=	FALSE;	
	tmr_PASSO_1004.IN						:=	TRUE;
	
(*	IF sens_PINCA_GARRA_EMPILHADOR_AV THEN
		tmr_PASSO_1004.IN						:=	TRUE;
		GVL_EMPILHAMENTO.tmr_RTON_MOVE_1.T_IN	:= FALSE;
		
	END_IF*)
	
	IF tmr_PASSO_1004.Q OR LA_EMP.di_SENS_PINCA_GARRA_EMPILHADOR_AV	THEN
		tmr_PASSO_1004.IN	:=	FALSE;
		passo_EMPILHADOR 	:= 	1005;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1005://caso a máquina esteja rodando, comanda eixo da garra do empilhador para posição de pre entrega

	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
		M1_LA_EMP_GARRA.ABS_MOVER.sp_POSICAO		:= PVAR.rec_ATUAL.sp_PRE_ENTREGA_GARRA_EMPILHADOR_POSICAO[LA_IHM.int_CAMADA_ATUAL];
		M1_LA_EMP_GARRA.ABS_MOVER.sp_ACELERACAO	:= LA_GERAL.coord_GARRA_EMPILHADOR_PRE_ENTREGA.sp_ACELERACAO;
		M1_LA_EMP_GARRA.ABS_MOVER.sp_VELOCIDADE	:= LA_GERAL.coord_GARRA_EMPILHADOR_PRE_ENTREGA.sp_VELOCIDADE;
		M1_LA_EMP_GARRA.ABS_MOVER.sp_DESACELERACAO	:= LA_GERAL.coord_GARRA_EMPILHADOR_PRE_ENTREGA.sp_DESACELERACAO;
		passo_EMPILHADOR	:=	1006;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1006://caso a máquina esteja rodando, movimenta eixo para posição

	IF LA_GERAL.bit_MAQUINA_RODANDO	THEN
		LA_EMP.bit_EIXO_GARRA_EMPILHADOR_MOVER_ABS	:= TRUE;
		LA_EMP.tmr_RTON_MOVE_2.T_IN					:= TRUE;
		passo_EMPILHADOR										:=	1007;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1007:////verifica se eixo da garra do empilhador está se movimentando

	IF	M1_LA_EMP_GARRA.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_GARRA_EMPILHADOR_POSICIONADO	THEN
		LA_EMP.bit_EIXO_GARRA_EMPILHADOR_MOVER_ABS		:= FALSE;
		
		passo_EMPILHADOR 					:= 1008;
	END_IF

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1008://verifica se eixo da garra do empilhador completou movimento

	IF	M1_LA_EMP_GARRA.bit_MOVE_ABS_FEITO OR LA_EMP.bit_EIXO_GARRA_EMPILHADOR_POSICIONADO	THEN
		LA_EMP.bit_EIXO_GARRA_EMPILHADOR_MOVER_ABS	:= FALSE;
		LA_EMP.bit_valv_GARRA_SACOLA					:=	TRUE;
		LA_EMP.tmr_RTON_MOVE_2.T_IN					:= FALSE;
		
		passo_EMPILHADOR 										:= 1009;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1009://se a máquina estiver rodando, comanda eixo da garra do empilhador para posição de entrega, recua bandeja e aciona timer de movimentação do eixo

	IF LA_GERAL.bit_MAQUINA_RODANDO  THEN
		M1_LA_EMP_GARRA.ABS_MOVER		:= LA_GERAL.coord_GARRA_EMPILHADOR_ENTREGA;
		LA_EMP.bit_valv_BANDEJA		:= FALSE;
		LA_EMP.tmr_RTON_MOVE_3.T_IN	:= TRUE;
		tmr_PASSO_1009.IN						:= TRUE;
		passo_EMPILHADOR						:=	1010;	
	END_IF

	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1010://aguarda timer para movimentar eixo e aciona timer para abrir garra

	IF LA_GERAL.bit_MAQUINA_RODANDO AND tmr_PASSO_1009.Q	THEN
		LA_EMP.bit_EIXO_GARRA_EMPILHADOR_MOVER_ABS	:= TRUE;
		tmr_GARRA.IN											:= TRUE;
		LA_EMP.tmr_RTON_MOVE_4.T_IN					:= TRUE;
		LA_EMP.tmr_RTON_MOVE_3.T_IN					:= FALSE;
		tmr_PASSO_1009.IN										:= FALSE;
		
		passo_EMPILHADOR										:=	1011;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1011://verifica se eixo da garra do empilhador está se movimentando

	IF	M1_LA_EMP_GARRA.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_GARRA_EMPILHADOR_POSICIONADO	THEN
		LA_EMP.bit_EIXO_GARRA_EMPILHADOR_MOVER_ABS		:= FALSE;
		
		passo_EMPILHADOR 					:= 1012;
	END_IF

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1012://verifica se eixo da garra do empilhador completou movimento. Se timer da garra concluiu, abre garra para soltar sacolas

	IF	(M1_LA_EMP_GARRA.bit_MOVE_ABS_FEITO OR LA_EMP.bit_EIXO_GARRA_EMPILHADOR_POSICIONADO)	THEN
		LA_EMP.bit_EIXO_GARRA_EMPILHADOR_MOVER_ABS	:= FALSE;
		tmr_GARRA.IN											:= FALSE;
		LA_EMP.tmr_RTON_MOVE_4.T_IN					:= FALSE;
		
		
	END_IF
	
	IF	LA_GERAL.rec_IHM.sp_POSICAO_ABRE_GARRA_EMPILHADOR[LA_IHM.int_CAMADA_ATUAL] &gt;	LA_IHM.info_MANI_POS_ATUAL_GARRA_EMPILHADOR	THEN
		LA_EMP.bit_valv_GARRA_SACOLA	:=	TRUE;
		passo_EMPILHADOR 					:= 1013;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1013://aguarda feedback do sensor de avanço da bandeja
	
	IF LA_EMP.di_SENS_APOIO_BANDEJA_AV OR force_1	THEN
		
		passo_EMPILHADOR 					:= 	1014;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1014://aguarda feedback do sensor de avanço da pilha
	
	IF LA_EMP.di_SENS_PINCA_GARRA_EMPILHADOR_RC	THEN
		tmr_PASSO_1013.IN	:=	TRUE;
	END_IF
	
	IF tmr_PASSO_1013.Q OR force_1	THEN
		passo_EMPILHADOR 					:= 	1015;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1015://caso tenha atingido a camada máxima de risco de colisão das pilhas com a bandeja, recua atuador da mesa de giro. Se não, pula direto para passo 1017
// 
// 	IF GVL_IHM.int_CAMADA_ATUAL &gt;= PVAR.rec_ATUAL.int_NUM_DESCER_MESA_EMPILHADOR THEN
// 		GVL_EMPILHAMENTO.bit_valv_DESCE_MESA_GIRO	:=	TRUE;
// 		passo_EMPILHADOR 							:= 	1016;
// 	ELSE
// 		passo_EMPILHADOR 							:= 	1017;
// 	END_IF
	
	passo_EMPILHADOR 							:= 	1017;
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1016://aguarda feedback do sensor de recuo do atuador da mesa de giro

	IF LA_EMP.do_ATU_MESA_GIRO_RC THEN
		passo_EMPILHADOR 					:= 	1017;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1017://aciona bandeja, define entrega de camada como concluida e incrementa camada atual

	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
		tmr_PASSO_1013.IN										:=	FALSE;
		LA_EMP.bit_valv_BANDEJA						:=	TRUE;
		LA_EMP.tmr_RTON_MOVE_5.T_IN					:= 	TRUE;
		LA_EMP.bit_ENTREGA_EMPILHADOR_CONCLUIDO		:= 	TRUE;
		LA_IHM.int_CAMADA_ATUAL								:=	LA_IHM.int_CAMADA_ATUAL + 1;
		
		passo_EMPILHADOR 						:= 	1018;
	END_IF
	
	

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1018://caso tenha passado limit máximo de camadas, reseta para 1
	
	IF LA_IHM.int_CAMADA_ATUAL &gt;= PVAR.rec_ATUAL.int_NUM_MAX_CAMADAS_EMPILHADOR THEN
		LA_EMP.bit_ENTREGA_PILHA_CONCLUIDO		:=	TRUE;		
	END_IF
	
	
	passo_EMPILHADOR 				:= 	1019;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1019://reinicia rotina
//	IF (sens_PINCA_GARRA_EMPILHADOR_AV AND sens_APOIO_BANDEJA_RC) OR force_1	THEN
//		passo_ROTINA 					:= 	999;
//	END_IF

	IF LA_IHM.int_CAMADA_ATUAL &gt; PVAR.rec_ATUAL.int_NUM_MAX_CAMADAS_EMPILHADOR THEN
		LA_IHM.int_CAMADA_ATUAL		:= 	1;		
	END_IF
	
	LA_EMP.bit_ENTREGA_EMPILHADOR_CONCLUIDO	:= 	FALSE;
	
	IF LA_IHM.int_CAMADA_ATUAL &gt;= PVAR.rec_ATUAL.int_NUM_DESCER_MESA_EMPILHADOR THEN
		LA_EMP.bit_valv_DESCE_MESA_GIRO	:=	TRUE;
	END_IF
	
	passo_EMPILHADOR 									:= 	999;

	
	
	

END_CASE



//------------//-----------LÓGICAS EXTRAS---------------//----------------------//--------------------------//


	//EIXO ARMADORA JÁ ESTÁ NA POSIÇÃO
	IF	LA_EMP.info_MOTOR_GARRA_EMPILHADOR_POS_ATUAL	&gt;= M1_LA_EMP_GARRA.ABS_MOVER.sp_POSICAO - 1	AND
		LA_EMP.info_MOTOR_GARRA_EMPILHADOR_POS_ATUAL	&lt;= M1_LA_EMP_GARRA.ABS_MOVER.sp_POSICAO + 1	THEN
			LA_EMP.bit_EIXO_GARRA_EMPILHADOR_POSICIONADO	:= TRUE;
	ELSE
			LA_EMP.bit_EIXO_GARRA_EMPILHADOR_POSICIONADO	:= FALSE;
	END_IF
	
	//LIBERAÇÃO DE PEGA DE PILHA QUANDO EIXO X DO EMPILHADOR COMPLETAR MOVIMENTO
	r_trig_LIBERA_PEGA(CLK:=LA_EMP.bit_EIXO_X_MOVE_CONCLUIDO, CLK := LA_EMP.bit_LIBERA_PEGA);

//-----------ATUADORES-------------//--------------------//---------------------//
LA_EMP.do_ATU_PINCA_GARRA_EMPILHADOR	:=	NOT LA_EMP.bit_valv_GARRA_SACOLA;
LA_EMP.do_ATU_BANDEJA_APOIO			:=	NOT LA_EMP.bit_valv_BANDEJA;

IF LA_EMP.bit_valv_DESCE_MESA_GIRO THEN
	LA_EMP.do_ATU_MESA_GIRO_RC	:=	FALSE;
	LA_EMP.do_ATU_MESA_GIRO_AV	:=	TRUE;
ELSE
	LA_EMP.do_ATU_MESA_GIRO_RC	:=	TRUE;
	LA_EMP.do_ATU_MESA_GIRO_AV	:=	FALSE;
END_IF

IF LA_EMP.bit_valv_POSICIONA_SACOLA	THEN
	valv_POSICIONADOR_RC	:=	FALSE;
	valv_POSICIONADOR_AV	:=	TRUE;
ELSE
	valv_POSICIONADOR_RC	:=	TRUE;
	valv_POSICIONADOR_AV	:=	FALSE;
END_IF



//tmr_GARRA (PT	:= PVAR.rec_ATUAL.tmr_ABRE_GARRA_EMPILHADOR[GVL_IHM.int_CAMADA_ATUAL]);
IF (LA_GERAL.di_BT_CMD1_RESET OR LA_GERAL.di_BT_CMD2_RESET) AND NOT LA_GERAL.bit_MAQUINA_RODANDO	THEN
			
			IF 	passo_EMPILHADOR &gt;= 0 	AND
				passo_EMPILHADOR &lt;= 998 	THEN
				LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS		:= FALSE;
				passo_EMPILHADOR := 9;
			END_IF	
			
			
END_IF


        IF NOT LA_GERAL.bit_SACOLA_POSICIONADA AND LA_GERAL.bit_MAQUINA_RODANDO AND LA_IHM.bit_SIMULA_PEGA	THEN
                LA_GERAL.tmr_CICLO_COMPLETO.IN := TRUE;		
        END_IF
        
        IF LA_GERAL.tmr_CICLO_COMPLETO.Q 	THEN
                LA_GERAL.tmr_CICLO_COMPLETO.IN := FALSE;
				LA_GERAL.bit_SACOLA_POSICIONADA	 := TRUE;
				tmr_CICLO_COMPLETO_SONORO.IN	:= TRUE;
				LA_GERAL.bit_TL_SONORO		:= TRUE;
                
        END_IF
		
		IF tmr_CICLO_COMPLETO_SONORO.Q	THEN
			tmr_CICLO_COMPLETO_SONORO.IN	:=	FALSE;
			LA_GERAL.bit_TL_SONORO		:=	FALSE;
		END_IF


tmr_HOME (PT	:= T#1500MS);	
tmr_reset (PT	:= T#50MS);
tmr_PASSO_1002 (PT	:= T#1MS);
tmr_PASSO_1004 (PT	:= T#500MS);
tmr_PASSO_1009 (PT	:= PVAR.rec_ATUAL.tmr_TRANSICAO_ENTREGA_EMPILHADOR[LA_IHM.int_CAMADA_ATUAL]);
tmr_PASSO_1013 (PT	:= T#500MS);
tmr_FECHA_BANDEJA (PT	:= T#500MS);
tmr_ABRE_BANDEJA (PT	:= T#500MS);
LA_GERAL.tmr_CICLO_COMPLETO (PT	:= T#60S);
tmr_CICLO_COMPLETO_SONORO (PT	:= T#500ms);</Single>
            <Single Name="LineInfoPersistence" Type="string">99fad349-678a-4c51-9687-30dce6960ef1_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM B00_EMPILHA_SACOLA
VAR
	passo_EMPILHADOR	:	INT := 9;	
	
	tmr_HOME				: TON;
	tmr_reset				: ton;
	tmr_PASSO_1002			: TON;
	tmr_PASSO_1004			: TON;
	tmr_PASSO_1009			: TON;
	tmr_GARRA				: TON;
	tmr_PASSO_1013			: TON;
	tmr_FECHA_BANDEJA		: TON;
	tmr_ABRE_BANDEJA		: TON;
	
	r_trig_LIBERA_PEGA		: Standard.F_TRIG;
	force_1				: BOOL;
	
	
	TESTE1				: BOOL;
	TESTE2				: BOOL;
	tmr_CICLO_COMPLETO_SONORO	: TON;
	
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">99fad349-678a-4c51-9687-30dce6960ef1_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">15490</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">d98c8733-485d-47dd-8a8c-2699f8cfeaa4</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">LADO_A</Single>
        <Single Type="string">02 - LA_EMPILHADOR</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">7e5977d3-6a9e-49b7-8e30-e7953acef28a</Single>
        <Single Name="ParentGuid" Type="System.Guid">00000000-0000-0000-0000-000000000000</Single>
        <Single Name="Name" Type="string">B01_MANUAL</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">21af5390-2942-461a-bf89-951aaf6999f1</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">d98c8733-485d-47dd-8a8c-2699f8cfeaa4</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639220533261361409</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">//MODO MANUAL EIXOS


	//EIXO X EMPILHADOR
	IF		LA_IHM.bit_MANUAL_HABILITAR_EIXOS							AND
		NOT	LA_EMP.bit_EIXO_X_EMPILHADOR_JOG_FORWARD			AND	
		NOT	LA_EMP.bit_EIXO_X_EMPILHADOR_JOG_REVERSE			THEN
				bit_EIXO_X_EMPILHADOR_RTRIG	:= TRUE;
	ELSE
				bit_EIXO_X_EMPILHADOR_RTRIG	:= FALSE;
	END_IF
	
	rtrig_EIXO_X_EMPILHADOR_RESET_STOP(CLK := bit_EIXO_X_EMPILHADOR_RTRIG);
	LA_EMP.bit_EIXO_X_EMPILHADOR_JOG_STOP	:= rtrig_EIXO_X_EMPILHADOR_RESET_STOP.Q;
	
	
	//EIXO GARRA EMPILHADOR
	IF		LA_IHM.bit_MANUAL_HABILITAR_EIXOS							AND
		NOT	LA_EMP.bit_GARRA_EMPILHADOR_JOG_FORWARD			AND	
		NOT	LA_EMP.bit_GARRA_EMPILHADOR_JOG_REVERSE			THEN
				bit_EIXO_GARRA_EMPILHADOR_RTRIG	:= TRUE;
	ELSE
				bit_EIXO_GARRA_EMPILHADOR_RTRIG	:= FALSE;
	END_IF
	
	rtrig_EIXO_GARRA_EMPILHADOR_RESET_STOP(CLK := bit_EIXO_GARRA_EMPILHADOR_RTRIG);
	LA_EMP.bit_GARRA_EMPILHADOR_JOG_STOP	:= rtrig_EIXO_GARRA_EMPILHADOR_RESET_STOP.Q;
	
	
	//EIXO MESA GIRO
	IF		LA_IHM.bit_MANUAL_HABILITAR_EIXOS							AND
		NOT	LA_EMP.bit_GIRO_MESA_JOG_FORWARD			AND	
		NOT	LA_EMP.bit_GIRO_MESA_JOG_REVERSE			THEN
				bit_EIXO_MESA_GIRO_RTRIG	:= TRUE;
	ELSE
				bit_EIXO_MESA_GIRO_RTRIG	:= FALSE;
	END_IF
	
	rtrig_EIXO_MESA_GIRO_RESET_STOP(CLK := bit_EIXO_MESA_GIRO_RTRIG);
	LA_EMP.bit_GIRO_MESA_JOG_STOP	:= rtrig_EIXO_MESA_GIRO_RESET_STOP.Q;
	
//--------------------------//-----------------------------------//---------------------------//--------------------------------//	
	
//HOME DOS EIXOS

	//HOME EIXO X EMPILHADOR
	IF	(LA_EMP.bit_EIXO_X_EMPILHADOR_FAZER_HOME OR LA_IHM.bit_EIXO_X_EMPILHADOR_FAZER_HOME)	THEN
			M0_LA_EMP_X.bit_FAZER_HOME	:= TRUE;
	END_IF
	
	IF	M0_LA_EMP_X.bit_HOME_FEITO		THEN
			M0_LA_EMP_X.bit_FAZER_HOME	:= FALSE;
	END_IF
	
	
	
	//HOME EIXO GARRA EMPILHADOR
	IF	(LA_EMP.bit_EIXO_GARRA_EMPILHADOR_FAZER_HOME OR LA_IHM.bit_EIXO_GARRA_EMPILHADOR_FAZER_HOME)	THEN
			M1_LA_EMP_GARRA.bit_FAZER_HOME	:= TRUE;
	END_IF
	
	IF	M1_LA_EMP_GARRA.bit_HOME_FEITO		THEN
			M1_LA_EMP_GARRA.bit_FAZER_HOME	:= FALSE;
	END_IF
	
	
	//HOME EIXO GARRA EMPILHADOR
	IF	(LA_EMP.bit_EIXO_GIRO_MESA_FAZER_HOME OR LA_IHM.bit_EIXO_GIRO_MESA_FAZER_HOME)	THEN
			M2_LA_EMP_GIRO.bit_FAZER_HOME	:= TRUE;
	END_IF
	
	IF	M2_LA_EMP_GIRO.bit_HOME_FEITO		THEN
			M2_LA_EMP_GIRO.bit_FAZER_HOME	:= FALSE;
	END_IF</Single>
            <Single Name="LineInfoPersistence" Type="string">7e5977d3-6a9e-49b7-8e30-e7953acef28a_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM B01_MANUAL
VAR
	rtrig_EIXO_X_EMPILHADOR_RESET_STOP		: R_TRIG;
	rtrig_EIXO_GARRA_EMPILHADOR_RESET_STOP	: R_TRIG;
	rtrig_EIXO_MESA_GIRO_RESET_STOP			: R_TRIG;
	
	bit_EIXO_X_EMPILHADOR_RTRIG				: BOOL;
	bit_EIXO_GARRA_EMPILHADOR_RTRIG			: BOOL;
	bit_EIXO_MESA_GIRO_RTRIG				: BOOL;
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">7e5977d3-6a9e-49b7-8e30-e7953acef28a_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">485</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">d98c8733-485d-47dd-8a8c-2699f8cfeaa4</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">LADO_A</Single>
        <Single Type="string">02 - LA_EMPILHADOR</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">08b93842-1943-4ea4-b3b9-89e66cce88c1</Single>
        <Single Name="ParentGuid" Type="System.Guid">00000000-0000-0000-0000-000000000000</Single>
        <Single Name="Name" Type="string">B02_EMPILHADOR_X</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">21af5390-2942-461a-bf89-951aaf6999f1</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">d98c8733-485d-47dd-8a8c-2699f8cfeaa4</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639245678767636286</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">//MOVE O PASSO PARA O HOME

	IF	LA_IHM.bit_EMPILHA_SACOLA_HOME	THEN
			LA_IHM.bit_EIXO_X_EMPILHADOR_FAZENDO_HOME	:= TRUE;
			passo_X_EMPILHADOR 							:= 9;
	END_IF
	
CASE	passo_X_EMPILHADOR	OF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
09: //HOME: Reseta variáveis
	
//BITS EIXO X
	LA_EMP.bit_EIXO_X_EMPILHADOR_FAZER_HOME	:= FALSE;
	LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= FALSE;
	M0_LA_EMP_X.bit_FAZER_HOME			:= FALSE;
	LA_GERAL.bit_EIXO_X_EMPILHADOR_PRONTO				:= FALSE;
	LA_EMP.bit_EIXO_X_MOVE_CONCLUIDO			:= FALSE;
	LA_EMP.bit_LIBERA_ENTREGA_PILHA			:= FALSE;
	LA_EMP.bit_REALIZANDO_INSPECAO			:= FALSE;
	bit_INCREMENTA_SACOLA								:= FALSE;
	tmr_ENTREGA_X.IN									:= FALSE;
	tmr_passo_2021.IN									:= FALSE;
	tmr_LIBERA_X_INSPECAO.IN							:= FALSE;
	
	passo_X_EMPILHADOR	:= 10;

//BITS GIRO MESA	
	
	LA_EMP.bit_EIXO_GIRO_MESA_FAZER_HOME	:= FALSE;
	LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS	:= FALSE;
	M2_LA_EMP_GIRO.bit_FAZER_HOME				:= FALSE;
	LA_GERAL.bit_EIXO_GIRO_MESA_PRONTO			:= FALSE;
	LA_EMP.bit_MESA_GIRO_CONCLUIDO		:= FALSE;
	LA_EMP.bit_EST_PILHA_ENTREGUE			:= FALSE;
	LA_EMP.est_ROLETES_GIRO_MESA			:= FALSE;
	LA_EMP.est_ROLETES_GIRO_MESA_REVERSE	:= FALSE;
	LA_EMP.bit_LIBERA_X					:= FALSE;
	
	tmr_HOME.IN										:=	FALSE;
	tmr_sens_MESA_GIRO_IN.IN						:=	FALSE;
	tmr_sens_MESA_GIRO_OUT.IN						:=	FALSE;
	TMR_GIRO_1.IN									:= FALSE;
	TMR_GIRO_2.IN									:= FALSE;
	TMR_GIRO_3.IN									:= FALSE;
	TMR_GIRO_4.IN									:= FALSE;
	TMR_GIRO_5.IN									:= FALSE;
	tmr_passo_1041.IN								:= FALSE;
	
	bit_GIRO_MESA_FEITO								:= FALSE;
	bit_X_EMPILHADOR_FEITO							:= FALSE;
	
	PVAR.int_POSICAO_EIXO_X_EMPILHADOR	:=	1;
	int_posicao_mesa	:=	1;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
10: //HOME: Se a máquina estiver rodando e não estiver em modo manual, começa o processo de Home
	
	IF LA_GERAL.bit_MAQUINA_PRONTA AND NOT LA_IHM.bit_MAQUINA_MANUAL THEN
			passo_X_EMPILHADOR	:= 11;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
11: //HOME: Move os Atuadores para a Posição Inicial
	
	passo_X_EMPILHADOR					:= 12;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
12: //HOME: Inicia o Home no Diverter
	
	LA_EMP.bit_valv_DESCE_MESA_GIRO			:=	TRUE;

	IF LA_EMP.di_SENS_MESA_GIRO_RC AND M1_LA_EMP_GARRA.bit_HOME_FEITO THEN
		LA_EMP.bit_EIXO_X_EMPILHADOR_FAZER_HOME	:= TRUE;
		passo_X_EMPILHADOR									:= 13;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
13: //HOME: Verifica se está se movendo para o Home do Eixo X do empilhador
	
	IF M0_LA_EMP_X.bit_HOME_FAZENDO	THEN	
			passo_X_EMPILHADOR									:= 14;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
14: // Manda os valores de coordenada para movimentos absolutos da posição inicial da mesa de giro após estar em uma distancia sem colisões

	
	IF LA_EMP.info_MOTOR_EIXO_X_EMPILHADOR_POS_ATUAL &gt; 56 AND LA_EMP.info_MOTOR_EIXO_X_EMPILHADOR_POS_ATUAL &lt; 780 THEN
		M2_LA_EMP_GIRO.ABS_MOVER	:= PVAR.rec_ATUAL.coord_MESA_GIRO_INICIAL;
		passo_X_EMPILHADOR					:= 15;
	END_IF
	

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
15: // Comanda mesa de giro com movimento absoluto para posição inicial.

	LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS		:= TRUE;
	TMR_GIRO_1.IN										:= FALSE;
	passo_X_EMPILHADOR									:= 16;	

	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
16: //verifica se a mesa de giro está se movendo para posição 1. Caso esteja, desativa comando de movimento absoluto

	IF M2_LA_EMP_GIRO.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_GIRO_MESA_POSICIONADO	THEN
		LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS	:= FALSE;
		passo_X_EMPILHADOR								:= 17;	
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
17: //verifica se a mesa de giro completou movimento

	IF M2_LA_EMP_GIRO.bit_MOVE_ABS_FEITO OR LA_EMP.bit_EIXO_GIRO_MESA_POSICIONADO	THEN
		LA_EMP.bit_MESA_GIRO_CONCLUIDO	:= TRUE;
		passo_X_EMPILHADOR							:= 18;	
	END_IF



//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
18: //HOME: Se o Home do eixo X for concluído, vai para próximo passo
	
	IF	M0_LA_EMP_X.bit_HOME_FEITO	THEN
			LA_EMP.bit_EIXO_X_EMPILHADOR_FAZER_HOME	:= FALSE;
			LA_GERAL.bit_SACOLA_POSICIONADA					:= true;
			passo_X_EMPILHADOR									:= 19;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
19: //HOME: confirma Home Geral e reseta contador antes de iniciar ciclo

	LA_GERAL.bit_EIXO_X_EMPILHADOR_PRONTO	:=	TRUE;
	LA_GERAL.bit_EIXO_GIRO_MESA_PRONTO	:=	TRUE;
	passo_X_EMPILHADOR						:= 997;

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
997: //PRÉ-INICIO: inicia processo se a maquina estiver ligada. Dependendo da posição que o eixo X do empilhador parou, assim que terminar Home, já pula direto para a posição que estava

		LA_EMP.bit_valv_DESCE_MESA_GIRO	:=	FALSE;
		passo_X_EMPILHADOR 							:= 999;


//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
998: //Realiza verificação de qual parte da rotina iniciar: Seq. Normal - Seq. Invertida (Insp) - Seq. Levar Inspecionado
	//caso esteja na decima pilha, começa PEGA de pilhas para inspeção. Se não, recomeça ciclo para posição 1. Caso a inspeção já esteja ok, pula para posição de inspeção recolher a pilha

	IF (LA_EMP.bit_OPERADOR_INSPECAO_OK	AND pvar.int_PILHAS_ENTREGUES &gt;= 10)	THEN
		LA_EMP.bit_valv_DESCE_MESA_GIRO	:=	TRUE;
		passo_X_EMPILHADOR							:= 	2000;
	ELSIF (NOT LA_EMP.bit_OPERADOR_INSPECAO_OK AND pvar.int_PILHAS_ENTREGUES &gt;= 10) THEN
		LA_EMP.bit_valv_DESCE_MESA_GIRO	:=	FALSE;
		passo_X_EMPILHADOR							:= 	3000;
	ELSE
		LA_EMP.bit_valv_DESCE_MESA_GIRO	:=	FALSE;
		passo_X_EMPILHADOR							:= 	999;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
999: //PRÉ-INICIO: inicia processo se a maquina estiver ligada e reseta timer do filtro do contador de copos
		
	IF	LA_GERAL.bit_MAQUINA_RODANDO			THEN
			LA_IHM.bit_EIXO_X_EMPILHADOR_FAZENDO_HOME := FALSE;
			
			passo_X_EMPILHADOR 							:= 1000;
	END_IF	

	
//---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1000: //PASSO 1000: Manda os valores de coordenada para movimentos absolutos da posição 1 do eixo X do empilhador e declara que está na posição 1, além de comandar mesa de giro para posição inicial

	M0_LA_EMP_X.ABS_MOVER	:= PVAR.rec_ATUAL.coord_X_EMPILHADOR_POS[1];
	M2_LA_EMP_GIRO.ABS_MOVER			:= PVAR.rec_ATUAL.coord_MESA_GIRO_INICIAL;
	PVAR.int_POSICAO_EIXO_X_EMPILHADOR	:=	1;
	
	passo_X_EMPILHADOR 					:= 1001;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1001: // Comanda eixo X do empilhador com movimento absoluto para posição 1.

	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
		LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= TRUE;
		passo_X_EMPILHADOR 									:= 1002;	
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1002: // verifica se está em uma condição segura sem colisões antes de mexer o eixo da mesa giro
	
	IF LA_EMP.info_MOTOR_EIXO_X_EMPILHADOR_POS_ATUAL &gt; 56 AND LA_EMP.info_MOTOR_EIXO_X_EMPILHADOR_POS_ATUAL &lt; 780 THEN
		LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS		:= TRUE;
		passo_X_EMPILHADOR 									:= 1003;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1003: //verifica se o eixo X do empilhador está se movendo para posição 1. Caso esteja, desativa comando de movimento absoluto

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= FALSE;
			passo_X_EMPILHADOR 									:= 1004;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1004: //verifica se a mesa de giro está se movendo para posição. Caso esteja, desativa comando de movimento absoluto

	IF M2_LA_EMP_GIRO.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_GIRO_MESA_POSICIONADO	THEN
		LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS	:= FALSE;
		passo_X_EMPILHADOR 								:= 1005;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1005://verifica se Eixos X e Rotativo chegaram aos seus pontos
	
	IF	M0_LA_EMP_X.bit_MOVE_ABS_FEITO	OR 	LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			bit_X_EMPILHADOR_FEITO				:= TRUE;
			
	END_IF	
	
	IF	M2_LA_EMP_GIRO.bit_MOVE_ABS_FEITO	OR 	LA_EMP.bit_EIXO_GIRO_MESA_POSICIONADO	THEN
			bit_GIRO_MESA_FEITO	:= TRUE;
	END_IF	
	
	IF	bit_X_EMPILHADOR_FEITO		AND
		bit_GIRO_MESA_FEITO			THEN
			bit_X_EMPILHADOR_FEITO		:= FALSE;
			bit_GIRO_MESA_FEITO			:= FALSE;
		
			passo_X_EMPILHADOR 			:= 6000;
	END_IF	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
6000:
	
	IF LA_GERAL.bit_SACOLA_POSICIONADA	THEN
		LA_EMP.bit_LIBERA_PEGA	:= TRUE;
		LA_GERAL.bit_SACOLA_POSICIONADA 	:= FALSE;
		passo_X_EMPILHADOR 					:= 1006;
	END_IF
	
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1006: //aguarda liberação da sacola depositada na mesa para liberar movimento do eixo X da empilhadora para próxima posição de pega

	IF LA_EMP.bit_ENTREGA_EMPILHADOR_CONCLUIDO THEN
		passo_X_EMPILHADOR							:= 1007;
	END_IF
	

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1007: //manda os valores de coordenada para movimentos absolutos da posição 2 do eixo X e declara que está na posição 2,  além de comandar mesa de giro para posição final

	M0_LA_EMP_X.ABS_MOVER	:= PVAR.rec_ATUAL.coord_X_EMPILHADOR_POS[2];
	M2_LA_EMP_GIRO.ABS_MOVER			:= PVAR.rec_ATUAL.coord_MESA_GIRO_FINAL;
	PVAR.int_POSICAO_EIXO_X_EMPILHADOR	:=	2;
	passo_X_EMPILHADOR 					:= 1008;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1008: // Comanda eixo X do empilhador com movimento absoluto para posição 2.

	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
		LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= TRUE;
		LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS		:= TRUE;
		passo_X_EMPILHADOR 									:= 1009;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1009: //verifica se o eixo X do empilhador está se movendo para posição 1. Caso esteja, desativa comando de movimento absoluto

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= FALSE;
			passo_X_EMPILHADOR 									:= 1010;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1010: //verifica se a mesa de giro está se movendo para posição final. Caso esteja, desativa comando de movimento absoluto	

	IF M2_LA_EMP_GIRO.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_GIRO_MESA_POSICIONADO	THEN
		LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS	:= FALSE;
		passo_X_EMPILHADOR 								:= 1011;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1011: //verifica se o eixo X do empilhador completou movimento

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FEITO	OR 	LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			bit_X_EMPILHADOR_FEITO				:= TRUE;
			LA_EMP.bit_LIBERA_PEGA	:= TRUE;
	END_IF	
	
	IF	M2_LA_EMP_GIRO.bit_MOVE_ABS_FEITO	OR 	LA_EMP.bit_EIXO_GIRO_MESA_POSICIONADO	THEN
			bit_GIRO_MESA_FEITO	:= TRUE;
	END_IF	
	
	IF	bit_X_EMPILHADOR_FEITO		AND
		bit_GIRO_MESA_FEITO			THEN
			bit_X_EMPILHADOR_FEITO		:= FALSE;
			bit_GIRO_MESA_FEITO			:= FALSE;
		
			passo_X_EMPILHADOR 			:= 1012;
	END_IF		
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1012: //aguarda liberação da sacola depositada na mesa para liberar movimento do eixo X da empilhadora para próxima posição de pega

	IF LA_EMP.bit_ENTREGA_EMPILHADOR_CONCLUIDO THEN
		passo_X_EMPILHADOR							:= 1013;
	END_IF
	

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1013: //manda os valores de coordenada para movimentos absolutos da posição 3 do eixo X e declara que está na posição 3,  além de comandar mesa de giro para posição final

	M0_LA_EMP_X.ABS_MOVER	:= PVAR.rec_ATUAL.coord_X_EMPILHADOR_POS[3];
	M2_LA_EMP_GIRO.ABS_MOVER			:= PVAR.rec_ATUAL.coord_MESA_GIRO_FINAL;
	PVAR.int_POSICAO_EIXO_X_EMPILHADOR	:=	3;
	passo_X_EMPILHADOR 					:= 1014;
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1014: // Comanda eixo X do empilhador com movimento absoluto para posição 3.

	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
		LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= TRUE;
		LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS		:= TRUE;
		passo_X_EMPILHADOR 									:= 1015;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1015: //verifica se o eixo X do empilhador está se movendo para posição 3. Caso esteja, desativa comando de movimento absoluto

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= FALSE;
			passo_X_EMPILHADOR 									:= 1016;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1016: //verifica se a mesa de giro está se movendo para posição final. Caso esteja, desativa comando de movimento absoluto	

	IF M2_LA_EMP_GIRO.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_GIRO_MESA_POSICIONADO	THEN
		LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS	:= FALSE;
		passo_X_EMPILHADOR 								:= 1017;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1017: //verifica se o eixo X do empilhador completou movimento

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FEITO	OR 	LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			bit_X_EMPILHADOR_FEITO				:= TRUE;
			LA_EMP.bit_LIBERA_PEGA	:= TRUE;
	END_IF	
	
	IF	M2_LA_EMP_GIRO.bit_MOVE_ABS_FEITO	OR 	LA_EMP.bit_EIXO_GIRO_MESA_POSICIONADO	THEN
			bit_GIRO_MESA_FEITO	:= TRUE;
	END_IF	
	
	IF	bit_X_EMPILHADOR_FEITO		AND
		bit_GIRO_MESA_FEITO			THEN
			bit_X_EMPILHADOR_FEITO		:= FALSE;
			bit_GIRO_MESA_FEITO			:= FALSE;
		
			passo_X_EMPILHADOR 			:= 1018;
	END_IF		
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1018: //aguarda liberação da sacola depositada na mesa para liberar movimento do eixo X da empilhadora para próxima posição de pega

	IF LA_EMP.bit_ENTREGA_EMPILHADOR_CONCLUIDO THEN
		LA_EMP.bit_LIBERA_PEGA			:= FALSE;
		passo_X_EMPILHADOR							:= 1019;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1019: //manda os valores de coordenada para movimentos absolutos da posição 4 do eixo X e declara que está na posição 4,  além de comandar mesa de giro para posição inicial

	M0_LA_EMP_X.ABS_MOVER	:= PVAR.rec_ATUAL.coord_X_EMPILHADOR_POS[4];
	M2_LA_EMP_GIRO.ABS_MOVER			:= PVAR.rec_ATUAL.coord_MESA_GIRO_INICIAL;
	PVAR.int_POSICAO_EIXO_X_EMPILHADOR	:=	4;
	passo_X_EMPILHADOR 					:= 1020;
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1020: //libera movimento do eixo giro mesa

	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
		LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS	:= TRUE;
		passo_X_EMPILHADOR 								:= 1021;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1021: //verifica se começou o movimento
	
	IF M2_LA_EMP_GIRO.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_GIRO_MESA_POSICIONADO	THEN
		LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS	:= FALSE;
		passo_X_EMPILHADOR 								:= 1022;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1022://verifica se completou movimento

	IF	M2_LA_EMP_GIRO.bit_MOVE_ABS_FEITO	OR 	LA_EMP.bit_EIXO_GIRO_MESA_POSICIONADO	THEN
			passo_X_EMPILHADOR 								:= 1023;
	END_IF	

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1023: // Comanda eixo X do empilhador com movimento absoluto para posição 4.

	IF LA_GERAL.bit_MAQUINA_RODANDO 				THEN
		LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= TRUE;
		passo_X_EMPILHADOR 									:= 1024;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1024: //verifica se o eixo X do empilhador está se movendo para posição 4. Caso esteja, desativa comando de movimento absoluto

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= FALSE;
			passo_X_EMPILHADOR 									:= 1025;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1025: //verifica se o eixo X do empilhador completou movimento

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FEITO OR LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			LA_EMP.bit_LIBERA_PEGA	:= TRUE;
			passo_X_EMPILHADOR					:= 1026;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1026: //aguarda liberação da sacola depositada na mesa para liberar movimento do eixo X da empilhadora para próxima posição de pega. Mas caso já tenha atingido o máximo de camadas
	  //depositadas, vai para passo de posição de entrega do eixo X do empilhador.
	  
	IF 		(PVAR.int_POSICAO_EIXO_X_EMPILHADOR &gt;= PVAR.rec_ATUAL.int_NUM_MAX_CAMADAS_EMPILHADOR) 	AND 
			LA_EMP.bit_ENTREGA_EMPILHADOR_CONCLUIDO										THEN
				bit_INCREMENTA_SACOLA						:= TRUE;
				passo_X_EMPILHADOR							:= 1031;
	ELSIF 	(PVAR.int_POSICAO_EIXO_X_EMPILHADOR &lt; PVAR.rec_ATUAL.int_NUM_MAX_CAMADAS_EMPILHADOR) 	AND 
			LA_EMP.bit_ENTREGA_EMPILHADOR_CONCLUIDO										THEN
				passo_X_EMPILHADOR							:= 1027;
		
	END_IF	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1027: //manda os valores de coordenada para movimentos absolutos da posição 5 do eixo X e declara que está na posição 5

	M0_LA_EMP_X.ABS_MOVER	:= PVAR.rec_ATUAL.coord_X_EMPILHADOR_POS[5];
	PVAR.int_POSICAO_EIXO_X_EMPILHADOR	:=	5;
	bit_INCREMENTA_SACOLA				:= FALSE;
	passo_X_EMPILHADOR 					:= 1028;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1028: // Comanda eixo X do empilhador com movimento absoluto para posição 5.

	IF LA_GERAL.bit_MAQUINA_RODANDO 					THEN
		LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= TRUE;
		passo_X_EMPILHADOR 									:= 1029;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1029: //verifica se o eixo X do empilhador está se movendo para posição 5. Caso esteja, desativa comando de movimento absoluto

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= FALSE;
			passo_X_EMPILHADOR 									:= 1030;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1030: //verifica se o eixo X do empilhador completou movimento

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FEITO OR LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			LA_EMP.bit_EIXO_X_MOVE_CONCLUIDO		:= TRUE;
			LA_EMP.bit_LIBERA_PEGA				:= TRUE;
			passo_X_EMPILHADOR								:= 1031;
	END_IF


//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1031: //aguarda liberação da sacola depositada na mesa para liberar movimento do eixo X da empilhadora para próxima posição. Mas caso já tenha atingido o máximo de camadas
	  //depositadas, vai para passo de posição de entrega do eixo X da empolhadora.

	IF 		(PVAR.int_POSICAO_EIXO_X_EMPILHADOR &gt;= PVAR.rec_ATUAL.int_NUM_MAX_CAMADAS_EMPILHADOR) 	AND 
			LA_EMP.bit_ENTREGA_EMPILHADOR_CONCLUIDO										THEN
				tmr_ENTREGA_X.IN						:= TRUE;	
	END_IF	
	
	
	bit_INCREMENTA_SACOLA							:= TRUE;
	
	IF tmr_ENTREGA_X.Q	THEN
		tmr_ENTREGA_X.IN						:= FALSE;
		LA_EMP.bit_ENTREGANDO_PILHA_COMPLETA	:= TRUE;
		bit_INCREMENTA_SACOLA					:= FALSE;
		
		passo_X_EMPILHADOR						:= 1032;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1032: //verifica se maquina está rodando para liberar movimento do eixo X do empilhador
	
	IF	LA_GERAL.bit_MAQUINA_RODANDO			THEN	
			passo_X_EMPILHADOR 								:= 1033;
	END_IF

	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1033: //Manda os valores de coordenada para movimentos absolutos da posição de entrega de pilha do eixo X do empilhador

	IF LA_EMP.bit_ENTREGA_PILHA_CONCLUIDO	THEN
		M0_LA_EMP_X.ABS_MOVER				:= PVAR.rec_ATUAL.coord_X_EMPILHADOR_ENTREGA;
		LA_EMP.bit_ENTREGA_PILHA_CONCLUIDO	:=	FALSE;
		
		passo_X_EMPILHADOR 								:= 1034;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1034: // Comanda eixo X do empilhador com movimento absoluto para ENTREGA de pilha.

	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
		LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= TRUE;
		passo_X_EMPILHADOR 									:= 1035;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1035: //verifica se o eixo X do empilhador está se movendo para entrega. Caso esteja, desativa comando de movimento absoluto

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= FALSE;
			passo_X_EMPILHADOR 									:= 1036;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1036: //verifica se o eixo X do empilhador completou movimento

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FEITO OR LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			passo_X_EMPILHADOR							:= 1037;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1037://liga esteira na direção de acordo com o numero da pilha. Se for impar, liga na direção normal. Se não, liga a esteira invertida

	IF LA_EMP.bit_GIRO_MESA_REVERSE THEN
		LA_EMP.est_ROLETES_GIRO_MESA_REVERSE	:= FALSE;
		LA_EMP.est_ROLETES_GIRO_MESA			:= TRUE;
	ELSIF NOT LA_EMP.bit_GIRO_MESA_REVERSE THEN
		LA_EMP.est_ROLETES_GIRO_MESA			:= TRUE;
		LA_EMP.est_ROLETES_GIRO_MESA_REVERSE	:= TRUE;
	END_IF
	
	IF NOT LA_ENV.bit_EST_ENTRADA_CHEIA	THEN
		passo_X_EMPILHADOR 								:= 1038;
	END_IF
		
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1038://Após um tempo fora do sensor de presença da mesa de giro, considera que a pilha saiu da mesa de giro e conclui processo de entrega
	
	IF sens_EST_TRANS_PRESENCA	THEN
		passo_X_EMPILHADOR 			:= 1039;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1039://Declara pilha como entregue e para a esteira da mesa giro.

	tmr_sens_MESA_GIRO_OUT.IN						:=	FALSE;
	LA_EMP.est_ROLETES_GIRO_MESA			:= 	FALSE;
	LA_EMP.est_ROLETES_GIRO_MESA_REVERSE	:= 	FALSE;
	
	passo_X_EMPILHADOR 			:= 1040;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1040: //espera confirmação de que pilha de sacola saiu da mesa giro
	
	LA_EMP.bit_EST_PILHA_ENTREGUE			:=	FALSE;
	LA_EMP.bit_LIBERA_ENTREGA_PILHA		:= 	FALSE;
	LA_EMP.bit_ENTREGANDO_PILHA_COMPLETA	:=	FALSE;
	PVAR.int_PILHAS_ENTREGUES						:= 	PVAR.int_PILHAS_ENTREGUES + 1;
	passo_X_EMPILHADOR								:= 	998;	


//----------------------------//----------------------//------------------------//-------------------//--------------------//-----------------------------//	
//----------------------------//--------------------ROTINA DE INSPEÇÃO OK----------------------------//--------------------//----------------------------//--------------------

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
2000: //Manda os valores de coordenada para movimentos absolutos da posição de inspeção de de pilha do eixo X do empilhador

	
	M0_LA_EMP_X.ABS_MOVER.sp_POSICAO		 := PVAR.rec_ATUAL.coord_X_EMPILHADOR_INSPECAO.sp_POSICAO;
	M0_LA_EMP_X.ABS_MOVER.sp_VELOCIDADE	 := PVAR.rec_ATUAL.coord_X_EMPILHADOR_INSPECAO.sp_VELOCIDADE * 0.2;
	M0_LA_EMP_X.ABS_MOVER.sp_ACELERACAO	 := PVAR.rec_ATUAL.coord_X_EMPILHADOR_INSPECAO.sp_ACELERACAO * 0.2;
	M0_LA_EMP_X.ABS_MOVER.sp_DESACELERACAO := PVAR.rec_ATUAL.coord_X_EMPILHADOR_INSPECAO.sp_DESACELERACAO * 0.2;
	
	M2_LA_EMP_GIRO.ABS_MOVER							 := PVAR.rec_ATUAL.coord_MESA_GIRO_INSPECAO;	
	
	//GVL_CELULA.bit_CICLO_COMPLETO			 			 := TRUE;
	LA_EMP.bit_REALIZANDO_INSPECAO 			 := TRUE;
	tmr_LIBERA_X_INSPECAO.IN				 			 := TRUE;
	passo_X_EMPILHADOR 						 			 := 2001;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
2001: // Comanda eixo X do empilhador com movimento absoluto para INSPEÇÃO de pilha. Caso seja uma entrega de pilha para inspeção, primeiro espera movimento da mesa de giro

	LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= TRUE;
	tmr_LIBERA_X_INSPECAO.IN							:= FALSE;
	
	passo_X_EMPILHADOR 						 			:= 2002;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
2002: // Comanda mesa de giro com movimento absoluto para posição de inspeção após o eixo X do Empilhador mover ao menos 20% para que a mesa de giro não colida com a esteira de entrega

	IF(* GVL_CELULA.bit_MAQUINA_RODANDO AND*) (LA_EMP.info_MOTOR_EIXO_X_EMPILHADOR_POS_ATUAL &gt; 130 AND LA_EMP.info_MOTOR_EIXO_X_EMPILHADOR_POS_ATUAL &lt; 780) THEN
		LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS		:= TRUE;
		passo_X_EMPILHADOR 						 			:= 2003;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
2003: //verifica se o eixo X do empilhador está se movendo para entrega. Caso esteja, desativa comando de movimento absoluto

			LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= FALSE;
			passo_X_EMPILHADOR 									:= 2004;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
2004: //verifica se o eixo X do empilhador completou movimento e libera pilha para inspeção

	IF (M2_LA_EMP_GIRO.bit_MOVE_ABS_FEITO OR LA_EMP.bit_EIXO_GIRO_MESA_POSICIONADO) 								AND 
	   LA_EMP.info_MOTOR_EIXO_X_EMPILHADOR_POS_ATUAL &lt; (PVAR.rec_ATUAL.coord_X_EMPILHADOR_ENTREGA.sp_POSICAO * 0.9)	THEN
		M0_LA_EMP_X.ABS_MOVER		 			:= PVAR.rec_ATUAL.coord_X_EMPILHADOR_INSPECAO;
		 LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS		:= FALSE;
		LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= TRUE;
		passo_X_EMPILHADOR									:= 2005;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
2005: //verifica se eixo X completou o movimento e libera entrega de pilha inspecionada para mesa de giro

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FEITO OR LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= FALSE;
			LA_EMP.bit_EST_ENVIAR_PILHA_INSPECAO		:= 	TRUE;
			passo_X_EMPILHADOR									:= 2006;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
2006://liga esteira na direção de acordo com o numero da pilha. Se for impar, liga na direção normal. Se não, liga a esteira invertida

		LA_EMP.est_ROLETES_GIRO_MESA			:= TRUE;
		LA_EMP.est_ROLETES_GIRO_MESA_REVERSE	:= TRUE;	
		
		passo_X_EMPILHADOR								:= 2007;
									
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
2007://Após um tempo no sensor de presença da mesa de giro, considera que a pilha entrou na mesa de giro
	
	IF LA_EMP.di_SENS_PRODUTO_MESA_GIRO THEN
		tmr_sens_MESA_GIRO_IN.IN	:=	TRUE;
	END_IF
	
	IF tmr_sens_MESA_GIRO_IN.Q	THEN
		LA_EMP.bit_OPERADOR_INSPECAO_OK		:= FALSE;
		passo_X_EMPILHADOR								:= 2008;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
2008://Declara pilha como entregue e para a esteira da mesa giro. Começa entrega de pilha pronta

	tmr_sens_MESA_GIRO_IN.IN						:=	FALSE;
	LA_EMP.bit_LIBERA_INSPECAO_PILHA		:= 	FALSE;
	LA_EMP.est_ROLETES_GIRO_MESA			:= 	FALSE;
	LA_EMP.est_ROLETES_GIRO_MESA_REVERSE	:= 	FALSE;
	LA_EMP.bit_EST_ENVIAR_PILHA_INSPECAO	:=	FALSE;
	
	passo_X_EMPILHADOR								:= 2009;		

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
2009: //espera confirmação de que pilha de sacola saiu da de INSPEÇÃO e entrou, reincia o ciclo e zera a contagem de pilhas entregues

	IF LA_EMP.bit_EST_INSPECAO_ENTREGUE_2 THEN
		M0_LA_EMP_X.ABS_MOVER.sp_POSICAO			:= PVAR.rec_ATUAL.coord_X_EMPILHADOR_ENTREGA.sp_POSICAO;
		M0_LA_EMP_X.ABS_MOVER.sp_VELOCIDADE		:= PVAR.rec_ATUAL.coord_X_EMPILHADOR_ENTREGA.sp_VELOCIDADE * 0.1;
		M0_LA_EMP_X.ABS_MOVER.sp_ACELERACAO		:= PVAR.rec_ATUAL.coord_X_EMPILHADOR_ENTREGA.sp_ACELERACAO * 0.1;
		M0_LA_EMP_X.ABS_MOVER.sp_DESACELERACAO	:= PVAR.rec_ATUAL.coord_X_EMPILHADOR_ENTREGA.sp_DESACELERACAO * 0.1;
		LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS		:= TRUE;
		
		
		M2_LA_EMP_GIRO.ABS_MOVER								:= PVAR.rec_ATUAL.coord_MESA_GIRO_INICIAL;
		
		LA_EMP.bit_EST_PILHA_ENTREGUE		 :=	FALSE;
		LA_EMP.bit_LIBERA_INSPECAO_PILHA	 := FALSE;
		LA_EMP.bit_EST_INSPECAO_ENTREGUE_1 := FALSE;
		LA_EMP.bit_EST_INSPECAO_ENTREGUE_2 := FALSE;
		bit_RESET_CONTAGEM							 := FALSE;
		PVAR.int_PILHAS_ENTREGUES					 := 0;
		passo_X_EMPILHADOR							 := 2010;
	END_IF	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
2010://espera distancia segura sem risco de colisões para mover mesa giro
	
	LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= FALSE;
	
	IF LA_GERAL.bit_MAQUINA_RODANDO AND (LA_EMP.info_MOTOR_EIXO_X_EMPILHADOR_POS_ATUAL &gt; 130 AND LA_EMP.info_MOTOR_EIXO_X_EMPILHADOR_POS_ATUAL &lt; 780) THEN
		LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS		:= TRUE;
		
		passo_X_EMPILHADOR							 		:= 2011;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
2011: //verifica se a mesa de giro está se movendo para posição inicial. Caso esteja, desativa comando de movimento absoluto

	IF	M2_LA_EMP_GIRO.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_GIRO_MESA_POSICIONADO	THEN
			LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS	:= FALSE;
			passo_X_EMPILHADOR							 	:= 2012;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
2012: //verifica se a mesa de giro completou movimento

	IF	M2_LA_EMP_GIRO.bit_MOVE_ABS_FEITO OR LA_EMP.bit_EIXO_GIRO_MESA_POSICIONADO	THEN
			LA_EMP.bit_MESA_GIRO_CONCLUIDO	:= TRUE;
			passo_X_EMPILHADOR							:= 2013;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
2013://aumenta velocidade do eixo X em posição para entrega

	IF  LA_EMP.bit_EIXO_GIRO_MESA_POSICIONADO AND  LA_EMP.info_MOTOR_EIXO_X_EMPILHADOR_POS_ATUAL &gt; (PVAR.rec_ATUAL.coord_X_EMPILHADOR_ENTREGA.sp_POSICAO * 0.2) THEN
		M0_LA_EMP_X.ABS_MOVER		 			:= PVAR.rec_ATUAL.coord_X_EMPILHADOR_ENTREGA;
		LA_EMP.bit_ENTREGANDO_PILHA_COMPLETA		:= TRUE;
		LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= TRUE;
	END_IF

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FEITO OR LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= FALSE;
			passo_X_EMPILHADOR									:= 2014;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
2014://liga esteira na direção de acordo com o numero da pilha. Se for impar, liga na direção normal. Se não, liga a esteira invertida

	IF LA_EMP.bit_GIRO_MESA_REVERSE AND NOT LA_ENV.bit_EST_ENTRADA_CHEIA THEN
		LA_EMP.est_ROLETES_GIRO_MESA_REVERSE	:= FALSE;
		LA_EMP.est_ROLETES_GIRO_MESA			:= TRUE;
	ELSIF NOT LA_EMP.bit_GIRO_MESA_REVERSE AND NOT LA_ENV.bit_EST_ENTRADA_CHEIA THEN
		LA_EMP.est_ROLETES_GIRO_MESA			:= TRUE;
		LA_EMP.est_ROLETES_GIRO_MESA_REVERSE	:= TRUE;
	END_IF
	
	passo_X_EMPILHADOR 								:= 2015;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
2015://Após um tempo fora do sensor de presença da mesa de giro, considera que a pilha saiu da mesa de giro e conclui processo de entrega

	IF NOT LA_EMP.di_SENS_PRODUTO_MESA_GIRO THEN
		tmr_sens_MESA_GIRO_OUT.IN	:= TRUE;
	END_IF
	
	IF tmr_sens_MESA_GIRO_OUT.Q	THEN
		passo_X_EMPILHADOR 			:= 2016;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
2016://Declara pilha como entregue e para a esteira da mesa giro.

	tmr_sens_MESA_GIRO_OUT.IN						:=	FALSE;
	LA_EMP.est_ROLETES_GIRO_MESA			:= 	FALSE;
	LA_EMP.est_ROLETES_GIRO_MESA_REVERSE	:= 	FALSE;
	
	passo_X_EMPILHADOR 			:= 2017;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
2017: //espera confirmação de que pilha de sacola saiu da mesa giro
	
	LA_EMP.bit_EST_PILHA_ENTREGUE			:=	FALSE;
	LA_EMP.bit_LIBERA_ENTREGA_PILHA		:= 	FALSE;
	LA_EMP.bit_ENTREGANDO_PILHA_COMPLETA	:=	FALSE;
	LA_EMP.bit_REALIZANDO_INSPECAO		:=	FALSE;
	LA_EMP.bit_LIBERA_PEGA				:= 	FALSE;
	PVAR.int_PILHAS_ENTREGUES						:= 	PVAR.int_PILHAS_ENTREGUES + 1;
	passo_X_EMPILHADOR								:= 	998;	
	
	
	
//----------------------------//--------------------//-------------------------//---------------------------//--------------------//-----------------------------//-------------------------
//----------------------------//--------------------ROTINA DE PEGA PARA INSPEÇÃO----------------------------//--------------------//----------------------------//--------------------
	

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3000: //Manda os valores de coordenada para movimentos absolutos da posição máxima da Receita do eixo X do empilhador e declara que está na posição 6 

	M0_LA_EMP_X.ABS_MOVER	:= PVAR.rec_ATUAL.coord_X_EMPILHADOR_POS[PVAR.rec_ATUAL.int_NUM_MAX_CAMADAS_EMPILHADOR];
	passo_X_EMPILHADOR 					:= 3001;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3001: // Comanda eixo X do empilhador com movimento absoluto para posição 6.

	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
		LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= TRUE;
		passo_X_EMPILHADOR 									:= 3002;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3002: //verifica se o eixo X do empilhador está se movendo para posição 6. Caso esteja, desativa comando de movimento absoluto

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= FALSE;
			passo_X_EMPILHADOR 									:= 3003;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3003: //verifica se o eixo X do empilhador completou movimento

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FEITO OR LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			LA_EMP.bit_LIBERA_PEGA			:= false;
			passo_X_EMPILHADOR							:= 7000;
	END_IF	
		
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
7000:
	
	IF LA_GERAL.bit_SACOLA_POSICIONADA	THEN
		LA_EMP.bit_LIBERA_PEGA	:= TRUE;
		LA_GERAL.bit_SACOLA_POSICIONADA 	:= FALSE;
		passo_X_EMPILHADOR 					:= 3004;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3004: //aguarda liberação da sacola depositada na mesa para liberar movimento do eixo X da empilhadora para próxima posição de pega

	IF LA_EMP.bit_ENTREGA_EMPILHADOR_CONCLUIDO THEN
		passo_X_EMPILHADOR							:= 3005;
	END_IF

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3005: //manda os valores de coordenada para movimentos absolutos da posição 7 do eixo X e declara que está na posição 7

	M0_LA_EMP_X.ABS_MOVER	:= PVAR.rec_ATUAL.coord_X_EMPILHADOR_POS[PVAR.rec_ATUAL.int_NUM_MAX_CAMADAS_EMPILHADOR - 1];
	PVAR.int_POSICAO_EIXO_X_EMPILHADOR	:=	7;
	passo_X_EMPILHADOR 					:= 3006;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3006: // Comanda eixo X do empilhador com movimento absoluto para posição 7.

	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
		LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= TRUE;
		passo_X_EMPILHADOR 									:= 3007;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3007: //verifica se o eixo X do empilhador está se movendo para posição 7. Caso esteja, desativa comando de movimento absoluto

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= FALSE;
			passo_X_EMPILHADOR 									:= 3008;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3008: //verifica se o eixo X do empilhador completou movimento

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FEITO OR LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			LA_EMP.bit_EIXO_X_MOVE_CONCLUIDO	:= TRUE;
			LA_EMP.bit_LIBERA_PEGA			:= TRUE;
			passo_X_EMPILHADOR							:= 3009;
	END_IF	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3009: //aguarda liberação da sacola depositada na mesa para liberar movimento do eixo X da empilhadora para próxima posição de pega

	IF LA_EMP.bit_ENTREGA_EMPILHADOR_CONCLUIDO THEN
		passo_X_EMPILHADOR							:= 3010;
	END_IF
	

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3010: //manda os valores de coordenada para movimentos absolutos da posição 8 do eixo X e declara que está na posição 8

	M0_LA_EMP_X.ABS_MOVER	:= PVAR.rec_ATUAL.coord_X_EMPILHADOR_POS[PVAR.rec_ATUAL.int_NUM_MAX_CAMADAS_EMPILHADOR - 2];
	M2_LA_EMP_GIRO.ABS_MOVER			:= PVAR.rec_ATUAL.coord_MESA_GIRO_FINAL;
	PVAR.int_POSICAO_EIXO_X_EMPILHADOR	:=	8;
	passo_X_EMPILHADOR 					:= 3011;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3011: // Comanda eixo X do empilhador com movimento absoluto para posição 8.

	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
		LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= TRUE;
		passo_X_EMPILHADOR 									:= 3012;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3012: //verifica se o eixo X do empilhador está se movendo para posição 8. Caso esteja, desativa comando de movimento absoluto

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= FALSE;
			passo_X_EMPILHADOR 									:= 3013;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3013: //verifica se o eixo X do empilhador completou movimento

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FEITO OR LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			LA_EMP.bit_LIBERA_PEGA			:= TRUE;
			passo_X_EMPILHADOR							:= 3014;
	END_IF		
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3014://Comanda para posição de mesa de giro final após eixo X se movimentar 20% do trajeto para garantir que não colida a mesa de giro com a esteira de inspeção

	IF LA_GERAL.bit_MAQUINA_RODANDO AND (LA_EMP.info_MOTOR_EIXO_X_EMPILHADOR_POS_ATUAL &gt; 130 AND LA_EMP.info_MOTOR_EIXO_X_EMPILHADOR_POS_ATUAL &lt; 780) THEN
		LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS		:= TRUE;
		
		passo_X_EMPILHADOR 									:= 3015;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3015: //verifica se a mesa de giro está se movendo para posição final. Caso esteja, desativa comando de movimento absoluto

	IF	M2_LA_EMP_GIRO.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_GIRO_MESA_POSICIONADO	THEN
			LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS	:= FALSE;
			passo_X_EMPILHADOR 								:= 3016;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3016: //verifica se a mesa de giro completou movimento

	IF	M2_LA_EMP_GIRO.bit_MOVE_ABS_FEITO OR LA_EMP.bit_EIXO_GIRO_MESA_POSICIONADO	THEN
			LA_EMP.bit_MESA_GIRO_CONCLUIDO	:= TRUE;
			passo_X_EMPILHADOR 							:= 3017;
	END_IF	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3017: //aguarda liberação da sacola depositada na mesa para liberar movimento do eixo X da empilhadora para próxima posição de pega	
	
// 	IF 		(PVAR.rec_ATUAL.int_NUM_MAX_CAMADAS_EMPILHADOR - 4) = 0 	THEN
// 				passo_X_EMPILHADOR			:= 3028;
// 	ELSIF 	(PVAR.rec_ATUAL.int_NUM_MAX_CAMADAS_EMPILHADOR - 4) = 1		THEN
// 				passo_X_EMPILHADOR			:= 3018;
// 		
// 	END_IF	

	IF 	(PVAR.rec_ATUAL.int_NUM_MAX_CAMADAS_EMPILHADOR - 4) = 0 	THEN
		M2_LA_EMP_GIRO.ABS_MOVER			:= PVAR.rec_ATUAL.coord_MESA_GIRO_INICIAL;
	END_IF

	passo_X_EMPILHADOR			:= 3018;
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3018: //manda os valores de coordenada para movimentos absolutos da posição 9 do eixo X e declara que está na posição 9

	IF LA_EMP.bit_ENTREGA_EMPILHADOR_CONCLUIDO THEN
		M0_LA_EMP_X.ABS_MOVER	:= PVAR.rec_ATUAL.coord_X_EMPILHADOR_POS[PVAR.rec_ATUAL.int_NUM_MAX_CAMADAS_EMPILHADOR - 3];
		PVAR.int_POSICAO_EIXO_X_EMPILHADOR	:=	9;
		passo_X_EMPILHADOR 					:= 3019;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3019: // Comanda eixo X do empilhador com movimento absoluto para posição 9.

	IF LA_GERAL.bit_MAQUINA_RODANDO  THEN
		LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= TRUE;
		LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS		:= TRUE;
		passo_X_EMPILHADOR 									:= 3020;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3020: //verifica se o eixo X do empilhador está se movendo para posição 9. Caso esteja, desativa comando de movimento absoluto

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= FALSE;
			LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS		:= FALSE;
			passo_X_EMPILHADOR 									:= 3021;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3021: //verifica se o eixo X do empilhador completou movimento

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FEITO OR LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			LA_EMP.bit_LIBERA_PEGA			:= TRUE;
			passo_X_EMPILHADOR							:= 3022;
	END_IF


//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3022: //aguarda liberação da sacola depositada na mesa para liberar movimento do eixo X da empilhadora para POSIÇÃO 1

	IF 		(PVAR.rec_ATUAL.int_NUM_MAX_CAMADAS_EMPILHADOR - 4) = 0 		THEN
				passo_X_EMPILHADOR			:= 3025;
	ELSE		
				passo_X_EMPILHADOR			:= 3023;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3023: //manda os valores de coordenada para movimentos absolutos da posição 10 do eixo X e declara que está na posição 10

	IF LA_EMP.bit_ENTREGA_EMPILHADOR_CONCLUIDO THEN
		M0_LA_EMP_X.ABS_MOVER	:= PVAR.rec_ATUAL.coord_X_EMPILHADOR_POS[1];
		M2_LA_EMP_GIRO.ABS_MOVER			:= PVAR.rec_ATUAL.coord_MESA_GIRO_INICIAL;
		PVAR.int_POSICAO_EIXO_X_EMPILHADOR	:=	10;
		passo_X_EMPILHADOR 					:= 3024;
	END_IF
	
	// 	IF tmr_passo_3021.Q	THEN
	// 		passo_X_EMPILHADOR 					:= 3021;
	// 	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3024: // Comanda eixo X do empilhador com movimento absoluto para posição 10.

	IF LA_GERAL.bit_MAQUINA_RODANDO  THEN
		LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= TRUE;
		LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS		:= TRUE;
		passo_X_EMPILHADOR 									:= 3025;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3025: //verifica se o eixo X do empilhador está se movendo para posição 10. Caso esteja, desativa comando de movimento absoluto

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= FALSE;
			passo_X_EMPILHADOR 									:= 3026;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3026: //verifica se o eixo rotativo do empilhador está se movendo para posição inicial. Caso esteja, desativa comando de movimento absoluto

	IF	M2_LA_EMP_GIRO.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_GIRO_MESA_POSICIONADO	THEN
			LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS		:= FALSE;
			passo_X_EMPILHADOR 									:= 3027;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3027: //verifica se o eixo X do empilhador completou movimento	
	
	IF	M0_LA_EMP_X.bit_MOVE_ABS_FEITO	OR 	LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			bit_X_EMPILHADOR_FEITO				:= TRUE;
			LA_EMP.bit_LIBERA_PEGA	:= TRUE;
	END_IF	
	
	IF	M2_LA_EMP_GIRO.bit_MOVE_ABS_FEITO	OR 	LA_EMP.bit_EIXO_GIRO_MESA_POSICIONADO	THEN
			bit_GIRO_MESA_FEITO	:= TRUE;
	END_IF	
	
	IF	bit_X_EMPILHADOR_FEITO		AND
		bit_GIRO_MESA_FEITO			THEN
			bit_X_EMPILHADOR_FEITO		:= FALSE;
			bit_GIRO_MESA_FEITO			:= FALSE;
		
			passo_X_EMPILHADOR 			:= 3028;
	END_IF		
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3028://aguarda confirmação de pilha entregue e comanda posições para entregar pilha para inspeção

	M0_LA_EMP_X.ABS_MOVER		 	:= PVAR.rec_ATUAL.coord_X_EMPILHADOR_INSPECAO;
	M2_LA_EMP_GIRO.ABS_MOVER		 			:= PVAR.rec_ATUAL.coord_MESA_GIRO_INSPECAO;
	LA_EMP.bit_REALIZANDO_INSPECAO 	:= TRUE;
	passo_X_EMPILHADOR							:= 3029;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3029://comanda movimento da mesa de giro para posição de inspeção

	LA_EMP.bit_LIBERA_PEGA	:= FALSE;

	IF LA_GERAL.bit_MAQUINA_RODANDO AND LA_EMP.bit_ENTREGA_EMPILHADOR_CONCLUIDO	THEN
		LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS		:= TRUE;
		passo_X_EMPILHADOR									:= 3030;
	END_IF

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3030: //verifica se o eixo rotativo do empilhador está se movendo para posição inicial. Caso esteja, desativa comando de movimento absoluto

	IF	M2_LA_EMP_GIRO.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_GIRO_MESA_POSICIONADO	THEN
			LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS		:= FALSE;
			passo_X_EMPILHADOR 									:= 3031;
	END_IF	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3031://verifica se a mesa de giro completou o movimento	

	IF	M2_LA_EMP_GIRO.bit_MOVE_ABS_FEITO OR LA_EMP.bit_EIXO_GIRO_MESA_POSICIONADO	THEN
			passo_X_EMPILHADOR 	:= 3032;
	END_IF

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3032://se a máquina estiver rodando, comanda movimento do eixo X do empilhador para inspeção

	IF LA_GERAL.bit_MAQUINA_RODANDO	THEN
		LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= TRUE;
		passo_X_EMPILHADOR 									:= 3033;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3033://verifica se o eixo X do empilhador está se movendo para inspeção. Caso esteja, desativa comando de movimento absoluto

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FAZENDO OR LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
			LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS	:= FALSE;
			passo_X_EMPILHADOR 									:= 3034;
	END_IF	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3034: // verifica se eixo X do empilhador completou movimento

	IF	M0_LA_EMP_X.bit_MOVE_ABS_FEITO OR  LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	THEN
		LA_EMP.bit_LIBERA_INSPECAO_PILHA		:= 	TRUE;
		passo_X_EMPILHADOR 								:= 3035;
	END_IF	

	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3035://liga esteira de mesa giro para liberar pilha de sacola para esteira de inspeção
	
	LA_EMP.est_ROLETES_GIRO_MESA_REVERSE	:= FALSE;
	LA_EMP.est_ROLETES_GIRO_MESA			:= TRUE;
	passo_X_EMPILHADOR 								:= 3036;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3036://Após um tempo fora do sensor de presença da mesa de giro, considera que a pilha saiu da mesa de giro e conclui processo de entrega para mesa de inspeção
	

	IF LA_EMP.di_SENS_EST_INSPEC_PRODUTO_2 AND NOT LA_EMP.di_SENS_PRODUTO_MESA_GIRO THEN
		bit_RESET_CONTAGEM		:= TRUE;
		passo_X_EMPILHADOR 		:= 3037;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
3037://Declara pilha como entregue e para a esteira da mesa giro. Prepara mesa de giro para posição de reinicio

	tmr_sens_MESA_GIRO_IN.IN						:= FALSE;
	LA_EMP.est_ROLETES_GIRO_MESA			:= FALSE;
	LA_EMP.est_ROLETES_GIRO_MESA_REVERSE	:= FALSE;
	
	LA_EMP.bit_EST_PILHA_ENTREGUE		 	:= FALSE;
	LA_EMP.bit_LIBERA_INSPECAO_PILHA	 	:= FALSE;
	LA_EMP.bit_EST_INSPECAO_ENTREGUE_1 	:= FALSE;
	LA_EMP.bit_EST_INSPECAO_ENTREGUE_2 	:= FALSE;
	bit_RESET_CONTAGEM							 	:= FALSE;
	LA_EMP.bit_REALIZANDO_INSPECAO	 	:= FALSE;
	LA_EMP.bit_valv_DESCE_MESA_GIRO	 	:= FALSE;

	passo_X_EMPILHADOR							 	:= 998;
	

	
END_CASE

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
//LÓGICAS AUXILIARES


	
	
(*//CONTINUAR MOVIMENTO DO EIXO X DO EMPILHADOR APÓS PARADA DE EMERGÊNCIA
	IF (bt_MAQUINA_RESET OR bt_MAQUINA_RESET_2) AND NOT GVL_CELULA.bit_MAQUINA_RODANDO	THEN
			
			IF 	passo_X_EMPILHADOR &gt;= 0 	AND
				passo_X_EMPILHADOR &lt;= 15 	THEN
				GVL_EMPILHAMENTO.bit_EIXO_X_EMPILHADOR_MOVER_ABS		:= FALSE;
				passo_X_EMPILHADOR := 9;
			END_IF	
	
			IF 	(passo_X_EMPILHADOR &gt;= 1000	AND
				passo_X_EMPILHADOR &lt;= 1003) THEN
				GVL_EMPILHAMENTO.bit_EIXO_X_EMPILHADOR_MOVER_ABS		:= FALSE;
				passo_X_EMPILHADOR := 999;
			END_IF
			
			IF 	passo_X_EMPILHADOR &gt;= 1005 	AND
				passo_X_EMPILHADOR &lt;= 1008 	THEN
				GVL_EMPILHAMENTO.bit_EIXO_X_EMPILHADOR_MOVER_ABS		:= FALSE;
				passo_X_EMPILHADOR := 1005;
			END_IF
			
			IF 	passo_X_EMPILHADOR &gt;= 1010 	AND
				passo_X_EMPILHADOR &lt;= 1013 	THEN
				GVL_EMPILHAMENTO.bit_EIXO_X_EMPILHADOR_MOVER_ABS		:= FALSE;
				passo_X_EMPILHADOR := 1010;
			END_IF
			
			IF 	passo_X_EMPILHADOR &gt;= 1015 	AND
				passo_X_EMPILHADOR &lt;= 1018 	THEN
				GVL_EMPILHAMENTO.bit_EIXO_X_EMPILHADOR_MOVER_ABS		:= FALSE;
				passo_X_EMPILHADOR := 1015;
			END_IF
			
			IF 	passo_X_EMPILHADOR &gt;= 1020 	AND
				passo_X_EMPILHADOR &lt;= 1023 	THEN
				GVL_EMPILHAMENTO.bit_EIXO_X_EMPILHADOR_MOVER_ABS		:= FALSE;
				passo_X_EMPILHADOR := 1020;
			END_IF
			
			IF 	passo_X_EMPILHADOR &gt;= 1025 	AND
				passo_X_EMPILHADOR &lt;= 1028 	THEN
				GVL_EMPILHAMENTO.bit_EIXO_X_EMPILHADOR_MOVER_ABS		:= FALSE;
				passo_X_EMPILHADOR := 1025;
			END_IF
			
			IF 	passo_X_EMPILHADOR &gt;= 2000 	AND
				passo_X_EMPILHADOR &lt;= 2003	THEN
				GVL_EMPILHAMENTO.bit_EIXO_X_EMPILHADOR_MOVER_ABS		:= FALSE;
				passo_X_EMPILHADOR := 2000;
			END_IF
			
			IF 	passo_X_EMPILHADOR &gt;= 2005 	AND
				passo_X_EMPILHADOR &lt;= 2008	THEN
				GVL_EMPILHAMENTO.bit_EIXO_X_EMPILHADOR_MOVER_ABS		:= FALSE;
				passo_X_EMPILHADOR := 2005;
			END_IF
			
			IF 	passo_X_EMPILHADOR &gt;= 2010 	AND
				passo_X_EMPILHADOR &lt;= 2013	THEN
				GVL_EMPILHAMENTO.bit_EIXO_X_EMPILHADOR_MOVER_ABS		:= FALSE;
				passo_X_EMPILHADOR := 2010;
			END_IF
			
			IF 	passo_X_EMPILHADOR &gt;= 2015 	AND
				passo_X_EMPILHADOR &lt;= 2015	THEN
				GVL_EMPILHAMENTO.bit_EIXO_X_EMPILHADOR_MOVER_ABS		:= FALSE;
				passo_X_EMPILHADOR := 2015;
			END_IF
			
			IF 	passo_X_EMPILHADOR &gt;= 2020 	AND
				passo_X_EMPILHADOR &lt;= 2023	THEN
				GVL_EMPILHAMENTO.bit_EIXO_X_EMPILHADOR_MOVER_ABS		:= FALSE;
				passo_X_EMPILHADOR := 2020;
			END_IF
			
	END_IF
	
*)

	
	
	//EIXO X EMPILHADOR JÁ ESTÁ NA POSIÇÃO
	IF	LA_EMP.info_MOTOR_EIXO_X_EMPILHADOR_POS_ATUAL	&gt;= M0_LA_EMP_X.ABS_MOVER.sp_POSICAO - 1	AND
		LA_EMP.info_MOTOR_EIXO_X_EMPILHADOR_POS_ATUAL	&lt;= M0_LA_EMP_X.ABS_MOVER.sp_POSICAO + 1	THEN
			LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	:= TRUE;
	ELSE
			LA_EMP.bit_EIXO_X_EMPILHADOR_POSICIONADO	:= FALSE;
	END_IF
	
	
	//EIXO X EMPILHADOR JÁ ESTÁ NA POSIÇÃO
	IF	LA_EMP.info_MOTOR_GIRO_MESA_POS_ATUAL	&gt;= M2_LA_EMP_GIRO.ABS_MOVER.sp_POSICAO - 1	AND
		LA_EMP.info_MOTOR_GIRO_MESA_POS_ATUAL	&lt;= M2_LA_EMP_GIRO.ABS_MOVER.sp_POSICAO + 1	THEN
			LA_EMP.bit_EIXO_GIRO_MESA_POSICIONADO	:= TRUE;
	ELSE
			LA_EMP.bit_EIXO_GIRO_MESA_POSICIONADO	:= FALSE;
	END_IF
	
	
		
	//Define se a posicão da mesa de giro de acordo com a posição atual do eixo X
	IF M2_LA_EMP_GIRO.ABS_MOVER.sp_POSICAO &gt; 90 THEN
		LA_EMP.bit_GIRO_MESA_FOWARD	:=	TRUE;
		LA_EMP.bit_GIRO_MESA_REVERSE	:=	FALSE;
	ELSE
		LA_EMP.bit_GIRO_MESA_FOWARD	:=	FALSE;
		LA_EMP.bit_GIRO_MESA_REVERSE	:=	TRUE;
	END_IF
	

	
	
//TIMERS EIXO X
tmr_HOME 	  (PT	:= T#200MS);
tmr_ENTREGA_X (PT	:= T#100MS);
tmr_passo_2021(PT	:= T#300MS);
tmr_passo_2032(PT	:= T#500MS);
tmr_LIBERA_X_INSPECAO(PT	:= T#1500MS);
cont_PILHA_ENTREGA(CU:= bit_INCREMENTA_SACOLA, RESET:= bit_RESET_CONTAGEM, PV:= 999, CV=&gt; pvar.int_PILHAS_ENTREGUES);	


//TIMERS GIRO MESA
tmr_HOME 			(PT	:= T#200MS);
tmr_sens_MESA_GIRO_IN 	(PT	:= T#500MS);
tmr_sens_MESA_GIRO_OUT 	(PT	:= T#2300MS);
TMR_GIRO_1		 	(PT	:= T#4000MS);
TMR_GIRO_2		 	(PT	:= T#4000MS);
TMR_GIRO_3		 	(PT	:= T#4000MS);
TMR_GIRO_4		 	(PT	:= T#500MS);
TMR_GIRO_5		 	(PT	:= T#4000MS);
TMR_GIRO_10		 	(PT	:= T#4000MS);

tmr_passo_1041		 	(PT	:= T#300MS);	
	</Single>
            <Single Name="LineInfoPersistence" Type="string">08b93842-1943-4ea4-b3b9-89e66cce88c1_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM B02_EMPILHADOR_X
VAR
	tmr_HOME						: TON;
	tmr_DESLIGA_EST_MESA_GIRO		: TON;
	tmr_ENTREGA_X					: TON;
	tmr_passo_2021					: TON;
	tmr_passo_2032					: TON;
	tmr_LIBERA_X_INSPECAO			: TON;
	
	cont_PILHA_ENTREGA				: CTU;
	bit_INCREMENTA_SACOLA			: BOOL;
	bit_RESET_CONTAGEM				: BOOL;
	passo_X_EMPILHADOR				: INT := 9;
	
	
	int_posicao_mesa		:	INT;
	num_RESTANTE_DIVISAO_1	:	REAL;
	num_RESTANTE_DIVISAO_2	:	REAL;
	
	tmr_sens_MESA_GIRO_IN	:	TON;
	tmr_sens_MESA_GIRO_OUT	:	TON;
	TMR_GIRO_1				: 	TON;
	TMR_GIRO_2				: 	TON;
	TMR_GIRO_3				: 	TON;
	TMR_GIRO_4				: 	TON;
	TMR_GIRO_5				: 	TON;
	
	TMR_GIRO_10				: TON;
	
	tmr_passo_1041			: TON;
	
	
	bit_X_EMPILHADOR_FEITO			: BOOL;
	bit_GIRO_MESA_FEITO				: BOOL;
END_VAR

//1000 - 1003
//1005 - 1008
//1010 - 1013
//1015 - 1018
//1020 - 1023
//1025 - 1029
//2000 - 2003
//2005 - 2008
//2010 - 2013
//2015 - 2018
//2020 - 2023
</Single>
            <Single Name="LineInfoPersistence" Type="string">08b93842-1943-4ea4-b3b9-89e66cce88c1_Decl_LineIds</Single>
          </Single>
        </Single>
