	//E-16DIO - SLOT 4 (RMT50004)
		do_VALV_FECHA_FILME_2			: BOOL;
		do_SPEED_A_TRANSP_SAIDA_1		: BOOL;
		do_VALV_FECHA_FILME_1			: BOOL;
		do_VALV_FECHA_FILME_3			: BOOL;
	
	
END_VAR</Single>
