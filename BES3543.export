            <Single Name="TextBlobForSerialisation" Type="string">IF LA_IHM.bit_bt_RESET_EST_SAIDA THEN
	passo_EST_SAIDA	:=	9;	
END_IF


CASE passo_EST_SAIDA OF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
09: //HOME: Reseta variáveis e recua atuadores
	
	LA_ENV.bit_valv_FECHA_FILME_1	:=	FALSE;
	LA_ENV.bit_valv_FECHA_FILME_2	:=	FALSE;
	LA_ENV.bit_valv_FECHA_FILME_3	:=	FALSE;
	LA_ENV.est_SAIDA_ENVOLVEDOR		:=	FALSE;
	
	LA_ENV.bit_ENVOLVEDOR_SACOLA_DEPOSITADA	:=	FALSE;
	LA_ENV.bit_ENVOLVEDOR_ENVIANDO_PILHA	:=	FALSE;
	
	tmr_PASSO_1001.IN						:=	FALSE;
	tmr_PASSO_1003.IN						:= FALSE;
	tmr_PASSO_1007.IN						:=	FALSE;
	tmr_PASSO_1010.IN						:= FALSE;
	passo_EST_SAIDA	:=	10;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
10:	//aguarda feedback dos sensores de recuo dos atuadores

	IF 	sens_FECHA_FILME_1_RC	AND
		sens_FECHA_FILME_2_RC	AND
		sens_FECHA_FILME_3_RC	THEN
			passo_EST_SAIDA	:=	999;
	END_IF	
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
999: //inicio de ciclo com máquina rodando

	IF LA_GERAL.bit_MAQUINA_RODANDO	THEN
		passo_EST_SAIDA	:=	1000;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1000: //aguarda confirmação de pilha de sacola depositada na esteira de saida e recua fecha filme 1

	IF 	LA_ENV.bit_ENVOLVEDOR_SACOLA_DEPOSITADA 	(*OR 
   (NOT GVL_ENVOLVEDOR.bit_ENVOLVEDOR_SACOLA_DEPOSITANDO	AND
		sens_SAIDA_ENVOLVEDOR_1) 	*)						THEN
			LA_ENV.bit_valv_FECHA_FILME_1	:=	FALSE;
			passo_EST_SAIDA	:=	1001;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1001://espera feedback do sensor de recuo do fecha filme 1, e liga esteira

	IF sens_FECHA_FILME_1_RC AND LA_GERAL.bit_MAQUINA_RODANDO THEN
		tmr_PASSO_1001.IN	:=	TRUE;
	END_IF
	
	IF tmr_PASSO_1001.Q	THEN
		LA_ENV.est_SAIDA_ENVOLVEDOR	:=	TRUE;
		passo_EST_SAIDA						:=	1002;
		tmr_PASSO_1001.IN					:=	FALSE;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1002://assim que chegar no sensor de saida do envolvedor 2, desliga esteira

	IF sens_SAIDA_ENVOLVEDOR_2 THEN
		LA_ENV.est_SAIDA_ENVOLVEDOR	:=	FALSE;
		passo_EST_SAIDA	:=	1003;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1003://aciona atuador fecha filme 2

	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
		LA_ENV.bit_valv_FECHA_FILME_2	:=	TRUE;
		tmr_PASSO_1003.IN := TRUE;
		passo_EST_SAIDA	:=	1004;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1004://espera confirmaçao de avanço e recua atuador fecha filme 2

	IF tmr_PASSO_1003.Q AND LA_GERAL.bit_MAQUINA_RODANDO THEN
		tmr_PASSO_1003.IN := FALSE;
		LA_ENV.bit_valv_FECHA_FILME_2	:=	FALSE;
		passo_EST_SAIDA	:=	1005;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1005://espera confirmação de recuo e liga esteira
	
	IF sens_FECHA_FILME_2_RC AND LA_GERAL.bit_MAQUINA_RODANDO THEN
		LA_ENV.est_SAIDA_ENVOLVEDOR	:=	TRUE;
		passo_EST_SAIDA	:=	1006;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1006://assim que chegar no sensor de saida do envolvedor 3, desliga esteira

	IF sens_SAIDA_ENVOLVEDOR_3 THEN
		LA_ENV.est_SAIDA_ENVOLVEDOR	:=	FALSE;
		passo_EST_SAIDA	:=	1007;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1007://aciona atuador fecha filme 3

	IF LA_GERAL.bit_MAQUINA_RODANDO	THEN
		LA_ENV.bit_valv_FECHA_FILME_3	:=	TRUE;
		tmr_PASSO_1007.IN						:= TRUE;
		passo_EST_SAIDA	:=	1008;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1008://aguarda confirmação de avanço de atuador fecha filme 3

	IF (*sens_FECHA_FILME_3_AV AND*) tmr_PASSO_1007.Q	THEN
		tmr_PASSO_1007.IN						:=	FALSE;
		LA_ENV.bit_valv_FECHA_FILME_3	:=	FALSE;
		passo_EST_SAIDA	:=	1009;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1009://aguarda confirmação de recuo de atuador fecha filme 3 e liga esteira

	IF sens_FECHA_FILME_3_RC	THEN
		//GVL_ENVOLVEDOR.est_SAIDA_ENVOLVEDOR	:=	TRUE;
		passo_EST_SAIDA	:=	1011;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1010://Caso atinja o sensor de saida da esteira do envolvedor 4, e não esteja no processo de pesar sacola e o atuador de transferencia esteja avançado, pula para próximo passo. Se não, desliga esteira
	
	
	IF 	sens_SAIDA_ENVOLVEDOR_4 AND (NOT GVL_PESAGEM.bit_PESANDO_PILHA_SACOLA OR NOT sens_TRANSFERENCIA_AV)	THEN
			LA_ENV.est_SAIDA_ENVOLVEDOR	:=	FALSE;
			tmr_PASSO_1010.IN					:=	TRUE;
			passo_EST_SAIDA						:=	1011;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1011:

	IF 	NOT GVL_PESAGEM.bit_PESANDO_PILHA_SACOLA AND sens_TRANSFERENCIA_AV (*AND tmr_PASSO_1010.Q*)	THEN
			LA_ENV.est_SAIDA_ENVOLVEDOR			 :=	TRUE;
			LA_ENV.bit_ENVOLVEDOR_ENVIANDO_PILHA :=	TRUE;
			tmr_PASSO_1010.IN							 := false;
			passo_EST_SAIDA								 :=	1012;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1012://aguarda pilha de sacola sair da esteira para desligar esteira

	IF sens_MESA_TRANSFER_1 OR sens_MESA_TRANSFER_2	THEN
		LA_ENV.est_SAIDA_ENVOLVEDOR				:=	FALSE;
		LA_ENV.bit_ENVOLVEDOR_SACOLA_DEPOSITADA	:=	FALSE;
		LA_ENV.bit_ENVOLVEDOR_ENVIANDO_PILHA 	:=	FALSE;
		passo_EST_SAIDA	:=	999;
	END_IF
	
	







END_CASE




//------------//-----------LÓGICAS EXTRAS---------------//----------------------//--------------------------//

//-----------ATUADORES-------------//--------------------//---------------------//

valv_FECHA_FILME_1		:=	LA_ENV.bit_valv_FECHA_FILME_1;
valv_FECHA_FILME_2		:=	LA_ENV.bit_valv_FECHA_FILME_2;
valv_FECHA_FILME_3		:=	LA_ENV.bit_valv_FECHA_FILME_3;



//-----------RETOMADA--------------//------------------//---------------------//

(*IF GVL_ENVOLVEDOR.bit_ENVOLVEDOR_SACOLA_DEPOSITADA AND reset_rotina THEN
	IF 	passo_EST_SAIDA &gt;= 999 	AND
			passo_EST_SAIDA &lt;= 1001	THEN
			
			passo_EST_SAIDA := 999;
		END_IF
	
		IF 	passo_EST_SAIDA &gt;= 1002 AND
			passo_EST_SAIDA &lt;= 1005	THEN
			
			passo_EST_SAIDA := 1002;
		END_IF	
	
		IF 	passo_EST_SAIDA &gt;= 1006 AND
			passo_EST_SAIDA &lt;= 1009	THEN
			
			passo_EST_SAIDA := 1006;
	END_IF
ELSIF NOT GVL_ENVOLVEDOR.bit_ENVOLVEDOR_SACOLA_DEPOSITADA AND reset_rotina	THEN
			passo_EST_SAIDA := 9;
END_IF
	
*)

tmr_PASSO_1001(PT:= T#300MS);
tmr_PASSO_1003(PT:= T#2500MS);
tmr_PASSO_1007(PT:= T#3000MS);
tmr_PASSO_1010(PT:= T#10000MS);
</Single>
