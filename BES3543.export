        <Single Name="Timestamp" Type="long">639246456788902315</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">//	COMANDO		============//============//============//============//============//============//============
	// Seleciona a fonte do comando conforme o modo
	// Motor desliga se safety inativa OU alarme de falha travado
	
	IF in_SAFETY_ATIVO AND NOT in_FALHA_MOTOR THEN

		IF in_MODO_MANUAL THEN
			bit_CMD_FWD := in_MANUAL_CMD_FWD;
			bit_CMD_REV := in_MANUAL_CMD_REV;
		ELSE
			bit_CMD_FWD := in_AUTO_CMD_FWD;
			bit_CMD_REV := in_AUTO_CMD_REV;
		END_IF

		// Intertravamento: nunca aciona FWD e REV simultaneamente
		out_MOTOR_FWD := bit_CMD_FWD AND NOT bit_CMD_REV;
		out_MOTOR_REV := bit_CMD_REV AND NOT bit_CMD_FWD;

	ELSE
		// Safety inativa ou falha do motor: desliga o motor
		out_MOTOR_FWD := FALSE;
		out_MOTOR_REV := FALSE;

	END_IF

//	FALHA		============//============//============//============//============//============//============
	// Falha só é considerada válida com a segurança ativa.
	// Uma vez travada, só sai com in_RESET_ALARME (reset manual do operador).

	sr_FALHA (SET1 := in_SAFETY_ATIVO AND in_FALHA_MOTOR, RESET := in_RESET_ALARME);
	out_ALARME	 := sr_FALHA.Q1;</Single>
            <Single Name="LineInfoPersistence" Type="string">b84fac77-8e76-4df9-94ac-9a1542090652_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_SMARTMOTOR

VAR_INPUT
	in_SAFETY_ATIVO			: BOOL;
	in_MODO_MANUAL			: BOOL;
	in_AUTO_CMD_FWD			: BOOL;
	in_AUTO_CMD_REV			: BOOL;
	in_MANUAL_CMD_FWD		: BOOL;
	in_MANUAL_CMD_REV		: BOOL;
	in_FALHA_MOTOR			: BOOL;
	in_RESET_ALARME			: BOOL;
END_VAR

VAR_OUTPUT
	out_MOTOR_FWD			: BOOL;
	out_MOTOR_REV			: BOOL;
	out_ALARME				: BOOL;
END_VAR

VAR
	bit_CMD_FWD				: BOOL;
	bit_CMD_REV				: BOOL;
	sr_FALHA				: SR;
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">b84fac77-8e76-4df9-94ac-9a1542090652_Decl_LineIds</Single>
          </Single>
