	In_Minutos_Parado_T3				:=	LA_IHM.tmr_MAQUINA_PARADA_T3 MOD Constante_Hora;
	Resultado_Minuto_Parada_Turno3		:=	In_Minutos_Parado_T3 / Constante_minuto;
	In_Segundos_Parado_T3				:=	LA_IHM.tmr_MAQUINA_PARADA_T3 MOD Constante_minuto;
	Resultado_Segundo_Parada_Turno3		:=	In_Segundos_Parado_T3 / Constante_segundo;
	
	Resultado_Hora_Ociosa_Turno3 		:= 	LA_IHM.tmr_MAQUINA_OCIOSA_T3 / Constante_Hora;
	In_Minutos_Ocioso_T3				:=	LA_IHM.tmr_MAQUINA_OCIOSA_T3 MOD Constante_Hora;
	Resultado_Minuto_Ociosa_Turno3		:=	In_Minutos_Ocioso_T3 / Constante_minuto;
	In_Segundos_Ocioso_T3				:=	LA_IHM.tmr_MAQUINA_OCIOSA_T3 MOD Constante_minuto;
	Resultado_Segundo_Ociosa_Turno3		:=	In_Segundos_Ocioso_T3 / Constante_segundo;
	
	LA_IHM.num_MAQUINA_RODANDO_HORAS_T3 := Resultado_Hora_Rodando_Turno3;
	LA_IHM.num_MAQUINA_PARADA_HORAS_T3 	:= Resultado_Hora_Parada_Turno3;
	LA_IHM.num_MAQUINA_OCIOSA_HORAS_T3 	:= Resultado_Hora_Ociosa_Turno3;
	
	LA_IHM.num_MAQUINA_RODANDO_MINUTOS_T3 := Resultado_Minuto_Rodando_Turno3;
	LA_IHM.num_MAQUINA_PARADA_MINUTOS_T3 	:= Resultado_Minuto_Parada_Turno3;
	LA_IHM.num_MAQUINA_OCIOSA_MINUTOS_T3 := Resultado_Minuto_Ociosa_Turno3;
	
	LA_IHM.num_MAQUINA_RODANDO_SEGUNDOS_T3 := Resultado_Segundo_Rodando_Turno3;
	LA_IHM.num_MAQUINA_PARADA_SEGUNDOS_T3 := Resultado_Segundo_Parada_Turno3;
	LA_IHM.num_MAQUINA_OCIOSA_SEGUNDOS_T3 := Resultado_Segundo_Ociosa_Turno3;</Single>
