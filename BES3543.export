      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">//SE A MÁQUINA ESTIVER EM MODO MANUAL E NÃO ESTIVER RODANDO, HABILITA SELEÇÃO MANUAL DE ATUADORES
	IF	LA_GERAL.bit_MAQUINA_MANUAL	AND
	NOT	LA_GERAL.bit_MAQUINA_RODANDO	THEN
			
			IF LA_IHM.bit_SELEC_ENVOLVEDOR_APROX_GARRA		THEN
					LA_IHM.int_ENVOLVEDOR_ATUADOR_SELECIONADO	:= 1;
			END_IF
			
			
			IF LA_IHM.bit_SELEC_ENVOLVEDOR_GARRA_DUPLA		THEN
					LA_IHM.int_ENVOLVEDOR_ATUADOR_SELECIONADO	:= 2;
			END_IF
			
			IF LA_IHM.bit_SELEC_ENVOLVEDOR_CORTE_FILME		THEN
					LA_IHM.int_ENVOLVEDOR_ATUADOR_SELECIONADO	:= 3;
			END_IF
			
			IF LA_IHM.bit_SELEC_ENVOLVEDOR_VACUO_FILME		THEN
					LA_IHM.int_ENVOLVEDOR_ATUADOR_SELECIONADO	:= 4;
			END_IF
			
			IF LA_IHM.bit_SELEC_ENVOLVEDOR_FECHA_FILME_1		THEN
					LA_IHM.int_ENVOLVEDOR_ATUADOR_SELECIONADO	:= 5;
			END_IF
			
			IF LA_IHM.bit_SELEC_ENVOLVEDOR_FECHA_FILME_2		THEN
					LA_IHM.int_ENVOLVEDOR_ATUADOR_SELECIONADO	:= 6;
			END_IF
			
			IF LA_IHM.bit_SELEC_ENVOLVEDOR_FECHA_FILME_3		THEN
					LA_IHM.int_ENVOLVEDOR_ATUADOR_SELECIONADO	:= 7;
			END_IF

		
			
			CASE	LA_IHM.int_ENVOLVEDOR_ATUADOR_SELECIONADO	OF
					
					0: //SEM ATUADOR SELECIONADO
						LA_IHM.bit_ATU_ENVOLVEDOR_AVANCADO	:= FALSE;
						LA_IHM.bit_ATU_ENVOLVEDOR_RECUADO	:= FALSE;			
			
					1://ATUADOR ENVOLVEDOR APROX GARRA
						IF LA_IHM.bit_ATU_ENVOLVEDOR_AVANCAR	THEN
								LA_ENV.bit_valv_APROX_GARRA	:= FALSE;
						END_IF
						
						IF LA_IHM.bit_ATU_ENVOLVEDOR_RECUAR	THEN
								LA_ENV.bit_valv_APROX_GARRA	:= TRUE;
						END_IF
						
						LA_IHM.bit_ATU_ENVOLVEDOR_AVANCADO	:= (LA_GERAL.di_ENV_SENS_ATU_ABERTURA_AV);
						LA_IHM.bit_ATU_ENVOLVEDOR_RECUADO	:= (LA_GERAL.di_ENV_SENS_ATU_ABERTURA_RC);
						
					2://ATUADOR ENVOLVEDOR GARRA DUPLA
						IF LA_IHM.bit_ATU_ENVOLVEDOR_AVANCAR	THEN
								LA_ENV.bit_valv_GARRA_DUPLA	:= FALSE;
						END_IF
						
						IF LA_IHM.bit_ATU_ENVOLVEDOR_RECUAR	THEN
								LA_ENV.bit_valv_GARRA_DUPLA	:= TRUE;
						END_IF
						
						//GVL_IHM.bit_ATU_ENVOLVEDOR_AVANCADO	:= sens_MESA_GIRO_AV;
						LA_IHM.bit_ATU_ENVOLVEDOR_RECUADO	:= LA_GERAL.di_ENV_SENS_ATU_GARRA_LD_RC AND LA_GERAL.di_ENV_SENS_ATU_GARRA_LE_RC;
						
					3://ATUADOR CORTE FILME
						IF LA_IHM.bit_ATU_ENVOLVEDOR_AVANCAR	THEN
								LA_ENV.bit_valv_CORTE_FILME	:= TRUE;
						END_IF
						
						IF LA_IHM.bit_ATU_ENVOLVEDOR_RECUAR	THEN
								LA_ENV.bit_valv_CORTE_FILME	:= FALSE;
						END_IF
						
						LA_IHM.bit_ATU_ENVOLVEDOR_AVANCADO	:= sens_CORTE_FILME_AV;
						LA_IHM.bit_ATU_ENVOLVEDOR_RECUADO	:= sens_CORTE_FILME_RC;
						
					4://ATUADOR VACUO FILME
						IF LA_IHM.bit_ATU_ENVOLVEDOR_AVANCAR	THEN
								LA_ENV.bit_valv_VACUO_FILME	:= TRUE;
						END_IF
						
						IF LA_IHM.bit_ATU_ENVOLVEDOR_RECUAR	THEN
								LA_ENV.bit_valv_VACUO_FILME	:= FALSE;
						END_IF
						
						//GVL_IHM.bit_ATU_ENVOLVEDOR_AVANCADO	:= sens_PINCA_GARRA_EMPILHADOR_AV;
						//GVL_IHM.bit_ATU_ENVOLVEDOR_RECUADO	:= sens_PINCA_GARRA_EMPILHADOR_RC;	

					5://ATUADOR FECHA FILME 1
						IF LA_IHM.bit_ATU_ENVOLVEDOR_AVANCAR	THEN
								LA_ENV.bit_valv_FECHA_FILME_1	:= TRUE;
						END_IF
						
						IF LA_IHM.bit_ATU_ENVOLVEDOR_RECUAR	THEN
								LA_ENV.bit_valv_FECHA_FILME_1	:= FALSE;
						END_IF
						
					//	GVL_IHM.bit_ATU_ENVOLVEDOR_AVANCADO	:= NOT sens_FECHA_FILME_1_RC;
						LA_IHM.bit_ATU_ENVOLVEDOR_RECUADO	:= sens_FECHA_FILME_1_RC;	

					 6://ATUADOR FECHA FILME 2
						IF LA_IHM.bit_ATU_ENVOLVEDOR_AVANCAR	THEN
								LA_ENV.bit_valv_FECHA_FILME_2	:= TRUE;
						END_IF
						
						IF LA_IHM.bit_ATU_ENVOLVEDOR_RECUAR	THEN
								LA_ENV.bit_valv_FECHA_FILME_2	:= FALSE;
						END_IF
						
						LA_IHM.bit_ATU_ENVOLVEDOR_AVANCADO	:= sens_FECHA_FILME_2_AV;
						LA_IHM.bit_ATU_ENVOLVEDOR_RECUADO	:= sens_FECHA_FILME_2_RC;	

					7://ATUADOR FECHA FILME 3
						IF LA_IHM.bit_ATU_ENVOLVEDOR_AVANCAR	THEN
								LA_ENV.bit_valv_FECHA_FILME_3	:= TRUE;
						END_IF
						
						IF LA_IHM.bit_ATU_ENVOLVEDOR_RECUAR	THEN
								LA_ENV.bit_valv_FECHA_FILME_3	:= FALSE;
						END_IF
						
						LA_IHM.bit_ATU_ENVOLVEDOR_AVANCADO	:= sens_FECHA_FILME_3_AV;
						LA_IHM.bit_ATU_ENVOLVEDOR_RECUADO	:= sens_FECHA_FILME_3_RC;				
		
			END_CASE	
	
	ELSE
		
		LA_IHM.int_ENVOLVEDOR_ATUADOR_SELECIONADO	:= 0;
		
		LA_IHM.bit_ATU_ENVOLVEDOR_AVANCADO			:= FALSE;
		LA_IHM.bit_ATU_ENVOLVEDOR_RECUADO			:= FALSE;	
			
		LA_IHM.bit_SELEC_ENVOLVEDOR_APROX_GARRA	:= FALSE;
		LA_IHM.bit_SELEC_ENVOLVEDOR_GARRA_DUPLA 	:= FALSE;
		LA_IHM.bit_SELEC_ENVOLVEDOR_CORTE_FILME	:= FALSE;
		LA_IHM.bit_SELEC_ENVOLVEDOR_VACUO_FILME	:= FALSE;
		LA_IHM.bit_SELEC_ENVOLVEDOR_FECHA_FILME_1	:= FALSE;
		LA_IHM.bit_SELEC_ENVOLVEDOR_FECHA_FILME_2	:= FALSE;
		LA_IHM.bit_SELEC_ENVOLVEDOR_FECHA_FILME_3	:= FALSE;

	
	END_IF
	
	
</Single>
