      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">	//CALCULOS
	//	GVL_IHM.num_CAIXAS_MEDIA		:= (GVL_MOVE.num_CAIXAS_MINUTO_MEDIA);
	//	GVL_IHM.num_CAIXAS_TOTAL		:= (GVL_MOVE.num_CAIXAS_MINUTO_TOTAL);		
	//	GVL_IHM.num_PALLETS_TOTAL		:= (GVL_MOVE.num_GERAL_PALLETS_TOTAL);

		
tmr_MINUTOS							(PT := T#60S);

LEITURA_DATA_PLC();

//================================================================================================================================================================================
//================================================================================================================================================================================
//DEFINIÇÃO DE TURNO

	//TURNO A
	IF LIM_HORA_TURNO1.IL THEN
		LA_IHM.turno_A	:=	TRUE;
		LA_IHM.turno_B	:=	FALSE;
		LA_IHM.turno_C	:=	FALSE;
	ELSE
		LA_IHM.turno_A	:=	FALSE;
	END_IF
	
	//TURNO B
	IF LIM_HORA_TURNO2.IL THEN
		LA_IHM.turno_A	:=	FALSE;
		LA_IHM.turno_B	:=	TRUE;
		LA_IHM.turno_C	:=	FALSE;
	ELSE
		LA_IHM.turno_B	:=	FALSE;
	END_IF
	
	//TURNO C
	IF NOT (LIM_HORA_TURNO3.O AND LIM_HORA_TURNO3.U) THEN
		LA_IHM.turno_A	:=	FALSE;
		LA_IHM.turno_B	:=	FALSE;
		LA_IHM.turno_C	:=	TRUE;
	ELSE
		LA_IHM.turno_C	:=	FALSE;
	END_IF
	
	//RESET TURNOS
	IF 	(LA_IHM.HORARIO_ATUAL_SEGUNDO = 57 	AND
 		LA_IHM.HORARIO_ATUAL_MINUTO = 59 		AND
		LA_IHM.HORARIO_ATUAL_HORA = 5)			OR
		teste_reset_turno			 			THEN
			LA_IHM.turno_A	:=	FALSE;
			LA_IHM.turno_B	:=	FALSE;
			LA_IHM.turno_C	:=	FALSE;
	END_IF
	


//================================================================================================================================================================================
//================================================================================================================================================================================
//CONTAGEM DO TEMPO

	//MINUTO COMPLETO
	IF LA_IHM.HORARIO_ATUAL_SEGUNDO = 59 THEN
		LA_IHM.bit_HORARIO_MINUTO_COMPLETO	:=	TRUE;
	ELSE
		LA_IHM.bit_HORARIO_MINUTO_COMPLETO	:=	FALSE;
	END_IF
	
	//HORA COMPLETA
	IF 	LA_IHM.HORARIO_ATUAL_SEGUNDO = 59 	AND
		LA_IHM.HORARIO_ATUAL_MINUTO  = 59	THEN
		LA_IHM.bit_HORARIO_HORA_COMPLETO	:=	TRUE;
	ELSE
		LA_IHM.bit_HORARIO_HORA_COMPLETO	:=	FALSE;
	END_IF
	
	//DIA COMPLETO
	IF 	LA_IHM.HORARIO_ATUAL_SEGUNDO = 57 	AND
		LA_IHM.HORARIO_ATUAL_MINUTO  = 59	AND
		LA_IHM.HORARIO_ATUAL_HORA	  = 5	OR
		teste_dia						 	THEN
		LA_IHM.bit_HORARIO_DIA_COMPLETO	:=	TRUE;
	ELSE
		LA_IHM.bit_HORARIO_DIA_COMPLETO	:=	FALSE;
	END_IF
	
	//DIA REAL COMPLETO
	IF 	LA_IHM.HORARIO_ATUAL_SEGUNDO = 58 	AND
		LA_IHM.HORARIO_ATUAL_MINUTO  = 59	AND
		LA_IHM.HORARIO_ATUAL_HORA	  = 23	THEN
		LA_IHM.bit_HORARIO_DIA_COMPLETO_REAL	:=	TRUE;
	ELSE
		LA_IHM.bit_HORARIO_DIA_COMPLETO_REAL	:=	FALSE;
	END_IF

//TIMER RETENTIVOS TURNO MAQUINA RODANDO
pvar.RTON_tmr_MAQUINA_RODANDO_T1(T_IN:= LA_IHM.turno_A AND LA_GERAL.bit_STATUS_RODANDO, T_PT:= T#999999999MS);
pvar.RTON_tmr_MAQUINA_RODANDO_T2(T_IN:= LA_IHM.turno_B AND LA_GERAL.bit_STATUS_RODANDO, T_PT:= T#999999999MS);
pvar.RTON_tmr_MAQUINA_RODANDO_T3(T_IN:= LA_IHM.turno_C AND LA_GERAL.bit_STATUS_RODANDO, T_PT:= T#999999999MS);

//TIMER RETENTIVOS TURNO MAQUINA PARADA
pvar.RTON_tmr_MAQUINA_PARADA_T1(T_IN:= LA_IHM.turno_A AND LA_GERAL.bit_STATUS_PARADA, T_PT:= T#999999999MS);
pvar.RTON_tmr_MAQUINA_PARADA_T2(T_IN:= LA_IHM.turno_B AND LA_GERAL.bit_STATUS_PARADA, T_PT:= T#999999999MS);
pvar.RTON_tmr_MAQUINA_PARADA_T3(T_IN:= LA_IHM.turno_C AND LA_GERAL.bit_STATUS_PARADA, T_PT:= T#999999999MS);

//TIMER RETENTIVOS TURNO MAQUINA OCIOSA
pvar.RTON_tmr_MAQUINA_OCIOSA_T1(T_IN:= LA_IHM.turno_A AND LA_GERAL.bit_STATUS_OCIOSA, T_PT:= T#999999999MS);
pvar.RTON_tmr_MAQUINA_OCIOSA_T2(T_IN:= LA_IHM.turno_B AND LA_GERAL.bit_STATUS_OCIOSA, T_PT:= T#999999999MS);
pvar.RTON_tmr_MAQUINA_OCIOSA_T3(T_IN:= LA_IHM.turno_C AND LA_GERAL.bit_STATUS_OCIOSA, T_PT:= T#999999999MS);

//================================================================================================================================================================================
//================================================================================================================================================================================

//--------//--------//-------//------CONTADORES------//--------------//-----------//-----------//------------//


//CONTAGEM PILHAS PESADAS OK TURNO A
pvar.cont_PILHAS_COMPLETADAS_TURNO_1(
	CU:= GVL_PESAGEM.bit_PESAGEM_ATUAL AND (LA_GERAL.bit_STATUS_RODANDO OR LA_GERAL.bit_STATUS_OCIOSA) AND LA_IHM.turno_A);
	
//CONTAGEM PILHAS PESADAS OK TURNO B
pvar.cont_PILHAS_COMPLETADAS_TURNO_2(
	CU:= GVL_PESAGEM.bit_PESAGEM_ATUAL AND (LA_GERAL.bit_STATUS_RODANDO OR LA_GERAL.bit_STATUS_OCIOSA) AND LA_IHM.turno_B);
	
//CONTAGEM PILHAS PESADAS OK TURNO C
pvar.cont_PILHAS_COMPLETADAS_TURNO_3(
	CU:= GVL_PESAGEM.bit_PESAGEM_ATUAL AND (LA_GERAL.bit_STATUS_RODANDO OR LA_GERAL.bit_STATUS_OCIOSA) AND LA_IHM.turno_C);

//CONTAGEM PILHAS REJEITADAS TURNO A
pvar.cont_PILHAS_REJEITADAS_TURNO_1(
	CU:= GVL_PESAGEM.bit_PESAGEM_ERRO AND (LA_GERAL.bit_STATUS_RODANDO OR LA_GERAL.bit_STATUS_OCIOSA) AND LA_IHM.turno_A);
	
//CONTAGEM PILHAS REJEITADAS TURNO B
pvar.cont_PILHAS_REJEITADAS_TURNO_2(
	CU:= GVL_PESAGEM.bit_PESAGEM_ERRO AND (LA_GERAL.bit_STATUS_RODANDO OR LA_GERAL.bit_STATUS_OCIOSA) AND LA_IHM.turno_B);
	
//CONTAGEM PILHAS REJEITADAS TURNO C
pvar.cont_PILHAS_REJEITADAS_TURNO_3(
	CU:= GVL_PESAGEM.bit_PESAGEM_ERRO AND (LA_GERAL.bit_STATUS_RODANDO OR LA_GERAL.bit_STATUS_OCIOSA) AND LA_IHM.turno_C);
	
//CONTAGEM PILHAS TOTAL TURNO A
pvar.cont_PILHAS_TOTAL_TURNO_1(
	CU:= (GVL_PESAGEM.bit_PESAGEM_ATUAL OR GVL_PESAGEM.bit_PESAGEM_ERRO) AND (LA_GERAL.bit_STATUS_RODANDO OR LA_GERAL.bit_STATUS_OCIOSA OR teste) AND LA_IHM.turno_A);
	
//CONTAGEM PILHAS TOTAL TURNO B
pvar.cont_PILHAS_TOTAL_TURNO_2(
	CU:= (GVL_PESAGEM.bit_PESAGEM_ATUAL OR GVL_PESAGEM.bit_PESAGEM_ERRO) AND (LA_GERAL.bit_STATUS_RODANDO OR LA_GERAL.bit_STATUS_OCIOSA) AND LA_IHM.turno_B);
	
//CONTAGEM PILHAS TOTAL TURNO C
pvar.cont_PILHAS_TOTAL_TURNO_3(
	CU:= (GVL_PESAGEM.bit_PESAGEM_ATUAL OR GVL_PESAGEM.bit_PESAGEM_ERRO) AND (LA_GERAL.bit_STATUS_RODANDO OR LA_GERAL.bit_STATUS_OCIOSA) AND LA_IHM.turno_C);
	
//--------//--------//-------//------EFICIENCIA------//--------------//-----------//-----------//------------//
//garante que não haverá erros de divisão por 0. A eficiencia só é contada a partir de quando a contagem POR TEMPO começou
	
//PORCENTAGEM DE PILHAS COMPLETADAS TURNO 1
IF PVAR.ihm_PILHAS_TOTAL_TURNO_ARRAY.PRIMEIRO[0] &gt; 0 THEN
	LA_IHM.num_PORCENTAGEM_COMPLETADAS_T1	:=	(DINT_TO_REAL(PVAR.ihm_PILHAS_COMPLETADAS_TURNO_ARRAY.PRIMEIRO[0]) / DINT_TO_REAL(PVAR.ihm_PILHAS_TOTAL_TURNO_ARRAY.PRIMEIRO[0])) * 100;
END_IF

//PORCENTAGEM DE PILHAS COMPLETADAS TURNO 2
IF PVAR.ihm_PILHAS_TOTAL_TURNO_ARRAY.SEGUNDO[0] &gt; 0 THEN
	LA_IHM.num_PORCENTAGEM_COMPLETADAS_T2	:=	(DINT_TO_REAL(PVAR.ihm_PILHAS_COMPLETADAS_TURNO_ARRAY.SEGUNDO[0]) / DINT_TO_REAL(PVAR.ihm_PILHAS_TOTAL_TURNO_ARRAY.SEGUNDO[0])) * 100;
END_IF

//PORCENTAGEM DE PILHAS COMPLETADAS TURNO 3
IF PVAR.ihm_PILHAS_TOTAL_TURNO_ARRAY.TERCEIRO[0] &gt; 0 THEN
	LA_IHM.num_PORCENTAGEM_COMPLETADAS_T3	:=	(DINT_TO_REAL(PVAR.ihm_PILHAS_COMPLETADAS_TURNO_ARRAY.TERCEIRO[0]) / DINT_TO_REAL(PVAR.ihm_PILHAS_TOTAL_TURNO_ARRAY.TERCEIRO[0])) * 100;
END_IF


//PORCENTAGEM DE PILHAS REJEITADAS TURNO 1
IF PVAR.ihm_PILHAS_TOTAL_TURNO_ARRAY.PRIMEIRO[0] &gt; 0 THEN
	LA_IHM.num_PORCENTAGEM_REJEITADAS_T1	:=	100 - LA_IHM.num_PORCENTAGEM_COMPLETADAS_T1;
END_IF

//PORCENTAGEM DE PILHAS REJEITADAS TURNO 2
IF PVAR.ihm_PILHAS_TOTAL_TURNO_ARRAY.SEGUNDO[0] &gt; 0 THEN
	LA_IHM.num_PORCENTAGEM_REJEITADAS_T2	:=	100 - LA_IHM.num_PORCENTAGEM_COMPLETADAS_T2;
END_IF

//PORCENTAGEM DE PILHAS REJEITADAS TURNO 3
IF PVAR.ihm_PILHAS_TOTAL_TURNO_ARRAY.TERCEIRO[0] &gt; 0 THEN
	LA_IHM.num_PORCENTAGEM_REJEITADAS_T3	:=	100 - LA_IHM.num_PORCENTAGEM_COMPLETADAS_T3;
END_IF


//================================================================================================================================================================================
//================================================================================================================================================================================
//RESET DE VARIÁVEIS NA TROCA DE TURNO

	IF tmr_TURNO_TROCADO.Q THEN
		pvar.RTON_tmr_MAQUINA_RODANDO_T1.Timer_reset	:=	TRUE;
		pvar.RTON_tmr_MAQUINA_RODANDO_T2.Timer_reset	:=	TRUE;
		pvar.RTON_tmr_MAQUINA_RODANDO_T3.Timer_reset	:=	TRUE;
		
		pvar.RTON_tmr_MAQUINA_PARADA_T1.Timer_reset	:=	TRUE;
		pvar.RTON_tmr_MAQUINA_PARADA_T2.Timer_reset	:=	TRUE;
		pvar.RTON_tmr_MAQUINA_PARADA_T3.Timer_reset	:=	TRUE;
		
		pvar.RTON_tmr_MAQUINA_OCIOSA_T1.Timer_reset	:=	TRUE;
		pvar.RTON_tmr_MAQUINA_OCIOSA_T2.Timer_reset	:=	TRUE;
		pvar.RTON_tmr_MAQUINA_OCIOSA_T3.Timer_reset	:=	TRUE;
		
		PVAR.cont_PILHAS_COMPLETADAS_TURNO_1.RESET	:=	TRUE;
		PVAR.cont_PILHAS_COMPLETADAS_TURNO_2.RESET	:=	TRUE;
		PVAR.cont_PILHAS_COMPLETADAS_TURNO_3.RESET	:=	TRUE;
		
		PVAR.cont_PILHAS_REJEITADAS_TURNO_1.RESET	:=	TRUE;
		PVAR.cont_PILHAS_REJEITADAS_TURNO_2.RESET	:=	TRUE;
		PVAR.cont_PILHAS_REJEITADAS_TURNO_3.RESET	:=	TRUE;
		
		PVAR.cont_PILHAS_TOTAL_TURNO_1.RESET		:=	TRUE;
		PVAR.cont_PILHAS_TOTAL_TURNO_2.RESET		:=	TRUE;
		PVAR.cont_PILHAS_TOTAL_TURNO_3.RESET		:=	TRUE;
		
		LA_GERAL.bit_TURNO_TROCADO				:= FALSE;
	ELSE
		pvar.RTON_tmr_MAQUINA_RODANDO_T1.Timer_reset	:=	FALSE;
		pvar.RTON_tmr_MAQUINA_RODANDO_T2.Timer_reset	:=	FALSE;
		pvar.RTON_tmr_MAQUINA_RODANDO_T3.Timer_reset	:=	FALSE;
		
		pvar.RTON_tmr_MAQUINA_PARADA_T1.Timer_reset	:=	FALSE;
		pvar.RTON_tmr_MAQUINA_PARADA_T2.Timer_reset	:=	FALSE;
		pvar.RTON_tmr_MAQUINA_PARADA_T3.Timer_reset	:=	FALSE;
		
		pvar.RTON_tmr_MAQUINA_OCIOSA_T1.Timer_reset	:=	FALSE;
		pvar.RTON_tmr_MAQUINA_OCIOSA_T2.Timer_reset	:=	FALSE;
		pvar.RTON_tmr_MAQUINA_OCIOSA_T3.Timer_reset	:=	FALSE;
		
		PVAR.cont_PILHAS_COMPLETADAS_TURNO_1.RESET	:=	FALSE;
		PVAR.cont_PILHAS_COMPLETADAS_TURNO_2.RESET	:=	FALSE;
		PVAR.cont_PILHAS_COMPLETADAS_TURNO_3.RESET	:=	FALSE;
		
		PVAR.cont_PILHAS_REJEITADAS_TURNO_1.RESET	:=	FALSE;
		PVAR.cont_PILHAS_REJEITADAS_TURNO_2.RESET	:=	FALSE;
		PVAR.cont_PILHAS_REJEITADAS_TURNO_3.RESET	:=	FALSE;
		
		PVAR.cont_PILHAS_TOTAL_TURNO_1.RESET		:=	FALSE;
		PVAR.cont_PILHAS_TOTAL_TURNO_2.RESET		:=	FALSE;
		PVAR.cont_PILHAS_TOTAL_TURNO_3.RESET		:=	FALSE;
		
	END_IF
	
//RESETAR MANUALMENTE CONTADORES DO TURNO A
	IF LA_IHM.bit_CONTADORES_RESET	AND LA_IHM.turno_A THEN
		pvar.RTON_tmr_MAQUINA_RODANDO_T1.Timer_reset	:=	TRUE;
		pvar.RTON_tmr_MAQUINA_PARADA_T1.Timer_reset		:=	TRUE;
		pvar.RTON_tmr_MAQUINA_OCIOSA_T1.Timer_reset		:=	TRUE;
		PVAR.cont_PILHAS_COMPLETADAS_TURNO_1.RESET		:=	TRUE;
		PVAR.cont_PILHAS_REJEITADAS_TURNO_1.RESET		:=	TRUE;
		PVAR.cont_PILHAS_TOTAL_TURNO_1.RESET			:=	TRUE;
	END_IF
	
//RESETAR MANUALMENTE CONTADORES DO TURNO B
	IF LA_IHM.bit_CONTADORES_RESET	AND LA_IHM.turno_B THEN
		pvar.RTON_tmr_MAQUINA_RODANDO_T2.Timer_reset	:=	TRUE;
		pvar.RTON_tmr_MAQUINA_PARADA_T2.Timer_reset		:=	TRUE;
		pvar.RTON_tmr_MAQUINA_OCIOSA_T2.Timer_reset		:=	TRUE;
		PVAR.cont_PILHAS_COMPLETADAS_TURNO_2.RESET		:=	TRUE;
		PVAR.cont_PILHAS_REJEITADAS_TURNO_2.RESET		:=	TRUE;
		PVAR.cont_PILHAS_TOTAL_TURNO_2.RESET			:=	TRUE;
	END_IF
	
//RESETAR MANUALMENTE CONTADORES DO TURNO C
	IF LA_IHM.bit_CONTADORES_RESET	AND LA_IHM.turno_C THEN
		pvar.RTON_tmr_MAQUINA_RODANDO_T3.Timer_reset	:=	TRUE;
		pvar.RTON_tmr_MAQUINA_PARADA_T3.Timer_reset		:=	TRUE;
		pvar.RTON_tmr_MAQUINA_OCIOSA_T3.Timer_reset		:=	TRUE;
		PVAR.cont_PILHAS_COMPLETADAS_TURNO_3.RESET		:=	TRUE;
		PVAR.cont_PILHAS_REJEITADAS_TURNO_3.RESET		:=	TRUE;
		PVAR.cont_PILHAS_TOTAL_TURNO_3.RESET			:=	TRUE;
	END_IF


//RESETAR CONTADORES DOS TURNOS 05:59:55
	IF 	(LA_IHM.HORARIO_ATUAL_HORA 	 = 5	AND
		LA_IHM.HORARIO_ATUAL_MINUTO = 59		AND
		LA_IHM.HORARIO_ATUAL_SEGUNDO = 55)		OR
		teste_reset_cont_turnoa					THEN
			LA_GERAL.bit_TURNO_TROCADO	:= TRUE;
	END_IF

tmr_TURNO_TROCADO		(IN := LA_GERAL.bit_TURNO_TROCADO,  PT := T#4S);


//LIMITE DE HORÁRIOS DOS TURNOS
LIM_HORA_TURNO1(IN:= LA_IHM.HORARIO_ATUAL_HORA, HIGH:= 13, LOW:= 6);
LIM_HORA_TURNO2(IN:= LA_IHM.HORARIO_ATUAL_HORA, HIGH:= 21, LOW:= 14);
LIM_HORA_TURNO3(IN:= LA_IHM.HORARIO_ATUAL_HORA, HIGH:= 5, LOW:= 22);

E06_HISTORICO();
E07_HISTORICO_ESPELHAMENTO();</Single>
            <Single Name="LineInfoPersistence" Type="string">6a36902c-7c45-4e5f-b627-d9d02b57c9d9_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM E05_CONTADORES
VAR
	tmr_MINUTOS		: TON;
	tmr_TURNO_TROCADO : TON;
	LIM_HORA_TURNO1				: LIMITALARM;
	LIM_HORA_TURNO2				: LIMITALARM;
	LIM_HORA_TURNO3				: LIMITALARM;
	
	teste_dia					: BOOL;
	teste_reset_turno			: BOOL;
	teste_reset_cont_turnoa		: BOOL;
	
	tmr_TEMPO_RODANDO_T1		: DINT;
	tmr_TEMPO_TOTAL_T1			: LREAL;
	tmr_TEMPO_RODANDO_T2		: DINT;
	tmr_TEMPO_TOTAL_T2			: LREAL;
	tmr_TEMPO_RODANDO_T3		: DINT;
	tmr_TEMPO_TOTAL_T3			: LREAL;
	
	teste: BOOL;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">6a36902c-7c45-4e5f-b627-d9d02b57c9d9_Decl_LineIds</Single>
          </Single>
