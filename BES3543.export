            <Single Name="TextBlobForSerialisation" Type="string">{attribute 'qualified_only'}
VAR_GLOBAL

	//BITS DE COMANDOS
	bit_ENVOLVEDOR_SACOLA_POSICIONADA		: BOOL;
	bit_ENVOLVEDOR_SACOLA_DEPOSITANDO		: BOOL;
	bit_ENVOLVEDOR_SACOLA_DEPOSITADA		: BOOL;
	
	bit_ENVOLVEDOR_ENVIANDO_PILHA			: BOOL;
	
	
	bit_EST_ENTRADA_CHEIA					: BOOL;

	

	//ATUADORES
	bit_valv_APROX_GARRA			: BOOL;
	bit_valv_GARRA_DUPLA			: BOOL;
	bit_valv_CORTE_FILME			: BOOL;
	bit_valv_VACUO_FILME			: BOOL;
	bit_ENV_CORTE_FILME			: BOOL;
	bit_valv_FECHA_FILME_1			: BOOL;
	bit_valv_FECHA_FILME_2			: BOOL;
	bit_valv_FECHA_FILME_3			: BOOL;
	
	//ESTEIRAS
	est_ENTRADA_ENVOLVEDOR			: BOOL;
	est_TRANSPORTADOR_ENVOLVEDOR	: BOOL;
	est_SAIDA_ENVOLVEDOR			: BOOL;


	//BITS DE EIXOS
	bit_EIXO_Z_ENVOLVEDOR_FAZER_HOME			: BOOL;
	bit_EIXO_Z_ENVOLVEDOR_POSICIONADO			: BOOL;
	
	bit_EIXO_X_ENVOLVEDOR_FAZER_HOME			: BOOL;
	bit_EIXO_X_ENVOLVEDOR_POSICIONADO			: BOOL;

	bit_EIXO_GIRO_ENVOLVEDOR_LD_FAZER_HOME		: BOOL;
	bit_EIXO_GIRO_ENVOLVEDOR_LD_POSICIONADO		: BOOL;
	
	bit_EIXO_GIRO_ENVOLVEDOR_LE_FAZER_HOME		: BOOL;
	bit_EIXO_GIRO_ENVOLVEDOR_LE_POSICIONADO		: BOOL;
	
	
	
	bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS				: BOOL;
	bit_EIXO_Z_ENVOLVEDOR_MOVER_REL				: BOOL;
	
	bit_EIXO_X_ENVOLVEDOR_MOVER_ABS				: BOOL;
	bit_EIXO_X_ENVOLVEDOR_MOVER_REL				: BOOL;
	
	bit_EIXO_GIRO_ENVOLVEDOR_LD_MOVER_ABS		: BOOL;
	bit_EIXO_GIRO_ENVOLVEDOR_LD_MOVER_REL		: BOOL;
	
	bit_EIXO_GIRO_ENVOLVEDOR_LE_MOVER_ABS		: BOOL;
	bit_EIXO_GIRO_ENVOLVEDOR_LE_MOVER_REL		: BOOL;
	
	
	bit_MOTOR_Z_ENVOLVEDOR_JOG_FORWARD			: BOOL;
	bit_MOTOR_Z_ENVOLVEDOR_JOG_REVERSE			: BOOL;
	bit_MOTOR_Z_ENVOLVEDOR_JOG_STOP				: BOOL;
	
	bit_MOTOR_X_ENVOLVEDOR_JOG_FORWARD			: BOOL;
	bit_MOTOR_X_ENVOLVEDOR_JOG_REVERSE			: BOOL;
	bit_MOTOR_X_ENVOLVEDOR_JOG_STOP				: BOOL;
	
	bit_MOTOR_GIRO_ENVOLVEDOR_LD_JOG_FORWARD	: BOOL;
	bit_MOTOR_GIRO_ENVOLVEDOR_LD_JOG_REVERSE	: BOOL;
	bit_MOTOR_GIRO_ENVOLVEDOR_LD_JOG_STOP		: BOOL;
	
	bit_MOTOR_GIRO_ENVOLVEDOR_LE_JOG_FORWARD	: BOOL;
	bit_MOTOR_GIRO_ENVOLVEDOR_LE_JOG_REVERSE	: BOOL;
	bit_MOTOR_GIRO_ENVOLVEDOR_LE_JOG_STOP		: BOOL;
	
	info_MOTOR_GIRO_ENVOLVIMENTO_LD_POS_ATUAL	: LREAL;
	info_MOTOR_GIRO_ENVOLVIMENTO_LE_POS_ATUAL	: LREAL;
	
	info_MOTOR_Z_ENVOLVEDOR_POS_ATUAL			: LREAL;
	info_MOTOR_X_ENVOLVEDOR_POS_ATUAL			: LREAL;

	
	
//	ENTRADAS	============//============//============//============//============//============//============

	
	//E-16DIO - SLOT 3 (RMT50003)	
		di_SENS_EST_TRANS_PRESENCA			: BOOL;
		di_SENS_POS_2_ENVOLVEDOR			: BOOL;
		di_SENS_CORTE_FILME_RC				: BOOL;
		di_feedback_ERRO_ENTRADA_ENVOLVEDOR : BOOL;
		di_SENS_POS_1_ENVOLVEDOR			: BOOL;
		di_SENS_FILME_ENVOLVEDOR			: BOOL;
		di_SENS_CORTE_FILME_AV				: BOOL;
	
	//E-16DIO - SLOT 4 (RMT50004)		
		di_SENS_SAIDA_ENVOLVEDOR_1			: BOOL;
		di_SENS_SAIDA_ENVOLVEDOR_3			: BOOL;
		di_SENS_FECHA_FILME_1_RC			: BOOL;
		di_SENS_FECHA_FILME_2_RC			: BOOL;
		di_SENS_FECHA_FILME_3_RC			: BOOL;
		di_feedback_ERRO_TRANSP_SAIDA_1		: BOOL;
		di_SENS_SAIDA_ENVOLVEDOR_2			: BOOL;
		di_SENS_SAIDA_ENVOLVEDOR_4			: BOOL;
		di_SENS_FECHA_FILME_2_AV			: BOOL;
		di_SENS_FECHA_FILME_3_AV			: BOOL;

		
		
//	SAIDAS		============//============//============//============//============//============//============

	//E-16DIO - SLOT 3 (RMT50003)	
		do_EST_TRANS_ENVOLVEDOR_DI2		: BOOL;
		do_EST_TRANS_ENVOLVEDOR_DI3		: BOOL;
		do_VALV_CORTE_FILME				: BOOL;
		do_SPEED_A_ENTRADA_ENVOLVEDOR	: BOOL;
		do_EST_TRANS_ENVOLVEDOR_DI1		: BOOL;
		do_EST_TRANS_ENVOLVEDOR_DO1		: BOOL;
