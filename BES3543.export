      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">//Espelhamento de Variaveis
	
	LA_GERAL.bit_MAQUINA_MANUAL		:= LA_IHM.bit_MAQUINA_MANUAL;
	
	LA_IHM.array_HIST_ERRO_PESAGEM_1	:=	GVL_PESAGEM.array_HIST_PESO.0;
	LA_IHM.array_HIST_ERRO_PESAGEM_2	:=	GVL_PESAGEM.array_HIST_PESO.1;
	LA_IHM.array_HIST_ERRO_PESAGEM_3	:=	GVL_PESAGEM.array_HIST_PESO.2;
	LA_IHM.array_HIST_ERRO_PESAGEM_4	:=	GVL_PESAGEM.array_HIST_PESO.3;
	LA_IHM.array_HIST_ERRO_PESAGEM_5	:=	GVL_PESAGEM.array_HIST_PESO.4;
	LA_IHM.array_HIST_ERRO_PESAGEM_6	:=	GVL_PESAGEM.array_HIST_PESO.5;
	LA_IHM.array_HIST_ERRO_PESAGEM_7	:=	GVL_PESAGEM.array_HIST_PESO.6;



	//MOTOR EIXO X EMPILHAMENTO
	IF	M0_LA_EMP_X.bit_POWER_ERRO		OR
		M0_LA_EMP_X.bit_HOME_ERRO			OR
		M0_LA_EMP_X.bit_MOVE_ABS_ERRO		OR
		M0_LA_EMP_X.bit_MOVE_REL_ERRO		OR
		EIXO_X_EMPILHADOR.bError						THEN
			LA_IHM.bit_EIXO_X_EMPILHADOR_ALARME_ATIVO	:= TRUE;
	ELSE
			LA_IHM.bit_EIXO_X_EMPILHADOR_ALARME_ATIVO	:= FALSE;	
	END_IF


	//MOTOR PEGA SACOLA
	IF	M1_LA_EMP_GARRA.bit_POWER_ERRO			OR
		M1_LA_EMP_GARRA.bit_HOME_ERRO			OR
		M1_LA_EMP_GARRA.bit_MOVE_ABS_ERRO		OR
		M1_LA_EMP_GARRA.bit_MOVE_REL_ERRO		OR
		EIXO_GARRA_EMPILHADOR.bError					THEN
			LA_IHM.bit_EIXO_GARRA_EMPILHADOR_ALARME_ATIVO	:= TRUE;
	ELSE
			LA_IHM.bit_EIXO_GARRA_EMPILHADOR_ALARME_ATIVO	:= FALSE;	
	END_IF
	
	
	//MOTOR MESA GIRO
	IF	M2_LA_EMP_GIRO.bit_POWER_ERRO			OR
		M2_LA_EMP_GIRO.bit_HOME_ERRO				OR
		M2_LA_EMP_GIRO.bit_MOVE_ABS_ERRO			OR
		M2_LA_EMP_GIRO.bit_MOVE_REL_ERRO			OR
		EIXO_GIRO_MESA.bError					THEN
			LA_IHM.bit_EIXO_GIRO_MESA_ALARME_ATIVO	:= TRUE;
	ELSE
			LA_IHM.bit_EIXO_GIRO_MESA_ALARME_ATIVO	:= FALSE;	
	END_IF
	
	
	//MOTOR EIXO Z ENVOLVEDOR
	IF	M3_LA_ENV_Z.bit_POWER_ERRO			OR
		M3_LA_ENV_Z.bit_HOME_ERRO				OR
		M3_LA_ENV_Z.bit_MOVE_ABS_ERRO			OR
		M3_LA_ENV_Z.bit_MOVE_REL_ERRO			OR
		EIXO_Z_ENVOLVEDOR.bError							THEN
			LA_IHM.bit_EIXO_Z_ENVOLVEDOR_ALARME_ATIVO	:= TRUE;
	ELSE
			LA_IHM.bit_EIXO_Z_ENVOLVEDOR_ALARME_ATIVO	:= FALSE;	
	END_IF
	
	
	//MOTOR EIXO X ENVOLVEDOR
	IF	M4_LA_ENV_X.bit_POWER_ERRO			OR
		M4_LA_ENV_X.bit_HOME_ERRO				OR
		M4_LA_ENV_X.bit_MOVE_ABS_ERRO			OR
		M4_LA_ENV_X.bit_MOVE_REL_ERRO			OR
		EIXO_X_ENVOLVEDOR.bError							THEN
			LA_IHM.bit_EIXO_X_ENVOLVEDOR_ALARME_ATIVO	:= TRUE;
	ELSE
			LA_IHM.bit_EIXO_X_ENVOLVEDOR_ALARME_ATIVO	:= FALSE;	
	END_IF
	
	
		//MOTOR GIRO ENVOLVEDOR LD
	IF	M5_LA_ENV_GIRO_LD.bit_POWER_ERRO			OR
		M5_LA_ENV_GIRO_LD.bit_HOME_ERRO			OR
		M5_LA_ENV_GIRO_LD.bit_MOVE_ABS_ERRO		OR
		M5_LA_ENV_GIRO_LD.bit_MOVE_REL_ERRO		OR
		EIXO_GIRO_ENVOLVEDOR_LD.bError								THEN
			LA_IHM.bit_EIXO_GIRO_ENVOLVEDOR_LD_ALARME_ATIVO	:= TRUE;
	ELSE
			LA_IHM.bit_EIXO_GIRO_ENVOLVEDOR_LD_ALARME_ATIVO	:= FALSE;	
	END_IF
	
		//MOTOR GIRO ENVOLVEDOR LE
	IF	M6_LA_ENV_GIRO_LE.bit_POWER_ERRO			OR
		M6_LA_ENV_GIRO_LE.bit_HOME_ERRO			OR
		M6_LA_ENV_GIRO_LE.bit_MOVE_ABS_ERRO		OR
		M6_LA_ENV_GIRO_LE.bit_MOVE_REL_ERRO		OR
		EIXO_GIRO_ENVOLVEDOR_LE.bError								THEN
			LA_IHM.bit_EIXO_GIRO_ENVOLVEDOR_LE_ALARME_ATIVO	:= TRUE;
	ELSE
			LA_IHM.bit_EIXO_GIRO_ENVOLVEDOR_LE_ALARME_ATIVO	:= FALSE;	
	END_IF
	
	
//HABILITADO
	LA_IHM.bit_EIXO_X_EMPILHADOR_HABILITADO			:= EIXO_X_EMPILHADOR.bDriveStartRealState;
	LA_IHM.bit_EIXO_GARRA_EMPILHADOR_HABILITADO		:= EIXO_GARRA_EMPILHADOR.bDriveStartRealState;
	LA_IHM.bit_EIXO_GIRO_MESA_HABILITADO				:= EIXO_GIRO_MESA.bDriveStartRealState;
	LA_IHM.bit_EIXO_Z_ENVOLVEDOR_HABILITADO			:= EIXO_Z_ENVOLVEDOR.bDriveStartRealState;
	LA_IHM.bit_EIXO_X_ENVOLVEDOR_HABILITADO			:= EIXO_X_ENVOLVEDOR.bDriveStartRealState;
	LA_IHM.bit_EIXO_GIRO_ENVOLVEDOR_LD_HABILITADO		:= EIXO_GIRO_ENVOLVEDOR_LD.bDriveStartRealState;
	LA_IHM.bit_EIXO_GIRO_ENVOLVEDOR_LE_HABILITADO		:= EIXO_GIRO_ENVOLVEDOR_LD.bDriveStartRealState;
	
//FAZENDO HOME
	LA_IHM.bit_EIXO_X_EMPILHADOR_FAZENDO_HOME			:= M0_LA_EMP_X.bit_HOME_FAZENDO;
	LA_IHM.bit_EIXO_GARRA_EMPILHADOR_FAZENDO_HOME		:= M1_LA_EMP_GARRA.bit_HOME_FAZENDO;
	LA_IHM.bit_EIXO_GIRO_MESA_FAZENDO_HOME				:= M2_LA_EMP_GIRO.bit_HOME_FAZENDO;
	LA_IHM.bit_EIXO_Z_ENVOLVEDOR_FAZENDO_HOME			:= M3_LA_ENV_Z.bit_HOME_FAZENDO;
	LA_IHM.bit_EIXO_X_ENVOLVEDOR_FAZENDO_HOME			:= M4_LA_ENV_X.bit_HOME_FAZENDO;
	LA_IHM.bit_EIXO_GIRO_ENVOLVEDOR_LD_FAZENDO_HOME	:= M5_LA_ENV_GIRO_LD.bit_HOME_FAZENDO;
	LA_IHM.bit_EIXO_GIRO_ENVOLVEDOR_LE_FAZENDO_HOME	:= M6_LA_ENV_GIRO_LE.bit_HOME_FAZENDO;
	
//POSIÇÃO ATUAL IHM
	LA_IHM.info_MANI_POS_ATUAL_X_EMPILHADOR		:=	LA_EMP.info_MOTOR_EIXO_X_EMPILHADOR_POS_ATUAL;
	LA_IHM.info_MANI_POS_ATUAL_GARRA_EMPILHADOR	:=	LA_EMP.info_MOTOR_GARRA_EMPILHADOR_POS_ATUAL;
	LA_IHM.info_MANI_POS_ATUAL_GIRO_MESA			:=	LA_EMP.info_MOTOR_GIRO_MESA_POS_ATUAL;
	LA_IHM.info_MANI_POS_ATUAL_Z_ENVOLVEDOR		:=	LA_ENV.info_MOTOR_Z_ENVOLVEDOR_POS_ATUAL;
	LA_IHM.info_MANI_POS_ATUAL_X_ENVOLVEDOR		:=	LA_ENV.info_MOTOR_X_ENVOLVEDOR_POS_ATUAL; 
	LA_IHM.info_POS_ATUAL_GIRO_EMPILHADOR_LD		:=	LA_ENV.info_MOTOR_GIRO_ENVOLVIMENTO_LD_POS_ATUAL;
	LA_IHM.info_POS_ATUAL_GIRO_EMPILHADOR_LE		:=	LA_ENV.info_MOTOR_GIRO_ENVOLVIMENTO_LE_POS_ATUAL;
	
//ALARMES ESTEIRAS
	LA_IHM.bit_feedback_ERRO_MESA_GIRO				:=	LA_EMP.di_feedback_ERRO_MESA_GIRO;
	LA_IHM.bit_feedback_ERRO_EST_INSPECAO			:=	LA_EMP.di_feedback_ERRO_EST_INSPECAO;
	LA_IHM.bit_feedback_ERRO_ENTRADA_ENVOLVEDOR	:=	feedback_ERRO_ENTRADA_ENVOLVEDOR;
	LA_IHM.bit_feedback_ERRO_TRANSP_SAIDA_1		:=	feedback_ERRO_TRANSP_SAIDA_1;
	LA_IHM.bit_feedback_ERRO_MESA_TRANSFER			:=	feedback_ERRO_MESA_TRANSFER;
	LA_IHM.bit_feedback_ERRO_REJEITO_PRODUTO		:=	feedback_ERRO_REJEITO_PRODUTO;
	LA_IHM.bit_feedback_ERRO_ESTAGIO_1				:=	feedback_ERRO_ESTAGIO_1;
	LA_IHM.bit_feedback_ERRO_MERGER_1				:=	feedback_ERRO_MERGER_1;
	
	
	
	//MÁQUINA MANUAL
IF LA_GERAL.bit_MAQUINA_MANUAL AND NOT LA_GERAL.bit_MAQUINA_PRONTA THEN

	//COMANDO DE JOG MANUAIS DOS EIXOS	
		LA_EMP.bit_EIXO_X_EMPILHADOR_JOG_FORWARD 	:=	LA_IHM.bit_EIXO_X_EMPILHADOR_JOG_POSITIVO;
		LA_EMP.bit_EIXO_X_EMPILHADOR_JOG_REVERSE 	:=	LA_IHM.bit_EIXO_X_EMPILHADOR_JOG_NEGATIVO;	
	
		LA_EMP.bit_GARRA_EMPILHADOR_JOG_FORWARD 	:=	LA_IHM.bit_EIXO_GARRA_EMPILHADOR_JOG_POSITIVO;
		LA_EMP.bit_GARRA_EMPILHADOR_JOG_REVERSE 	:=	LA_IHM.bit_EIXO_GARRA_EMPILHADOR_JOG_NEGATIVO;
		
		LA_EMP.bit_GIRO_MESA_JOG_FORWARD 			:=	LA_IHM.bit_EIXO_GIRO_MESA_JOG_POSITIVO;
		LA_EMP.bit_GIRO_MESA_JOG_REVERSE 			:=	LA_IHM.bit_EIXO_GIRO_MESA_JOG_NEGATIVO;
		
		LA_ENV.bit_MOTOR_Z_ENVOLVEDOR_JOG_FORWARD 	:=	LA_IHM.bit_EIXO_Z_ENVOLVEDOR_JOG_POSITIVO;
		LA_ENV.bit_MOTOR_Z_ENVOLVEDOR_JOG_REVERSE 	:=	LA_IHM.bit_EIXO_Z_ENVOLVEDOR_JOG_NEGATIVO;
		
		LA_ENV.bit_MOTOR_X_ENVOLVEDOR_JOG_FORWARD 	:=	LA_IHM.bit_EIXO_X_ENVOLVEDOR_JOG_POSITIVO;
		LA_ENV.bit_MOTOR_X_ENVOLVEDOR_JOG_REVERSE 	:=	LA_IHM.bit_EIXO_X_ENVOLVEDOR_JOG_NEGATIVO;
		
		LA_ENV.bit_MOTOR_GIRO_ENVOLVEDOR_LD_JOG_FORWARD 	:=	LA_IHM.bit_EIXO_GIRO_ENVOLVEDOR_LD_JOG_POSITIVO;
		LA_ENV.bit_MOTOR_GIRO_ENVOLVEDOR_LD_JOG_REVERSE 	:=	LA_IHM.bit_EIXO_GIRO_ENVOLVEDOR_LD_JOG_NEGATIVO;
		
		LA_ENV.bit_MOTOR_GIRO_ENVOLVEDOR_LE_JOG_FORWARD 	:=	LA_IHM.bit_EIXO_GIRO_ENVOLVEDOR_LE_JOG_POSITIVO;
		LA_ENV.bit_MOTOR_GIRO_ENVOLVEDOR_LE_JOG_REVERSE 	:=	LA_IHM.bit_EIXO_GIRO_ENVOLVEDOR_LE_JOG_NEGATIVO;
		
		
END_IF</Single>
