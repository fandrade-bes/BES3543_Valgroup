      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">//MOVE O PASSO PARA O HOME

	IF	LA_IHM.bit_bt_RESET_INSPECAO	THEN
			passo_INSPECAO								:= 9;
	END_IF
	
CASE	passo_INSPECAO	OF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
09: //HOME: Reseta variáveis

	IF NOT LA_EMP.di_SENS_EST_INSPEC_PRODUTO_1 AND NOT LA_EMP.di_SENS_EST_INSPEC_PRODUTO_2 THEN
		LA_EMP.bit_OPERADOR_INSPECAO_OK		:=	FALSE;
		LA_EMP.bit_EST_ENVIAR_PILHA_INSPECAO	:=	FALSE;
		LA_EMP.bit_EST_INSPECAO_ENTREGUE_2	:=	FALSE;
		LA_EMP.est_INSPECAO_EMPILHADOR		:= 	FALSE;
		tmr_LIBERA_INSPECAO_OK.IN						:=	FALSE;
		bt_LAMP_INSPECAO_OK 							:=  FALSE;
		passo_INSPECAO									:=  999;
	ELSIF LA_EMP.bit_OPERADOR_INSPECAO_OK THEN
		passo_INSPECAO									:= 1002;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
999://aguarda esteira da mesa giro entregar pilha para inspeção e liga esteira

	IF LA_EMP.bit_LIBERA_INSPECAO_PILHA	THEN
		LA_EMP.est_INSPECAO_EMPILHADOR	:= TRUE;
		passo_INSPECAO								:= 1000;
	END_IF
	
	IF LA_EMP.bit_OPERADOR_INSPECAO_OK THEN
		LA_EMP.bit_STATUS_INSPECAO_1		:= FALSE;
		passo_INSPECAO								:= 1002;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1000://espera feedback dos sensores da esteira de inspeção para garantir que a pilha chegou até o fim. 

	IF  LA_EMP.di_SENS_EST_INSPEC_PRODUTO_2 THEN
		LA_EMP.est_INSPECAO_EMPILHADOR		:= FALSE;
		LA_EMP.bit_STATUS_INSPECAO_1			:= TRUE;
		//GVL_EMPILHAMENTO.bit_EST_INSPECAO_ENTREGUE_1	:= TRUE;
		
		passo_INSPECAO									:= 999;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1001://aguarda comando de operador indicando que a pilha está ok para ser devolvida

	IF LA_EMP.bit_OPERADOR_INSPECAO_OK THEN
		LA_EMP.bit_STATUS_INSPECAO_1	:= FALSE;
		passo_INSPECAO							:= 1002;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1002://espera confirmação de recebimento OK da esteira mesa giro e liga esteira de inspeção reverse para devolução de pilha 

	IF LA_EMP.bit_EST_ENVIAR_PILHA_INSPECAO THEN
		LA_EMP.est_INSPECAO_EMPILHADOR_REVERSE 	:= TRUE;
		LA_EMP.est_INSPECAO_EMPILHADOR			:= TRUE;
		passo_INSPECAO										:= 1003;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1003://ao deixar de receber feedback dos dois sensores da esteira de inspeção, para esteira e reinicia ciclo

	IF NOT LA_EMP.di_SENS_EST_INSPEC_PRODUTO_1 AND NOT LA_EMP.di_SENS_EST_INSPEC_PRODUTO_2 THEN
		tmr_LIBERA_INSPECAO_OK.IN							:= TRUE;
	ELSE
		tmr_LIBERA_INSPECAO_OK.IN							:= FALSE;
	END_IF
	
	IF tmr_LIBERA_INSPECAO_OK.Q	THEN
		passo_INSPECAO										:= 1004;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1004:
		LA_EMP.est_INSPECAO_EMPILHADOR_REVERSE	:= FALSE;
		LA_EMP.est_INSPECAO_EMPILHADOR			:= FALSE;
		tmr_LIBERA_INSPECAO_OK.IN							:= FALSE;
		LA_EMP.bit_EST_INSPECAO_ENTREGUE_2		:= TRUE;
		passo_INSPECAO										:= 999;

END_CASE




//------------LÓGICAS ADICIONAIS-------------------//--------------------------------------//---------------------------------

	//LIBERAÇÃO DE PILHA DE INSPEÇÃO COMO OK AO DETECTAR PILHA NOS SENSORES DA ESTEIRA DE INSPEÇÃO
	IF tmr_INSPECAO_OK.Q AND (LA_EMP.di_SENS_EST_INSPEC_PRODUTO_2)	THEN
		LA_EMP.bit_OPERADOR_INSPECAO_OK	:=	TRUE;
	END_IF

	IF NOT LA_EMP.bit_STATUS_INSPECAO_1 AND NOT LA_EMP.bit_OPERADOR_INSPECAO_OK THEN
		LA_IHM.bit_STATUS_INSPECAO_OK	:=	0;
	ELSIF LA_EMP.bit_STATUS_INSPECAO_1 AND NOT LA_EMP.bit_OPERADOR_INSPECAO_OK THEN
		LA_IHM.bit_STATUS_INSPECAO_OK	:=	1;
	ELSIF LA_EMP.bit_OPERADOR_INSPECAO_OK	THEN
		LA_IHM.bit_STATUS_INSPECAO_OK	:=	2;
	END_IF

//TIMERS
tmr_INSPECAO_OK(IN:= bt_INSPECAO_OK OR LA_IHM.bit_bt_INSPECAO_OK, PT:= T#2S );
tmr_LIBERA_INSPECAO_OK(PT:= T#2S );</Single>
