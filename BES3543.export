	coord_X_ENVOLVEDOR_CORTE			: EIXO_MOVER;
	coord_X_ENVOLVEDOR_ENTREGA			: EIXO_MOVER;
	
	//EIXO Z ENVOLVEDOR
	coord_Z_ENVOLVEDOR_PRE_PEGA			: EIXO_MOVER;
