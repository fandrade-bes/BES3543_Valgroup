            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639240307162396523</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">	IF LA_IHM.bit_GIRO_SACOLA_RESET THEN
		passo_GIRO_SACOLA	:=	9;
	END_IF
	
CASE passo_GIRO_SACOLA OF
	

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
09: //HOME: Reseta variáveis
	
	LA_ENV.bit_EIXO_Z_ENVOLVEDOR_FAZER_HOME			:= FALSE;
	LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS			:= FALSE;
	M3_LA_ENV_Z.bit_FAZER_HOME				:= FALSE;
	
	LA_ENV.bit_EIXO_X_ENVOLVEDOR_FAZER_HOME			:= FALSE;
	LA_ENV.bit_EIXO_X_ENVOLVEDOR_MOVER_ABS			:= FALSE;
	M4_LA_ENV_X.bit_FAZER_HOME				:= FALSE;
	
	LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LD_FAZER_HOME	:= FALSE;
	LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LD_MOVER_ABS	:= FALSE;
	
	LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LE_FAZER_HOME	:= FALSE;
	LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LE_MOVER_ABS	:= FALSE;
	
	bit_ENTREGA_X_FEITO			:= FALSE;
	bit_ENTREGA_GIRO_LD_FEITO	:= FALSE;
	bit_ENTREGA_GIRO_LE_FEITO	:= FALSE;
	
	LA_ENV.bit_ENV_CORTE_FILME	:= FALSE;
	LA_ENV.bit_valv_VACUO_FILME	:=	TRUE;
	
	
	LA_ENV.bit_ENVOLVEDOR_SACOLA_DEPOSITANDO		:=	FALSE;
	
	tmr_PASSO_1028.IN					:=	FALSE;
	tmr_PASSO_1029.IN					:=	FALSE;
	
	passo_GIRO_SACOLA						:= 10;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
10: //HOME: Se a máquina estiver rodando e não estiver em modo manual, começa o processo de Home
	
	IF LA_GERAL.bit_MAQUINA_PRONTA  THEN
			LA_ENV.bit_valv_GARRA_DUPLA		:=	FALSE;
		
			passo_GIRO_SACOLA	:= 11;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
11: //HOME: Inicia o Home no eixo Z do Envolvedor
	
	LA_ENV.bit_EIXO_Z_ENVOLVEDOR_FAZER_HOME		:= TRUE;

	passo_GIRO_SACOLA									:= 13;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
13: //HOME: Verifica se está se movendo para o Home do Eixo Z do Envolvedor
	
	IF M3_LA_ENV_Z.bit_HOME_FAZENDO	THEN
			
			passo_GIRO_SACOLA					:= 14;
	END_IF
	

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
14: //HOME: Se o Home do eixo Z do Envolvedor for concluído, vai para próximo passo. 

	IF	M3_LA_ENV_Z.bit_HOME_FEITO	THEN
			M3_LA_ENV_Z.bit_FAZER_HOME					:= FALSE;
			LA_ENV.bit_valv_APROX_GARRA				:=	TRUE;
			LA_ENV.bit_EIXO_Z_ENVOLVEDOR_FAZER_HOME	:= FALSE;
			passo_GIRO_SACOLA										:= 15;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
15: //HOME: Inicia o Home no eixo X do Envolvedor
	
	IF	LA_GERAL.di_ENV_SENS_ATU_ABERTURA_AV	THEN
		LA_ENV.bit_EIXO_X_ENVOLVEDOR_FAZER_HOME		:= TRUE;
		passo_GIRO_SACOLA									:= 16;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
16: //HOME: Verifica se está se movendo para o Home do Eixo X do Envolvedor
	
	IF M4_LA_ENV_X.bit_HOME_FAZENDO	THEN
			
			passo_GIRO_SACOLA					:= 17;
	END_IF
	

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
17: //HOME: Se o Home do eixo X do Envolvedor for concluído, vai para próximo passo. 

	IF	M4_LA_ENV_X.bit_HOME_FEITO	THEN
			M4_LA_ENV_X.bit_FAZER_HOME					:= FALSE;
			LA_ENV.bit_EIXO_X_ENVOLVEDOR_FAZER_HOME	:= FALSE;
			passo_GIRO_SACOLA										:= 18;
	END_IF

	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
18: //HOME: Inicia o Home no eixos de giro do Envolvedor
	
	LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LD_FAZER_HOME		:= TRUE;
	LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LE_FAZER_HOME		:= TRUE;

	passo_GIRO_SACOLA							:= 19;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
19: //HOME: Verifica se está se movendo para o Home dos eixos de giro do Envolvedor
	
	IF M5_LA_ENV_GIRO_LD.bit_HOME_FAZENDO AND M6_LA_ENV_GIRO_LE.bit_HOME_FAZENDO	THEN
			LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LD_FAZER_HOME	:= FALSE;
			LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LE_FAZER_HOME	:= FALSE;
			passo_GIRO_SACOLA					:= 20;
	END_IF
		
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
20: //HOME: Se o Home dos eixos do Envolvedor forem concluído, vai para próximo passo. Se não, reinicia o home de novo
	
	IF	M5_LA_ENV_GIRO_LD.bit_HOME_FEITO AND M6_LA_ENV_GIRO_LE.bit_HOME_FEITO	THEN
			passo_GIRO_SACOLA						:= 100;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
100: //HOME:
	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
		passo_GIRO_SACOLA	:=	101;
	END_IF
	

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
101: //HOME: resetando atuadores

	 passo_GIRO_SACOLA	:=	102;
	IF	LA_GERAL.di_ENV_SENS_ATU_ABERTURA_RC 	THEN
			passo_GIRO_SACOLA	:=	102;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
102://HOME: resetando atuadores
	
		passo_GIRO_SACOLA	:=	999;

	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
999://SE A MÁQUINA ESTIVER RODANDO, PREPARA INICIO DE CICLO

	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
		passo_GIRO_SACOLA	:=	1000;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1000://	comanda posição de pega dos eixo X, LD e LE do envolvedor

	M4_LA_ENV_X.ABS_MOVER		:= LA_GERAL.coord_X_ENVOLVEDOR_PEGA;
	
	passo_GIRO_SACOLA 						:= 1001;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1001: //Comanda eixos X e rotativos do Envolvedor com movimentos absolutos para ponto de pega de filme. 

	LA_ENV.bit_EIXO_X_ENVOLVEDOR_MOVER_ABS				:= TRUE;
	LA_ENV.bit_valv_GARRA_DUPLA				 			:= FALSE;
		
	passo_GIRO_SACOLA 		:= 1002;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1002: //Verifica se Eixo X do envolvedor está se movimentando ou se já está posicionado

	IF	M4_LA_ENV_X.bit_MOVE_ABS_FAZENDO	OR 	LA_ENV.bit_EIXO_X_ENVOLVEDOR_POSICIONADO	THEN
			LA_ENV.bit_EIXO_X_ENVOLVEDOR_MOVER_ABS	:= FALSE;
			passo_GIRO_SACOLA 								:= 1003;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1003: //Verifica se Eixo LD do envolvedor está se movimentando ou se já está posicionado

			passo_GIRO_SACOLA 				:= 1004;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1004: //Verifica se Eixo LE do envolvedor está se movimentando ou se já está posicionado

			passo_GIRO_SACOLA 				:= 1005;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1005: //verifica se Eixos LD, LE e X chegaram aos seus pontos

	IF	M4_LA_ENV_X.bit_MOVE_ABS_FEITO	OR 	LA_ENV.bit_EIXO_X_ENVOLVEDOR_POSICIONADO	THEN
			passo_GIRO_SACOLA 			:= 1006;
	END_IF	
			
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1006://	comanda posição de pre pega do eixo Z do envolvedor

	IF 	LA_GERAL.bit_MAQUINA_RODANDO 				THEN
			M3_LA_ENV_Z.ABS_MOVER	:= 	LA_GERAL.coord_Z_ENVOLVEDOR_PRE_PEGA;
			passo_GIRO_SACOLA					:=	1007;
	END_IF
		
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1007://se estiver rodando, libera movimento do eixo Z do Envolvedor

	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
		LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS	:= TRUE;
		passo_GIRO_SACOLA								:= 1008;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1008://verifica se eixo Z do Envolvedor está se movendo ou se já está posicionado

	IF	M3_LA_ENV_Z.bit_MOVE_ABS_FAZENDO OR LA_ENV.bit_EIXO_Z_ENVOLVEDOR_POSICIONADO	THEN
		LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS	:= FALSE;
		
		passo_GIRO_SACOLA								:= 1009;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1009://verifica se eixo Z do Envolvedor completou movimento

	IF	M3_LA_ENV_Z.bit_MOVE_ABS_FEITO OR LA_ENV.bit_EIXO_Z_ENVOLVEDOR_POSICIONADO	THEN
		LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS	:= FALSE;
		LA_ENV.bit_valv_APROX_GARRA				:=	false;
		
		passo_GIRO_SACOLA					:= 1010;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1010://	comanda posição de pega do eixo Z do envolvedor a sacola e o strech estejam posicionados

	IF 	LA_GERAL.bit_MAQUINA_RODANDO 					AND
		LA_ENV.bit_ENVOLVEDOR_SACOLA_POSICIONADA		AND
		(LA_GERAL.di_ENV_SENS_ATU_ABERTURA_AV)			THEN
			M3_LA_ENV_Z.ABS_MOVER	:= 	LA_GERAL.coord_Z_ENVOLVEDOR_PEGA;
			passo_GIRO_SACOLA					:=	1011;
	END_IF
		
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1011://se estiver rodando, libera movimento do eixo Z do Envolvedor

	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
		LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS	:= TRUE;
		passo_GIRO_SACOLA								:= 1012;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1012://verifica se eixo Z do Envolvedor está se movendo ou se já está posicionado

	IF	M3_LA_ENV_Z.bit_MOVE_ABS_FAZENDO OR LA_ENV.bit_EIXO_Z_ENVOLVEDOR_POSICIONADO	THEN
		LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS	:= FALSE;
		
		passo_GIRO_SACOLA								:= 1013;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1013://verifica se eixo Z do Envolvedor completou movimento e declara que sacola não está mais posicionada na esteira transportadora do envolvedor

	IF	M3_LA_ENV_Z.bit_MOVE_ABS_FEITO OR LA_ENV.bit_EIXO_Z_ENVOLVEDOR_POSICIONADO	THEN
	//	GVL_ENVOLVEDOR.bit_ENVOLVEDOR_SACOLA_POSICIONADA	:= FALSE;
		LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS		:= FALSE;
		
		passo_GIRO_SACOLA					:= 1014;
	END_IF
		
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1014://se estiver rodando, aciona atuador aprox garra

	IF LA_GERAL.bit_MAQUINA_RODANDO AND LA_IHM.bit_SIMULA_GIRO THEN
		LA_ENV.bit_valv_APROX_GARRA	:=	TRUE;
		tmr_APROX_GARRA.IN					:=	TRUE;
		passo_GIRO_SACOLA					:=	1015;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1015://espera feedback do sensor de avanço do aprox garra e aciona garra dupla
	
	IF	((LA_GERAL.di_ENV_SENS_ATU_ABERTURA_RC) OR tmr_APROX_GARRA.Q) AND LA_IHM.bit_SIMULA_GIRO AND (PVAR.rec_ATUAL.int_NUM_MAX_CAMADAS_EMPILHADOR = 4) THEN
		tmr_APROX_GARRA.IN					:=	FALSE;
		tmr_GARRA_DUPLA.IN					:=	TRUE;
		passo_GIRO_SACOLA					:=	1016;
	END_IF
	
	IF	((LA_GERAL.di_ENV_SENS_ATU_ABERTURA_RC) OR tmr_APROX_GARRA.Q) AND LA_IHM.bit_SIMULA_GIRO AND (PVAR.rec_ATUAL.int_NUM_MAX_CAMADAS_EMPILHADOR = 5) THEN
		tmr_APROX_GARRA.IN					:=	FALSE;
		tmr_GARRA_DUPLA.IN					:=	TRUE;
		passo_GIRO_SACOLA					:=	1016;
	END_IF	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1016:	

	M3_LA_ENV_Z.ABS_MOVER.sp_POSICAO	:= 	LA_GERAL.coord_Z_ENVOLVEDOR_PEGA.sp_POSICAO + 50;
	LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS	:= TRUE;
	passo_GIRO_SACOLA								:= 1017;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1017://verifica se eixo Z do Envolvedor está se movendo ou se já está posicionado

	IF	M3_LA_ENV_Z.bit_MOVE_ABS_FAZENDO OR LA_ENV.bit_EIXO_Z_ENVOLVEDOR_POSICIONADO	THEN
		LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS	:= FALSE;
		LA_ENV.bit_valv_GARRA_DUPLA				:= TRUE;
		
		passo_GIRO_SACOLA								:= 1018;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1018://verifica se eixo Z do Envolvedor completou movimento e declara que sacola não está mais posicionada na esteira transportadora do envolvedor

	IF	M3_LA_ENV_Z.bit_MOVE_ABS_FEITO OR LA_ENV.bit_EIXO_Z_ENVOLVEDOR_POSICIONADO	THEN
		LA_ENV.bit_ENVOLVEDOR_SACOLA_POSICIONADA	:= FALSE;
		LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS		:= FALSE;
		
		passo_GIRO_SACOLA					:= 1019;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1019://espera feedback do sensor de avanço da garra dupla

	IF	(*(NOT sens_PINCA_GARRA_RC_LD AND NOT sens_PINCA_GARRA_RC_LE) OR*) tmr_GARRA_DUPLA.Q THEN
		LA_ENV.bit_valv_GARRA_DUPLA		:= TRUE;
		tmr_GARRA_DUPLA.IN						:=	FALSE;
		passo_GIRO_SACOLA						:=	1020;
	END_IF	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1020://	comanda posição de Saída pega do eixo Z do envolvedor e desliga vácuo filme

	IF 	LA_GERAL.bit_MAQUINA_RODANDO 				THEN
			M3_LA_ENV_Z.ABS_MOVER	:= 	LA_GERAL.coord_Z_ENVOLVEDOR_SAIDA_PEGA;
			passo_GIRO_SACOLA					:=	1021;
	END_IF
		
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1021://se estiver rodando, libera movimento do eixo Z do Envolvedor

	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
			LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS	:= TRUE;
			passo_GIRO_SACOLA								:= 1022;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1022://verifica se eixo Z do Envolvedor está se movendo ou se já está posicionado

	IF	M3_LA_ENV_Z.bit_MOVE_ABS_FAZENDO OR LA_ENV.bit_EIXO_Z_ENVOLVEDOR_POSICIONADO	THEN
			LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS	:= FALSE;
			passo_GIRO_SACOLA								:= 1023;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1023://verifica se eixo Z do Envolvedor completou movimento

	IF	M3_LA_ENV_Z.bit_MOVE_ABS_FEITO OR LA_ENV.bit_EIXO_Z_ENVOLVEDOR_POSICIONADO	THEN
			LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS	:= FALSE;
			LA_ENV.bit_ENVOLVEDOR_SACOLA_POSICIONADA	:= FALSE;
			passo_GIRO_SACOLA					:= 1024;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1024://comanda eixo X do envolvedor para posição de corte de filme e eixos de giro para posição final de enrolamento de filme 
	IF LA_GERAL.bit_MAQUINA_RODANDO	THEN
			LA_ENV.bit_ENV_CORTE_FILME		:= TRUE;
			M4_LA_ENV_X.ABS_MOVER		:= LA_GERAL.coord_X_ENVOLVEDOR_CORTE;
			M5_LA_ENV_GIRO_LD.REL_MOVER	:= LA_GERAL.coord_GIRO_ENVOLVEDOR_CORTE;
			M6_LA_ENV_GIRO_LE.REL_MOVER	:= LA_GERAL.coord_GIRO_ENVOLVEDOR_CORTE;
			passo_GIRO_SACOLA 						:= 1025;
	END_IF
		
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1025: //Comanda eixos X e rotativos do Envolvedor com movimentos absolutos para ponto de corte de filme. 

	LA_ENV.bit_EIXO_X_ENVOLVEDOR_MOVER_ABS				:= TRUE;
	LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LD_MOVER_REL		:= TRUE;
	LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LE_MOVER_REL		:= TRUE;
	passo_GIRO_SACOLA 		:= 1026;
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1026: //Verifica se Eixo X do envolvedor está se movimentando ou se já está posicionado

	IF	M4_LA_ENV_X.bit_MOVE_ABS_FAZENDO	OR 	LA_ENV.bit_EIXO_X_ENVOLVEDOR_POSICIONADO	THEN
			LA_ENV.bit_EIXO_X_ENVOLVEDOR_MOVER_ABS	:= FALSE;
			passo_GIRO_SACOLA 								:= 1027;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1027: //Verifica se Eixo LD do envolvedor está se movimentando ou se já está posicionado

	IF	M5_LA_ENV_GIRO_LD.bit_MOVE_REL_FAZENDO	OR LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LD_POSICIONADO	THEN
			passo_GIRO_SACOLA 				:= 1028;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1028: //Verifica se Eixo LE do envolvedor está se movimentando ou se já está posicionado

	IF	M6_LA_ENV_GIRO_LE.bit_MOVE_REL_FAZENDO		OR 	LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LE_POSICIONADO	THEN
			passo_GIRO_SACOLA 				:= 1029;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1029: //verifica se Eixos LD, LE e X chegaram aos seus pontos

	IF	M4_LA_ENV_X.bit_MOVE_ABS_FEITO	OR 	LA_ENV.bit_EIXO_X_ENVOLVEDOR_POSICIONADO	THEN
			bit_ENTREGA_X_FEITO			:= TRUE;
	END_IF	
	
	IF	M5_LA_ENV_GIRO_LD.bit_MOVE_REL_FEITO	(*OR 	GVL_ENVOLVEDOR.bit_EIXO_GIRO_ENVOLVEDOR_LD_POSICIONADO*)	THEN
			bit_ENTREGA_GIRO_LD_FEITO	:= TRUE;
			LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LD_MOVER_REL	:= FALSE;
	END_IF	
	
	IF	M6_LA_ENV_GIRO_LE.bit_MOVE_REL_FEITO	(*OR 	GVL_ENVOLVEDOR.bit_EIXO_GIRO_ENVOLVEDOR_LE_POSICIONADO*)	THEN
			bit_ENTREGA_GIRO_LE_FEITO	:= TRUE;
			LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LE_MOVER_REL	:= FALSE;
	END_IF	
	
	IF	bit_ENTREGA_X_FEITO				AND
		bit_ENTREGA_GIRO_LE_FEITO		AND
		bit_ENTREGA_GIRO_LD_FEITO		THEN
			bit_ENTREGA_X_FEITO			:= FALSE;
			bit_ENTREGA_GIRO_LD_FEITO	:= FALSE;
			bit_ENTREGA_GIRO_LE_FEITO	:= FALSE;
			passo_GIRO_SACOLA 			:= 1030;
	END_IF
		
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1030://	comanda posição de corte de filme do eixo Z do envolvedor

	IF 	LA_GERAL.bit_MAQUINA_RODANDO 				THEN
			LA_ENV.bit_ENV_CORTE_FILME		:= TRUE;
			M3_LA_ENV_Z.ABS_MOVER		:= LA_GERAL.coord_Z_ENVOLVEDOR_CORTE;
			M5_LA_ENV_GIRO_LD.REL_MOVER	:= LA_GERAL.coord_GIRO_ENVOLVEDOR_ENTREGA;
			M6_LA_ENV_GIRO_LE.REL_MOVER	:= LA_GERAL.coord_GIRO_ENVOLVEDOR_ENTREGA;			
			passo_GIRO_SACOLA					:=	1031;
	END_IF
		
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1031://se estiver rodando, libera movimento do eixo Z do Envolvedor

	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
			LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS			:= TRUE;
			LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LD_MOVER_REL	:= TRUE;
			LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LE_MOVER_REL	:= TRUE;
			passo_GIRO_SACOLA								:= 1032;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1032://verifica se eixo Z do Envolvedor está se movendo ou se já está posicionado

	IF	M3_LA_ENV_Z.bit_MOVE_ABS_FAZENDO OR LA_ENV.bit_EIXO_Z_ENVOLVEDOR_POSICIONADO	THEN
			LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS		:= FALSE;
			LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LD_MOVER_REL	:= FALSE;
			LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LE_MOVER_REL	:= FALSE;
			passo_GIRO_SACOLA								:= 1033;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1033://verifica se eixo Z do Envolvedor completou movimento

	IF	M3_LA_ENV_Z.bit_MOVE_ABS_FEITO OR LA_ENV.bit_EIXO_Z_ENVOLVEDOR_POSICIONADO AND LA_GERAL.bit_MAQUINA_RODANDO	THEN
			LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS	:= FALSE;
			LA_ENV.bit_valv_VACUO_FILME	:=	TRUE;
			tmr_PASSO_1028.IN					:= TRUE;
			passo_GIRO_SACOLA					:= 1034;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1034://aciona valvula de corte e vácuo de filme

	IF tmr_PASSO_1028.Q	AND LA_GERAL.bit_MAQUINA_RODANDO	THEN
		tmr_PASSO_1028.IN					:= 	FALSE;
			LA_ENV.bit_valv_CORTE_FILME	:=	FALSE;
			LA_ENV.bit_ENV_CORTE_FILME	:=	FALSE;
			passo_GIRO_SACOLA					:= 	1035;
	END_IF


//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1035:

		M3_LA_ENV_Z.ABS_MOVER.sp_POSICAO			:=	275;
		M3_LA_ENV_Z.ABS_MOVER.sp_VELOCIDADE		:=	LA_GERAL.coord_Z_ENVOLVEDOR_ENTREGA.sp_VELOCIDADE;
		M3_LA_ENV_Z.ABS_MOVER.sp_ACELERACAO		:=	LA_GERAL.coord_Z_ENVOLVEDOR_ENTREGA.sp_ACELERACAO;
		M3_LA_ENV_Z.ABS_MOVER.sp_DESACELERACAO	:=	LA_GERAL.coord_Z_ENVOLVEDOR_ENTREGA.sp_DESACELERACAO;
		passo_GIRO_SACOLA										:=	1036;
		
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1036:

	IF 	LA_GERAL.bit_MAQUINA_RODANDO	THEN
			LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS	:= TRUE;
			passo_GIRO_SACOLA								:= 1037;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1037://verifica se eixo Z do Envolvedor está se movendo ou se já está posicionado

	IF	M3_LA_ENV_Z.bit_MOVE_ABS_FAZENDO OR LA_ENV.bit_EIXO_Z_ENVOLVEDOR_POSICIONADO	THEN
			LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS	:= FALSE;
			passo_GIRO_SACOLA								:= 1038;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1038://verifica se eixo Z do Envolvedor completou movimento

	IF	M3_LA_ENV_Z.bit_MOVE_ABS_FEITO OR LA_ENV.bit_EIXO_Z_ENVOLVEDOR_POSICIONADO	THEN
			LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS	:= FALSE;
			passo_GIRO_SACOLA					:= 1039;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1039://espera não ter sacola depositada para comandar eixo X para Entrega
	
	IF NOT LA_ENV.bit_ENVOLVEDOR_SACOLA_DEPOSITADA	AND
		   sens_FECHA_FILME_1_RC				 			THEN
			 M4_LA_ENV_X.ABS_MOVER				:= 	LA_GERAL.coord_X_ENVOLVEDOR_ENTREGA;
			 LA_ENV.bit_ENVOLVEDOR_SACOLA_DEPOSITANDO	:=	TRUE;
			 passo_GIRO_SACOLA									:=	1040;	
	END_IF

	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1040://se estiver rodando, libera movimento do eixo X do Envolvedor

	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
			LA_ENV.bit_EIXO_X_ENVOLVEDOR_MOVER_ABS	:= TRUE;
			passo_GIRO_SACOLA								:=	1041;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1041://verifica se eixo X do Envolvedor está se movendo ou se já está posicionado

	IF	M4_LA_ENV_X.bit_MOVE_ABS_FAZENDO OR LA_ENV.bit_EIXO_X_ENVOLVEDOR_POSICIONADO	THEN
			LA_ENV.bit_EIXO_X_ENVOLVEDOR_MOVER_ABS	:= FALSE;
			passo_GIRO_SACOLA								:= 1042;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1042://verifica se eixo X do Envolvedor completou movimento

	IF	M4_LA_ENV_X.bit_MOVE_ABS_FEITO OR LA_ENV.bit_EIXO_X_ENVOLVEDOR_POSICIONADO	THEN
			LA_ENV.bit_EIXO_X_ENVOLVEDOR_MOVER_ABS	:= FALSE;
			passo_GIRO_SACOLA					:= 1043;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1043://aguarda confirmação de presença de filme para comandar eixo Z para posição de Saida Pega
	
	IF (*sens_FILME_ENVOLVEDOR AND *)LA_GERAL.bit_MAQUINA_RODANDO THEN	
			M3_LA_ENV_Z.ABS_MOVER			:=	LA_GERAL.coord_Z_ENVOLVEDOR_ENTREGA;
			passo_GIRO_SACOLA							:=	1044;
	END_IF
		
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1044://se estiver rodando, libera movimento do eixo Z do Envolvedor

	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
			LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS	:= TRUE;
			passo_GIRO_SACOLA								:= 1045;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1045://verifica se eixo Z do Envolvedor está se movendo ou se já está posicionado

	IF	M3_LA_ENV_Z.bit_MOVE_ABS_FAZENDO OR LA_ENV.bit_EIXO_Z_ENVOLVEDOR_POSICIONADO	THEN
			LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS	:= FALSE;
			passo_GIRO_SACOLA								:= 1046;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1046://verifica se eixo Z do Envolvedor completou movimento

	IF	M3_LA_ENV_Z.bit_MOVE_ABS_FEITO OR LA_ENV.bit_EIXO_Z_ENVOLVEDOR_POSICIONADO	THEN
			LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS	:= FALSE;
			passo_GIRO_SACOLA					:= 1047;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1047://espera não ter sacola depositada para comandar eixo X para Entrega
	
	IF NOT LA_ENV.bit_ENVOLVEDOR_SACOLA_DEPOSITADA	AND
		   sens_FECHA_FILME_1_RC				 			THEN
			 M4_LA_ENV_X.ABS_MOVER				:= 	LA_GERAL.coord_X_ENVOLVEDOR_ENTREGA;
			 LA_ENV.bit_ENVOLVEDOR_SACOLA_DEPOSITANDO	:=	TRUE;
			 passo_GIRO_SACOLA									:=	1048;	
	END_IF

	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1048://se estiver rodando, libera movimento do eixo X do Envolvedor

	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
			LA_ENV.bit_EIXO_X_ENVOLVEDOR_MOVER_ABS	:= TRUE;
			passo_GIRO_SACOLA								:=	1049;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1049://verifica se eixo X do Envolvedor está se movendo ou se já está posicionado

	IF	M4_LA_ENV_X.bit_MOVE_ABS_FAZENDO OR LA_ENV.bit_EIXO_X_ENVOLVEDOR_POSICIONADO	THEN
			LA_ENV.bit_EIXO_X_ENVOLVEDOR_MOVER_ABS	:= FALSE;
			passo_GIRO_SACOLA								:= 1050;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1050://verifica se eixo X do Envolvedor completou movimento

	IF	M4_LA_ENV_X.bit_MOVE_ABS_FEITO OR LA_ENV.bit_EIXO_X_ENVOLVEDOR_POSICIONADO	THEN
			LA_ENV.bit_EIXO_X_ENVOLVEDOR_MOVER_ABS	:= FALSE;
			passo_GIRO_SACOLA					:= 1051;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1051://aciona fecha filme 1 e espera timer
	
	LA_ENV.bit_valv_FECHA_FILME_1	:=	TRUE;
	tmr_FECHA_FILME_1.IN					:=	TRUE;
		
	IF tmr_FECHA_FILME_1.Q	THEN
		tmr_FECHA_FILME_1.IN	:= FALSE;
		passo_GIRO_SACOLA		:= 1052;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1052://abre garra dupla e aciona timer
	
	LA_ENV.bit_valv_GARRA_DUPLA	:=	FALSE;
	tmr_GARRA_DUPLA2.IN					:=	TRUE;
	passo_GIRO_SACOLA					:= 1053;	
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1053: //aguarda feedback dos sensores ou timer e recua atuador aprox. garra

	IF	(*(NOT sens_PINCA_GARRA_RC_LD AND NOT sens_PINCA_GARRA_RC_LE) OR*) tmr_GARRA_DUPLA2.Q THEN
			tmr_GARRA_DUPLA2.IN					:=	FALSE;
			tmr_GARRA_DUPLA3.IN					:=	TRUE;
			LA_ENV.bit_valv_APROX_GARRA	:=	FALSE;
			passo_GIRO_SACOLA					:=	1054;
	END_IF
	

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1054://espera timer completar e fecha garra dupla novamente

	IF tmr_GARRA_DUPLA3.Q	THEN
			tmr_GARRA_DUPLA3.IN					:=	FALSE;
			LA_ENV.bit_valv_GARRA_DUPLA	:=	TRUE;
			passo_GIRO_SACOLA					:=	1055;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1055://aguarda confirmação de recuo de atuador prox. garra e confirma sacola depositada

	IF LA_GERAL.di_ENV_SENS_ATU_ABERTURA_AV THEN
			LA_ENV.bit_ENVOLVEDOR_SACOLA_DEPOSITANDO := FALSE;
			passo_GIRO_SACOLA								 :=	1056;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1056://	comanda posição de corte de filme do eixo Z do envolvedor

	IF 	LA_GERAL.bit_MAQUINA_RODANDO 				THEN
			M3_LA_ENV_Z.ABS_MOVER				 := LA_GERAL.coord_Z_ENVOLVEDOR_SAIDA_PEGA;
			passo_GIRO_SACOLA								 :=	1057;
	END_IF
		
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1057://se estiver rodando, libera movimento do eixo Z do Envolvedor

	IF LA_GERAL.bit_MAQUINA_RODANDO THEN
			LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS	:= TRUE;
			passo_GIRO_SACOLA								:= 1058;	
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1058://verifica se eixo Z do Envolvedor está se movendo ou se já está posicionado

	IF	M3_LA_ENV_Z.bit_MOVE_ABS_FAZENDO OR LA_ENV.bit_EIXO_Z_ENVOLVEDOR_POSICIONADO	THEN
			LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS	:= FALSE;
			passo_GIRO_SACOLA								:= 1059;
	END_IF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1059://verifica se eixo Z do Envolvedor completou movimento

	IF	M3_LA_ENV_Z.bit_MOVE_ABS_FEITO OR LA_ENV.bit_EIXO_Z_ENVOLVEDOR_POSICIONADO	THEN
			LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS	:= FALSE;
			LA_ENV.bit_ENVOLVEDOR_SACOLA_DEPOSITADA	 :=	TRUE;
			passo_GIRO_SACOLA					:= 1060;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1060: //reinicia ciclo comandando para posição de pega
		passo_GIRO_SACOLA				:=	999;

END_CASE


//------------//-----------LÓGICAS EXTRAS---------------//----------------------//--------------------------//


	//EIXO X ENVOLVEDOR JÁ ESTÁ NA POSIÇÃO
	IF	LA_ENV.info_MOTOR_X_ENVOLVEDOR_POS_ATUAL	&gt;= M4_LA_ENV_X.ABS_MOVER.sp_POSICAO - 1	AND
		LA_ENV.info_MOTOR_X_ENVOLVEDOR_POS_ATUAL	&lt;= M4_LA_ENV_X.ABS_MOVER.sp_POSICAO + 1	THEN
			LA_ENV.bit_EIXO_X_ENVOLVEDOR_POSICIONADO	:= TRUE;
	ELSE
			LA_ENV.bit_EIXO_X_ENVOLVEDOR_POSICIONADO	:= FALSE;
	END_IF
	
	//EIXO Z ENVOLVEDOR JÁ ESTÁ NA POSIÇÃO
	IF	LA_ENV.info_MOTOR_Z_ENVOLVEDOR_POS_ATUAL	&gt;= M3_LA_ENV_Z.ABS_MOVER.sp_POSICAO - 1	AND
		LA_ENV.info_MOTOR_Z_ENVOLVEDOR_POS_ATUAL	&lt;= M3_LA_ENV_Z.ABS_MOVER.sp_POSICAO + 1	THEN
			LA_ENV.bit_EIXO_Z_ENVOLVEDOR_POSICIONADO	:= TRUE;
	ELSE
			LA_ENV.bit_EIXO_Z_ENVOLVEDOR_POSICIONADO	:= FALSE;
	END_IF
	
	//EIXO GIRO LD ENVOLVEDOR JÁ ESTÁ NA POSIÇÃO
	IF	LA_ENV.info_MOTOR_GIRO_ENVOLVIMENTO_LD_POS_ATUAL	&gt;= M5_LA_ENV_GIRO_LD.ABS_MOVER.sp_POSICAO - 1	AND
		LA_ENV.info_MOTOR_GIRO_ENVOLVIMENTO_LD_POS_ATUAL	&lt;= M5_LA_ENV_GIRO_LD.ABS_MOVER.sp_POSICAO + 1	THEN
			LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LD_POSICIONADO	:= TRUE;
	ELSE
			LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LD_POSICIONADO	:= FALSE;
	END_IF
	
	
	//EIXO GIRO LE ENVOLVEDOR JÁ ESTÁ NA POSIÇÃO
	IF	LA_ENV.info_MOTOR_GIRO_ENVOLVIMENTO_LE_POS_ATUAL	&gt;= M6_LA_ENV_GIRO_LE.ABS_MOVER.sp_POSICAO - 1	AND
		LA_ENV.info_MOTOR_GIRO_ENVOLVIMENTO_LE_POS_ATUAL	&lt;= M6_LA_ENV_GIRO_LE.ABS_MOVER.sp_POSICAO + 1	THEN
			LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LE_POSICIONADO	:= TRUE;
	ELSE
			LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LE_POSICIONADO	:= FALSE;
	END_IF



//-----------ATUADORES-------------//--------------------//---------------------//

LA_GERAL.do_ENV_ATU_GARRAS		:=	NOT LA_ENV.bit_valv_GARRA_DUPLA;
LA_GERAL.do_ENV_ATU_ABERTURA	:=	 NOT LA_ENV.bit_valv_APROX_GARRA;

valv_CORTE_FILME				:=	LA_ENV.bit_valv_CORTE_FILME;
valv_VACUO_FILME				:=	LA_ENV.bit_valv_VACUO_FILME;
LA_GERAL.do_ENV_CORTE_FILME		:=	(LA_ENV.bit_ENV_CORTE_FILME AND LA_GERAL.bit_SAFETY_ATIVO) OR LA_IHM.bit_ENV_CORTE_FILME;
	
	
tmr_GARRA_DUPLA(PT:= T#500MS);
tmr_GARRA_DUPLA2(PT:= T#100MS);
tmr_GARRA_DUPLA3(PT:= T#50MS);
tmr_APROX_GARRA(PT:= T#1800MS);
tmr_FECHA_FILME_1(PT:= T#1800MS);

tmr_PASSO_1028(PT:= T#1000MS);
tmr_PASSO_1029(PT:= T#1500MS);</Single>
