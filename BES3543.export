      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">//MODO MANUAL EIXOS


	//EIXO Z ENVOLVEDOR
	IF		LA_IHM.bit_MANUAL_HABILITAR_EIXOS							AND
		NOT	LA_ENV.bit_MOTOR_Z_ENVOLVEDOR_JOG_FORWARD			AND	
		NOT	LA_ENV.bit_MOTOR_Z_ENVOLVEDOR_JOG_REVERSE			THEN
				bit_EIXO_Z_ENVOLVEDOR_RTRIG	:= TRUE;
	ELSE
				bit_EIXO_Z_ENVOLVEDOR_RTRIG	:= FALSE;
	END_IF
	
	rtrig_EIXO_Z_ENVOLVEDOR_RESET_STOP(CLK := bit_EIXO_Z_ENVOLVEDOR_RTRIG);
	LA_ENV.bit_MOTOR_Z_ENVOLVEDOR_JOG_STOP	:= rtrig_EIXO_Z_ENVOLVEDOR_RESET_STOP.Q;


	//EIXO X ENVOLVEDOR
	IF		LA_IHM.bit_MANUAL_HABILITAR_EIXOS							AND
		NOT	LA_ENV.bit_MOTOR_X_ENVOLVEDOR_JOG_FORWARD			AND	
		NOT	LA_ENV.bit_MOTOR_X_ENVOLVEDOR_JOG_REVERSE			THEN
				bit_EIXO_X_ENVOLVEDOR_RTRIG	:= TRUE;
	ELSE
				bit_EIXO_X_ENVOLVEDOR_RTRIG	:= FALSE;
	END_IF
	
	rtrig_EIXO_x_ENVOLVEDOR_RESET_STOP(CLK := bit_EIXO_X_ENVOLVEDOR_RTRIG);
	LA_ENV.bit_MOTOR_X_ENVOLVEDOR_JOG_STOP	:= rtrig_EIXO_x_ENVOLVEDOR_RESET_STOP.Q;
	
	

	//EIXO LD 
	IF		LA_IHM.bit_MANUAL_HABILITAR_EIXOS							AND
		NOT	LA_ENV.bit_MOTOR_GIRO_ENVOLVEDOR_LD_JOG_FORWARD		AND	
		NOT	LA_ENV.bit_MOTOR_GIRO_ENVOLVEDOR_LD_JOG_REVERSE		THEN
				bit_EIXO_GIRO_ENVOLVEDOR_LD_RTRIG	:= TRUE;
	ELSE
				bit_EIXO_GIRO_ENVOLVEDOR_LD_RTRIG	:= FALSE;
	END_IF
	
	rtrig_EIXO_GIRO_ENVOLVEDOR_LD_RESET_STOP(CLK := bit_EIXO_GIRO_ENVOLVEDOR_LD_RTRIG);
	LA_ENV.bit_MOTOR_GIRO_ENVOLVEDOR_LD_JOG_STOP	:= rtrig_EIXO_GIRO_ENVOLVEDOR_LD_RESET_STOP.Q;
	
	
	//EIXO LE
	IF		LA_IHM.bit_MANUAL_HABILITAR_EIXOS							AND
		NOT	LA_ENV.bit_MOTOR_GIRO_ENVOLVEDOR_LE_JOG_FORWARD		AND	
		NOT	LA_ENV.bit_MOTOR_GIRO_ENVOLVEDOR_LE_JOG_REVERSE		THEN
				bit_EIXO_GIRO_ENVOLVEDOR_LE_RTRIG	:= TRUE;
	ELSE
				bit_EIXO_GIRO_ENVOLVEDOR_LE_RTRIG	:= FALSE;
	END_IF
	
	rtrig_EIXO_GIRO_ENVOLVEDOR_LE_RESET_STOP(CLK := bit_EIXO_GIRO_ENVOLVEDOR_LE_RTRIG);
	LA_ENV.bit_MOTOR_GIRO_ENVOLVEDOR_LE_JOG_STOP	:= rtrig_EIXO_GIRO_ENVOLVEDOR_LE_RESET_STOP.Q;
	
//--------------------------//-----------------------------------//---------------------------//--------------------------------//	
	
//HOME DOS EIXOS

	//HOME EIXO Z ENVOLVEDOR
	IF	(LA_ENV.bit_EIXO_Z_ENVOLVEDOR_FAZER_HOME OR LA_IHM.bit_EIXO_Z_ENVOLVEDOR_FAZER_HOME)	THEN
			M3_LA_ENV_Z.bit_FAZER_HOME	:= TRUE;
	END_IF
	
	IF	M3_LA_ENV_Z.bit_HOME_FEITO		THEN
			M3_LA_ENV_Z.bit_FAZER_HOME	:= FALSE;
	END_IF
	
	//HOME EIXO X ENVOLVEDOR
	IF	(LA_ENV.bit_EIXO_X_ENVOLVEDOR_FAZER_HOME OR LA_IHM.bit_EIXO_X_ENVOLVEDOR_FAZER_HOME)	THEN
			M4_LA_ENV_X.bit_FAZER_HOME	:= TRUE;
	END_IF
	
	IF	M3_LA_ENV_Z.bit_HOME_FEITO		THEN
			M4_LA_ENV_X.bit_FAZER_HOME	:= FALSE;
	END_IF


	//HOME EIXO LD ENVOLVEDOR
	IF	(LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LD_FAZER_HOME OR LA_IHM.bit_EIXO_GIRO_ENVOLVEDOR_LD_FAZER_HOME)	THEN
			M5_LA_ENV_GIRO_LD.bit_FAZER_HOME	:= TRUE;
	END_IF
	
	IF	M5_LA_ENV_GIRO_LD.bit_HOME_FEITO		THEN
			M5_LA_ENV_GIRO_LD.bit_FAZER_HOME	:= FALSE;
	END_IF
	
	
	
	//HOME EIXO LE ENVOLVEDOR
	IF	(LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LE_FAZER_HOME OR LA_IHM.bit_EIXO_GIRO_ENVOLVEDOR_LE_FAZER_HOME)	THEN
			M6_LA_ENV_GIRO_LE.bit_FAZER_HOME	:= TRUE;
	END_IF
	
	IF	M1_LA_EMP_GARRA.bit_HOME_FEITO		THEN
			M6_LA_ENV_GIRO_LE.bit_FAZER_HOME	:= FALSE;
	END_IF
	
</Single>
