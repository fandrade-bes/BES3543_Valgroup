            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM M5_LA_ENV_GIRO_LD
VAR
	fb_POWER				: MC_Power;
	fb_RESET				: MC_Reset;
	fb_LER_POS_ATUAL		: MC_ReadActualPosition;
	fb_HOME					: MC_Home;
	fb_MOVER_ABS			: MC_MoveAbsolute;
	fb_MOVER_REL			: MC_MoveRelative;
	fb_MOVER_JOG			: MC_JOG;
	fb_MOVER_STOP			: MC_STOP;

	bit_POWER_ERRO			: BOOL;
	bit_HOME_ERRO			: BOOL;
	bit_MOVE_ABS_ERRO		: BOOL;
	bit_MOVE_REL_ERRO		: BOOL;
	bit_MOVE_JOG_ERRO		: BOOL;
	
