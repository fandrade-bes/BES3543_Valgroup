            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM D01_EST_ETIQUETA
VAR
	reset_rotina	:	BOOL;
	passo_ETIQUETA	:	INT := 9;
	
	bit_ETIQUETA_PRONTA		:	BOOL;
	bit_ETIQUETA_IMPRIMINDO	:	BOOL;
	bit_ETIQUETA_CONCLUIDO	: 	BOOL;
	
	bit_IMPRIMIR_ETIQUETA_1	:	BOOL;
	bit_IMPRIMIR_ETIQUETA_2	:	BOOL;
	
	tmr_PARAR_ESTEIRA		:	TON;
	tmr_ETIQUETA			:	TON;
	TESTE: BOOL;
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">a5ea018a-56e4-428a-ad48-8dcb450fb5d6_Decl_LineIds</Single>
          </Single>
