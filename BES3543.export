            <Single Name="TextBlobForSerialisation" Type="string">{attribute 'qualified_only'}
VAR_GLOBAL
	
//COMANDOS

	bit_GARRA_EMPILHADOR_EXECUTANDO_RESET	: BOOL;
	bit_EIXO_X_EMPILHADOR_EXECUTANDO_RESET	: BOOL;
	bit_MESA_GIRO_EXECUTANDO_RESET			: BOOL;
	
	bit_ENTREGA_EMPILHADOR_CONCLUIDO		: BOOL;
	bit_ENTREGA_PILHA_CONCLUIDO				: BOOL;
	bit_EIXO_X_MOVE_CONCLUIDO				: BOOL;
	bit_MESA_GIRO_CONCLUIDO					: BOOL;
	
	bit_LIBERA_INSPECAO_PILHA				: BOOL;
	bit_EST_INSPECAO_ENTREGUE_1				: BOOL;
	bit_EST_INSPECAO_ENTREGUE_2				: BOOL;
	bit_OPERADOR_INSPECAO_OK				: BOOL;
	bit_EST_ENVIAR_PILHA_INSPECAO			: BOOL;
	bit_REALIZANDO_INSPECAO					: BOOL;
	
	bit_LIBERA_ENTREGA_PILHA				: BOOL;
	bit_ENTREGANDO_PILHA_COMPLETA			: BOOL;
	bit_EST_PILHA_ENTREGUE					: BOOL;
	
	bit_STATUS_INSPECAO_1					: BOOL;
	
	bit_LIBERA_PEGA							: BOOL;
	bit_LIBERA_GIRO							: BOOL;
	bit_LIBERA_X							: BOOL;
	
	bit_PILHA_PAR							: BOOL;
	bit_PILHA_IMPAR							: BOOL;
	
	bit_GIRO_MESA_REVERSE					: BOOL;
	bit_GIRO_MESA_FOWARD					: BOOL;
	
	bit_LIGA_EST_INSPECAO					: BOOL;
	bit_LIGA_EST_MESA_GIRO					: BOOL;
	
	
	bit_valv_GARRA_SACOLA					: BOOL;
	bit_valv_BANDEJA						: BOOL;
	bit_valv_DESCE_MESA_GIRO				: BOOL;
	bit_valv_POSICIONA_SACOLA				: BOOL;
	
	est_ROLETES_GIRO_MESA					: BOOL;
	est_INSPECAO_EMPILHADOR 				: BOOL;
	
	est_ROLETES_GIRO_MESA_REVERSE			: BOOL;
	est_INSPECAO_EMPILHADOR_REVERSE			: BOOL;
	
	
	
	
	bit_EIXO_X_EMPILHADOR_FAZER_HOME		: BOOL;
	bit_EIXO_X_EMPILHADOR_POSICIONADO		: BOOL;
	
	bit_EIXO_GIRO_MESA_FAZER_HOME			: BOOL;
	bit_EIXO_GIRO_MESA_POSICIONADO			: BOOL;
	
	bit_EIXO_GARRA_EMPILHADOR_FAZER_HOME	: BOOL;
	bit_EIXO_GARRA_EMPILHADOR_POSICIONADO	: BOOL;
	
	
	
	bit_EIXO_GARRA_EMPILHADOR_MOVER_ABS		: BOOL;
	bit_EIXO_GARRA_EMPILHADOR_MOVER_REL		: BOOL;
	
	bit_EIXO_X_EMPILHADOR_MOVER_ABS			: BOOL;
	bit_EIXO_X_EMPILHADOR_MOVER_REL			: BOOL;
	
	bit_EIXO_GIRO_MESA_MOVER_ABS			: BOOL;
	bit_EIXO_GIRO_MESA_MOVER_REL			: BOOL;
	

	
	bit_GARRA_EMPILHADOR_JOG_FORWARD		: BOOL;
	bit_GARRA_EMPILHADOR_JOG_REVERSE		: BOOL;
	bit_GARRA_EMPILHADOR_JOG_STOP			: BOOL;
	
	bit_EIXO_X_EMPILHADOR_JOG_FORWARD		: BOOL;
	bit_EIXO_X_EMPILHADOR_JOG_REVERSE		: BOOL;
	bit_EIXO_X_EMPILHADOR_JOG_STOP			: BOOL;
	
	bit_GIRO_MESA_JOG_FORWARD				: BOOL;
	bit_GIRO_MESA_JOG_REVERSE				: BOOL;
	bit_GIRO_MESA_JOG_STOP					: BOOL;
	
	
	info_MOTOR_GARRA_EMPILHADOR_POS_ATUAL	: LREAL;
	info_MOTOR_EIXO_X_EMPILHADOR_POS_ATUAL	: LREAL;
	info_MOTOR_GIRO_MESA_POS_ATUAL			: LREAL;
	
	
	num_GIROS_STRETCH					: LREAL;
	
	tmr_RTON_MOVE_1						: RTON;
	tmr_RTON_MOVE_2						: RTON;
	tmr_RTON_MOVE_3						: RTON;
	tmr_RTON_MOVE_4						: RTON;
	tmr_RTON_MOVE_5						: RTON;
	
	
	//	ENTRADAS	============//============//============//============//============//============//============
		
	//E-16DIO - SLOT 1 (RMT50001)	
		di_SENS_MESA_GIRO_RC				: BOOL;
		di_SENS_MESA_GIRO_MD				: BOOL;
		di_SENS_PINCA_GARRA_EMPILHADOR_RC	: BOOL;
		di_SENS_APOIO_BANDEJA_RC			: BOOL;
		di_SENS_EST_INSPEC_PRODUTO_1		: BOOL;
		di_SENS_MESA_GIRO_AV				: BOOL;
		di_SENS_PINCA_GARRA_EMPILHADOR_AV	: BOOL;
		di_SENS_APOIO_BANDEJA_AV			: BOOL;
		di_SENS_PRODUTO_MESA_GIRO			: BOOL;
		di_SENS_EST_INSPEC_PRODUTO_2		: BOOL;
		
	//E-16DIO - SLOT 2 (RMT50002)	
		di_feedback_ERRO_MESA_GIRO			: BOOL;
		di_feedback_ERRO_EST_INSPECAO		: BOOL;
		
	
	
//	SAIDAS		============//============//============//============//============//============//============

	//E-16DIO - SLOT 1 (RMT50001)		
		do_ATU_MESA_GIRO_RC				: BOOL;
		do_ATU_PINCA_GARRA_EMPILHADOR	: BOOL;
		do_ATU_MESA_GIRO_AV				: BOOL;
		do_ATU_BANDEJA_APOIO			: BOOL;
		
	//E-16DIO - SLOT 2 (RMT50002)	
		do_SPEED_A_MESA_GIRO			: BOOL;
		do_SPEED_A_EST_INSPECAO			: BOOL;
		do_REVERSE_MESA_GIRO			: BOOL;
		do_SPEED_B_MESA_GIRO			: BOOL;
		do_REVERSE_EST_INSPECAO			: BOOL;
		do_SPEED_B_EST_INSPECAO			: BOOL;
		
	
	
	
	
END_VAR</Single>
