      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">//SE A MÁQUINA ESTIVER EM MODO MANUAL E NÃO ESTIVER RODANDO, HABILITA SELEÇÃO MANUAL DE ATUADORES
	IF	LA_GERAL.bit_MAQUINA_MANUAL	AND
	NOT	LA_GERAL.bit_MAQUINA_RODANDO	THEN
			
			IF LA_IHM.bit_SELEC_EMPILHADOR_BANDEJA			THEN
					LA_IHM.int_EMPILHADOR_ATUADOR_SELECIONADO	:= 1;
			END_IF
			
			
			IF LA_IHM.bit_SELEC_EMPILHADOR_DESCE_MESA_GIRO		THEN
					LA_IHM.int_EMPILHADOR_ATUADOR_SELECIONADO	:= 2;
			END_IF
			
			IF LA_IHM.bit_SELEC_EMPILHADOR_GARRA_SACOLA		THEN
					LA_IHM.int_EMPILHADOR_ATUADOR_SELECIONADO	:= 3;
			END_IF
			
			IF LA_IHM.bit_SELEC_EMPILHADOR_POSICIONA_SACOLA		THEN
					LA_IHM.int_EMPILHADOR_ATUADOR_SELECIONADO	:= 4;
			END_IF

		
			
			CASE	LA_IHM.int_EMPILHADOR_ATUADOR_SELECIONADO	OF
					
					0: //SEM ATUADOR SELECIONADO
						LA_IHM.bit_ATU_EMPILHADOR_AVANCADO	:= FALSE;
						LA_IHM.bit_ATU_EMPILHADOR_RECUADO	:= FALSE;			
			
					1://ATUADOR EMPILHADOR BANDEJA
						IF LA_IHM.bit_ATU_EMPILHADOR_AVANCAR	THEN
								LA_EMP.bit_valv_BANDEJA	:= TRUE;
						END_IF
						
						IF LA_IHM.bit_ATU_EMPILHADOR_RECUAR	THEN
								LA_EMP.bit_valv_BANDEJA	:= FALSE;
						END_IF
						
						LA_IHM.bit_ATU_EMPILHADOR_AVANCADO	:= LA_EMP.di_SENS_APOIO_BANDEJA_AV;
						LA_IHM.bit_ATU_EMPILHADOR_RECUADO	:= LA_EMP.di_SENS_APOIO_BANDEJA_RC;
						
					2://ATUADOR DESCE GIRO MESA
						IF LA_IHM.bit_ATU_EMPILHADOR_AVANCAR	THEN
								LA_EMP.bit_valv_DESCE_MESA_GIRO	:= TRUE;
						END_IF
						
						IF LA_IHM.bit_ATU_EMPILHADOR_RECUAR	THEN
								LA_EMP.bit_valv_DESCE_MESA_GIRO	:= FALSE;
						END_IF
						
						LA_IHM.bit_ATU_EMPILHADOR_AVANCADO	:= LA_EMP.di_SENS_MESA_GIRO_AV;
						LA_IHM.bit_ATU_EMPILHADOR_RECUADO	:= LA_EMP.di_SENS_MESA_GIRO_RC;
						
					3://ATUADOR GARRA SACOLA
						IF LA_IHM.bit_ATU_EMPILHADOR_AVANCAR	THEN
								LA_EMP.bit_valv_GARRA_SACOLA	:= TRUE;
						END_IF
						
						IF LA_IHM.bit_ATU_EMPILHADOR_RECUAR	THEN
								LA_EMP.bit_valv_GARRA_SACOLA	:= FALSE;
						END_IF
						
						LA_IHM.bit_ATU_EMPILHADOR_AVANCADO	:= LA_EMP.di_SENS_PINCA_GARRA_EMPILHADOR_AV;
						LA_IHM.bit_ATU_EMPILHADOR_RECUADO	:= LA_EMP.di_SENS_PINCA_GARRA_EMPILHADOR_RC;
						
					4://ATUADOR POSICIONA SACOLA
						IF LA_IHM.bit_ATU_EMPILHADOR_AVANCAR	THEN
								LA_EMP.bit_valv_POSICIONA_SACOLA	:= TRUE;
						END_IF
						
						IF LA_IHM.bit_ATU_EMPILHADOR_RECUAR	THEN
								LA_EMP.bit_valv_POSICIONA_SACOLA	:= FALSE;
						END_IF
						
						LA_IHM.bit_ATU_EMPILHADOR_AVANCADO	:= sens_POSICIONADOR_EMPILHADOR_AV;
						LA_IHM.bit_ATU_EMPILHADOR_RECUADO	:= sens_POSICIONADOR_EMPILHADOR_RC;					
		
			END_CASE	
	
	ELSE
		
		LA_IHM.int_EMPILHADOR_ATUADOR_SELECIONADO	:= 0;
		
		LA_IHM.bit_ATU_EMPILHADOR_AVANCADO				:= FALSE;
		LA_IHM.bit_ATU_EMPILHADOR_RECUADO				:= FALSE;	
			
		LA_IHM.bit_SELEC_EMPILHADOR_BANDEJA			:= FALSE;
		LA_IHM.bit_SELEC_EMPILHADOR_DESCE_MESA_GIRO 	:= FALSE;
		LA_IHM.bit_SELEC_EMPILHADOR_GARRA_SACOLA	 	:= FALSE;
		LA_IHM.bit_SELEC_EMPILHADOR_POSICIONA_SACOLA	:= FALSE;

	
	END_IF
	
	
</Single>
