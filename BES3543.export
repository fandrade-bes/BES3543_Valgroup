            <Single Name="TextBlobForSerialisation" Type="string">//	COMANDO		============//============//============//============//============//============//============
// Seleciona a fonte do comando conforme o modo

	IF in_SAFETY_ATIVO THEN

		IF in_MODO_MANUAL THEN
			bit_CMD_ATUADOR := in_MANUAL_CMD;
		ELSE
			bit_CMD_ATUADOR := in_AUTO_CMD;
		END_IF
	
		out_VALVULA_AV := bit_CMD_ATUADOR;
		out_VALVULA_RC := NOT bit_CMD_ATUADOR;
		
	END_IF
	
//	ALARMES		============//============//============//============//============//============//============
// 	Alarme dispara se a válvula estiver comandada e o sensor correspondente não confirmar a posição dentro do tempo.

CASE in_SENSORIAMENTO	OF
		
0:	// Sem sensores
	out_ALARME_AV	:= FALSE;
	out_ALARME_RC	:= FALSE;
	
1: 	//Apenas Sensor Recuado
	tmr_ALARME_RC (PT	:= T#2000MS, IN	:= in_SAFETY_ATIVO	AND out_VALVULA_RC AND NOT in_SENSOR_RC);
	out_ALARME_RC	:= tmr_ALARME_RC.Q;
	
	out_ALARME_AV	:= FALSE;
	
2:	//Apenas Sensor Avançado
	out_ALARME_RC	:= FALSE;
	
	tmr_ALARME_AV (PT	:= T#2000MS, IN	:= in_SAFETY_ATIVO	AND out_VALVULA_AV AND NOT in_SENSOR_AV);
	out_ALARME_AV	:= tmr_ALARME_AV.Q;
	
3:	// Sensor Recuado e Avançado
	tmr_ALARME_RC (PT	:= T#2000MS, IN	:= in_SAFETY_ATIVO	AND out_VALVULA_RC AND NOT in_SENSOR_RC);
	out_ALARME_RC	:= tmr_ALARME_RC.Q;
	
	tmr_ALARME_AV (PT	:= T#2000MS, IN	:= in_SAFETY_ATIVO	AND out_VALVULA_AV AND NOT in_SENSOR_AV);
	out_ALARME_AV	:= tmr_ALARME_AV.Q;	
	
END_CASE</Single>
            <Single Name="LineInfoPersistence" Type="string">efcd9475-493d-48cb-8ab9-a5520e9f0d7b_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_ATUADOR

VAR_INPUT
	in_SAFETY_ATIVO		: BOOL;
	in_MODO_MANUAL		: BOOL;
	in_AUTO_CMD			: BOOL;
	in_MANUAL_CMD		: BOOL;
	in_SENSORIAMENTO	: INT; // Tipo de Sensoriamento (0: Sem sensores; 1: Apenas RC; 2: Apenas AV; 3: RC e AV)
	in_SENSOR_RC		: BOOL;
	in_SENSOR_AV		: BOOL;
END_VAR

VAR_OUTPUT
	out_VALVULA_RC		: BOOL;
	out_VALVULA_AV		: BOOL;
	out_ALARME_AV		: BOOL;
	out_ALARME_RC		: BOOL;
END_VAR

VAR
	bit_CMD_ATUADOR		: BOOL;
	tmr_ALARME_AV		: TON;
	tmr_ALARME_RC		: TON;
END_VAR
</Single>
