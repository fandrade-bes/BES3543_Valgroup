      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">		//------------------GARRA EMPILHADOR----------------//--------------------------//----------------------------------
		LA_GERAL.coord_GARRA_EMPILHADOR_ENTREGA.sp_POSICAO				:= 	PVAR.rec_ATUAL.sp_ENTREGA_GARRA_EMPILHADOR_POSICAO[LA_IHM.int_CAMADA_ATUAL];
		LA_GERAL.coord_GARRA_EMPILHADOR_ENTREGA.sp_VELOCIDADE			:=	PVAR.rec_ATUAL.sp_ENTREGA_GARRA_EMPILHADOR_VELOCIDADE;
		LA_GERAL.coord_GARRA_EMPILHADOR_ENTREGA.sp_ACELERACAO			:=	PVAR.rec_ATUAL.sp_ENTREGA_GARRA_EMPILHADOR_ACELERACAO;
		LA_GERAL.coord_GARRA_EMPILHADOR_ENTREGA.sp_DESACELERACAO		:=	PVAR.rec_ATUAL.sp_ENTREGA_GARRA_EMPILHADOR_DESACELERACAO;
		
		LA_GERAL.coord_GARRA_EMPILHADOR_PRE_ENTREGA.sp_POSICAO			:=	PVAR.rec_ATUAL.sp_PRE_ENTREGA_GARRA_EMPILHADOR_POSICAO[LA_IHM.int_CAMADA_ATUAL];
		LA_GERAL.coord_GARRA_EMPILHADOR_PRE_ENTREGA.sp_VELOCIDADE		:=	PVAR.rec_ATUAL.sp_PRE_ENTREGA_GARRA_EMPILHADOR_VELOCIDADE;
		LA_GERAL.coord_GARRA_EMPILHADOR_PRE_ENTREGA.sp_ACELERACAO		:=	PVAR.rec_ATUAL.sp_PRE_ENTREGA_GARRA_EMPILHADOR_ACELERACAO;
		LA_GERAL.coord_GARRA_EMPILHADOR_PRE_ENTREGA.sp_DESACELERACAO	:=	PVAR.rec_ATUAL.sp_PRE_ENTREGA_GARRA_EMPILHADOR_DESACELERACAO;
		
		LA_GERAL.coord_GARRA_EMPILHADOR_PEGA							:=	PVAR.rec_ATUAL.coord_PEGA_GARRA_EMPILHADOR;
		LA_GERAL.coord_GARRA_EMPILHADOR_PRE_PEGA						:=	PVAR.rec_ATUAL.coord_PRE_PEGA_GARRA_EMPILHADOR;
		
		//------------------EIXO X EMPILHADOR----------------//--------------------------//----------------------------------
		LA_GERAL.coord_X_EMPILHADOR_POS_1						:=	PVAR.rec_ATUAL.coord_X_EMPILHADOR_POS[1];
		LA_GERAL.coord_X_EMPILHADOR_POS_2						:=	PVAR.rec_ATUAL.coord_X_EMPILHADOR_POS[2];
		LA_GERAL.coord_X_EMPILHADOR_POS_3						:=	PVAR.rec_ATUAL.coord_X_EMPILHADOR_POS[3];
		LA_GERAL.coord_X_EMPILHADOR_POS_4						:=	PVAR.rec_ATUAL.coord_X_EMPILHADOR_POS[4];
		LA_GERAL.coord_X_EMPILHADOR_POS_5						:=	PVAR.rec_ATUAL.coord_X_EMPILHADOR_POS[5];
		LA_GERAL.coord_X_EMPILHADOR_POS_6						:=	PVAR.rec_ATUAL.coord_X_EMPILHADOR_POS[6];
		
		LA_GERAL.coord_X_EMPILHADOR_INSPECAO					:=	PVAR.rec_ATUAL.coord_X_EMPILHADOR_INSPECAO;
		LA_GERAL.coord_X_EMPILHADOR_ENTREGA					:=	PVAR.rec_ATUAL.coord_X_EMPILHADOR_ENTREGA;
			
		//------------------MESA GIRO EMPILHADOR----------------//--------------------------//----------------------------------
		LA_GERAL.coord_MESA_GIRO_POSICAO_INICIAL				:=	PVAR.rec_ATUAL.coord_MESA_GIRO_INICIAL;
		LA_GERAL.coord_MESA_GIRO_POSICAO_FINAL					:=	PVAR.rec_ATUAL.coord_MESA_GIRO_FINAL;
		LA_GERAL.coord_MESA_GIRO_POSICAO_INSPECAO				:=	PVAR.rec_ATUAL.coord_MESA_GIRO_INSPECAO;
		
		//------------------EIXO Z ENVOLVEDOR----------------//--------------------------//----------------------------------
		LA_GERAL.coord_Z_ENVOLVEDOR_PRE_PEGA					:=	PVAR.rec_ATUAL.coord_Z_ENVOLVEDOR_PRE_PEGA;
		LA_GERAL.coord_Z_ENVOLVEDOR_PEGA						:=	PVAR.rec_ATUAL.coord_Z_ENVOLVEDOR_PEGA;
		LA_GERAL.coord_Z_ENVOLVEDOR_SAIDA_PEGA					:=	PVAR.rec_ATUAL.coord_Z_ENVOLVEDOR_SAIDA_PEGA;
		LA_GERAL.coord_Z_ENVOLVEDOR_CORTE						:=	PVAR.rec_ATUAL.coord_Z_ENVOLVEDOR_CORTE;
		LA_GERAL.coord_Z_ENVOLVEDOR_ENTREGA					:=	PVAR.rec_ATUAL.coord_Z_ENVOLVEDOR_ENTREGA;
			
		//------------------EIXO X ENVOLVEDOR----------------//--------------------------//----------------------------------
		LA_GERAL.coord_X_ENVOLVEDOR_PEGA						:=	PVAR.rec_ATUAL.coord_X_ENVOLVEDOR_PEGA;
		LA_GERAL.coord_X_ENVOLVEDOR_CORTE						:=	PVAR.rec_ATUAL.coord_X_ENVOLVEDOR_CORTE;
		LA_GERAL.coord_X_ENVOLVEDOR_ENTREGA					:=	PVAR.rec_ATUAL.coord_X_ENVOLVEDOR_ENTREGA;
			
		//------------------EIXOS GIRO ENVOLVEDOR----------------//--------------------------//----------------------------------
		LA_GERAL.coord_GIRO_ENVOLVEDOR_PEGA					:=	PVAR.rec_ATUAL.coord_GIRO_ENVOLVEDOR_PEGA;
		LA_GERAL.coord_GIRO_ENVOLVEDOR_CORTE					:=	PVAR.rec_ATUAL.coord_GIRO_ENVOLVEDOR_CORTE;
		LA_GERAL.coord_GIRO_ENVOLVEDOR_ENTREGA					:=	PVAR.rec_ATUAL.coord_GIRO_ENVOLVEDOR_ENTREGA;
		
		LA_GERAL.num_VOLTAS	:=	79.99982 * LA_EMP.num_GIROS_STRETCH;</Single>
