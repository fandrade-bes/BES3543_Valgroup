	bit_MOVE_REL_FEITO		: BOOL;
	bit_MOVE_REL_FAZENDO	: BOOL;
	bit_HABILITAR_EIXOS		: BOOL;
	bit_EIXO_DRV_MOVER_ABS	: BOOL;
	bit_DRV_JOG_FORWARD		: BOOL;
	bit_DRV_JOG_REVERSE		: BOOL;
	bit_DRV_JOG_STOP		: BOOL;
	bit_SERVOS_RESET		: BOOL;
	info_MOTOR_PASSO_POS_ATUAL: LREAL;
END_VAR


