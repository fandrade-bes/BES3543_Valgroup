      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">4b1658ac-3ca5-4775-926e-d1c5e3a28b98</Single>
        <Single Name="ParentGuid" Type="System.Guid">00000000-0000-0000-0000-000000000000</Single>
        <Single Name="Name" Type="string">A01_COMANDOS</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">21af5390-2942-461a-bf89-951aaf6999f1</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">b8b4aea1-a84a-4c7b-aba6-e7b770a6cc4a</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639240296879492073</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">//SAFETY
	IF	NOT LA_GERAL.di_SEG_GERAL_ATIVA 	AND 
		NOT LA_GERAL.di_SEG_INTERNA_ATIVA	THEN
				LA_GERAL.bit_SAFETY_ATIVO			:= TRUE;
	ELSE
				LA_GERAL.bit_SAFETY_ATIVO			:= FALSE;
	END_IF


//LIGAR CELULA
	IF	(LA_GERAL.di_BT_CMD1_START OR LA_GERAL.di_BT_CMD2_START)	AND
		LA_GERAL.bit_SAFETY_ATIVO						THEN
			LA_GERAL.bit_MAQUINA_PRONTA			:= TRUE;
	END_IF
	
	
//DESLIGAR CELULA
	LA_GERAL.bit_BT_DESLIGA	:= LA_GERAL.di_BT_CMD1_STOP OR LA_GERAL.di_BT_CMD2_STOP;

	IF LA_GERAL.bit_BT_DESLIGA OR NOT	LA_GERAL.bit_SAFETY_ATIVO	THEN
			LA_GERAL.bit_MAQUINA_PRONTA			:= FALSE;
	END_IF
	
	
//RESETAR CELULA
	IF 	(LA_GERAL.di_BT_CMD1_RESET OR LA_GERAL.di_BT_CMD2_RESET)	AND
		NOT LA_GERAL.bit_MAQUINA_PRONTA					THEN
		LA_GERAL.bit_SERVOS_RESET	 			:= TRUE;
	ELSE
		LA_GERAL.bit_SERVOS_RESET 				:= FALSE;
	END_IF
	
	
//RESET BITS DE EIXOS DA CELULA	
	IF	LA_GERAL.bit_SERVOS_RESET			THEN
			M0_LA_EMP_X.bit_FAZER_HOME		:= FALSE;
			M1_LA_EMP_GARRA.bit_FAZER_HOME			:= FALSE;
			M2_LA_EMP_GIRO.bit_FAZER_HOME				:= FALSE;
			M3_LA_ENV_Z.bit_FAZER_HOME		:= FALSE;
			M4_LA_ENV_X.bit_FAZER_HOME		:= FALSE;
			M5_LA_ENV_GIRO_LD.bit_FAZER_HOME		:= FALSE;
			M6_LA_ENV_GIRO_LE.bit_FAZER_HOME		:= FALSE;
		
			LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_ABS 	 		:= FALSE;
			LA_EMP.bit_EIXO_GARRA_EMPILHADOR_MOVER_ABS 		:= FALSE;
			LA_EMP.bit_EIXO_GIRO_MESA_MOVER_ABS 			:= FALSE;
			LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_ABS 			:= FALSE;
			LA_ENV.bit_EIXO_X_ENVOLVEDOR_MOVER_ABS 			:= FALSE;
			LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LD_MOVER_ABS 	:= FALSE;
			LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LE_MOVER_ABS 	:= FALSE;
			
			LA_EMP.bit_EIXO_X_EMPILHADOR_MOVER_REL 	 		:= FALSE;
			LA_EMP.bit_EIXO_GARRA_EMPILHADOR_MOVER_REL 		:= FALSE;
			LA_EMP.bit_EIXO_GIRO_MESA_MOVER_REL 			:= FALSE;
			LA_ENV.bit_EIXO_Z_ENVOLVEDOR_MOVER_REL 			:= FALSE;
			LA_ENV.bit_EIXO_X_ENVOLVEDOR_MOVER_REL 			:= FALSE;
			LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LD_MOVER_REL 	:= FALSE;
			LA_ENV.bit_EIXO_GIRO_ENVOLVEDOR_LE_MOVER_REL 	:= FALSE;
			
	END_IF
	
	IF LA_GERAL.bit_SERVOS_RESET OR LA_GERAL.TESTE_Z THEN
		LA_GERAL.RESET_Z	:=	TRUE;
	ELSE
		LA_GERAL.RESET_Z	:=	FALSE;
	END_IF
	
//SE TODOS OS CONJUNTOS RESETAREM, COMEÇA A RODAR CELULA
	IF	LA_GERAL.bit_MAQUINA_PRONTA						AND
		LA_IHM.bit_EIXO_X_EMPILHADOR_HABILITADO			AND
		LA_IHM.bit_EIXO_GARRA_EMPILHADOR_HABILITADO				AND
		LA_IHM.bit_EIXO_GIRO_MESA_HABILITADO					(*AND
		M03_DRV_EIXO_Z_ENVOLVEDOR.bit_HABILITADO			AND
		M04_DRV_EIXO_X_ENVOLVEDOR.bit_HABILITADO			AND
		M05_DRV_GIRO_ENVOLVEDOR_LD.bit_HABILITADO			AND
		M06_DRV_GIRO_ENVOLVEDOR_LE.bit_HABILITADO*)			THEN
			LA_GERAL.bit_MAQUINA_RODANDO	:= TRUE;
			LA_IHM.bit_MAQUINA_MANUAL		:= FALSE;
	ELSE
			LA_GERAL.bit_MAQUINA_RODANDO	:= FALSE;
	END_IF
	
	
// RESET GERAL
	tmr_RESET_GERAL (PT := T#2000MS);
	
	tmr_RESET_GERAL.IN := 	LA_GERAL.di_BT_CMD1_RESET OR LA_GERAL.di_BT_CMD2_RESET;
	
	IF	tmr_RESET_GERAL.Q	THEN
			LA_GERAL.bit_RESET_GERAL := TRUE;	
	END_IF
	
//EIXOS
	IF	LA_GERAL.bit_AUTO_HABILITAR_EIXOS		OR
		LA_IHM.bit_MANUAL_HABILITAR_EIXOS		THEN
			LA_GERAL.bit_HABILITAR_EIXOS	:= TRUE;
	ELSE
			LA_GERAL.bit_HABILITAR_EIXOS	:= FALSE;
	END_IF
	
	IF	NOT LA_GERAL.bit_MAQUINA_MANUAL	THEN
				LA_IHM.bit_MANUAL_HABILITAR_EIXOS	:= FALSE;
	END_IF
	
	IF	LA_GERAL.bit_SAFETY_ATIVO AND (LA_GERAL.di_BT_CMD1_RESET OR LA_GERAL.di_BT_CMD2_RESET)	THEN
			LA_GERAL.bit_AUTO_HABILITAR_EIXOS	:= TRUE;
	END_IF
	
	
	IF NOT	LA_GERAL.bit_SAFETY_ATIVO		THEN
			LA_GERAL.bit_AUTO_HABILITAR_EIXOS	:= FALSE;
	END_IF
	
//tmr_AUTO_HABILITAR_EIXOS (IN:= NOT GVL_CELULA.bit_SAFETY_ATIVO, PT:= T#10S);

	IF 	LA_GERAL.bit_EIXO_X_EMPILHADOR_PRONTO			AND
		LA_GERAL.bit_EIXO_GARRA_EMPILHADOR_PRONTO		AND
		LA_GERAL.bit_EIXO_GIRO_MESA_PRONTO			AND
		LA_GERAL.bit_EIXO_Z_ENVOLVEDOR_PRONTO			AND
		LA_GERAL.bit_EIXO_X_ENVOLVEDOR_PRONTO			AND
		LA_GERAL.bit_EIXO_GIRO_ENVOLVEDOR_LD_PRONTO	AND
		LA_GERAL.bit_EIXO_GIRO_ENVOLVEDOR_LD_PRONTO	THEN
			LA_GERAL.bit_EIXOS_PRONTOS	:=	TRUE;
	ELSE
			LA_GERAL.bit_EIXOS_PRONTOS	:=	FALSE;
		
	END_IF

//LIGAR ESTEIRAS
	
	//ESTEIRAS EMPILHADOR
	IF	LA_GERAL.bit_SAFETY_ATIVO AND (LA_EMP.est_INSPECAO_EMPILHADOR OR LA_IHM.est_INSPECAO_EMPILHADOR) THEN
			SPEED_A_EST_INSPECAO	:=	TRUE;
			SPEED_B_EST_INSPECAO	:=	TRUE;
	ELSE
			SPEED_A_EST_INSPECAO	:=	FALSE;
			SPEED_B_EST_INSPECAO	:=	FALSE;
	END_IF
	
	IF LA_GERAL.bit_SAFETY_ATIVO AND	(LA_EMP.est_ROLETES_GIRO_MESA OR LA_IHM.est_ROLETES_GIRO_MESA) THEN
			SPEED_A_MESA_GIRO	:=	TRUE;
			SPEED_B_MESA_GIRO	:=	TRUE;
	ELSE
			SPEED_A_MESA_GIRO	:=	FALSE;
			SPEED_B_MESA_GIRO	:=	FALSE;
	END_IF
//--------------------------////--------------------------////--------------------------////--------------------------////--------------------------//	
	//ESTEIRAS ENVOLVEDOR
	IF LA_GERAL.bit_SAFETY_ATIVO AND	((LA_ENV.est_ENTRADA_ENVOLVEDOR AND NOT LA_IHM.bit_MAQUINA_MANUAL) OR LA_IHM.est_ENVOLVEDOR_ENTRADA) THEN
			SPEED_A_ENTRADA_ENVOLVEDOR	:=	TRUE;
	ELSE
			SPEED_A_ENTRADA_ENVOLVEDOR	:=	FALSE;
	END_IF
	
	IF LA_GERAL.bit_SAFETY_ATIVO AND	((LA_ENV.est_TRANSPORTADOR_ENVOLVEDOR AND NOT LA_IHM.bit_MAQUINA_MANUAL) OR LA_IHM.est_TRANSPORTADOR_ENVOLVEDOR) THEN
			eest_TRANS_ENVOLVEDOR_DI2	:=	TRUE;
	ELSE
			eest_TRANS_ENVOLVEDOR_DI2	:=	FALSE;
	END_IF
	
	IF LA_GERAL.bit_SAFETY_ATIVO AND	(LA_ENV.est_SAIDA_ENVOLVEDOR OR LA_IHM.est_ENVOLVEDOR_SAIDA) THEN
			SPEED_A_TRANSP_SAIDA_1	:=	TRUE;
	ELSE
			SPEED_A_TRANSP_SAIDA_1	:=	FALSE;
	END_IF
//--------------------------////--------------------------////--------------------------////--------------------------////--------------------------//	
	//ESTEIRAS PESAGEM DE PRODUTO
	IF LA_GERAL.bit_SAFETY_ATIVO AND (GVL_PESAGEM.est_MESA_DE_TRANSFERENCIA OR LA_IHM.est_MESA_DE_TRANSFERENCIA) AND (NOT GVL_PESAGEM.est_MESA_DE_TRANSFERENCIA_REVERSE AND NOT LA_IHM.est_MESA_DE_TRANSFERENCIA_REVERSE) THEN
			est_MESA_TRANS_PESAGEM_DI1 := TRUE;
			est_MESA_TRANS_PESAGEM_DI3 := FALSE;
	ELSE
			est_MESA_TRANS_PESAGEM_DI1 := FALSE;
	END_IF
	
	IF LA_GERAL.bit_SAFETY_ATIVO AND (GVL_PESAGEM.est_REJEITO_PRODUTO OR LA_IHM.est_REJEITO_PRODUTO) THEN
			SPEED_A_REJEITO_PRODUTO := TRUE;
	ELSE
			SPEED_A_REJEITO_PRODUTO := FALSE;
	END_IF
	
	IF LA_GERAL.bit_SAFETY_ATIVO AND (GVL_PESAGEM.est_TRANSPORTADOR_PESAGEM OR LA_IHM.est_TRANSPORTADOR_PESAGEM) THEN
			SPEED_A_MESA_TRANSFER	:=	TRUE;
			//SPEED_B_MESA_TRANSFER	:=	TRUE;
	ELSE
			SPEED_A_MESA_TRANSFER	:=	FALSE;
			SPEED_B_MESA_TRANSFER	:=	FALSE;
	END_IF
	
	IF LA_GERAL.bit_SAFETY_ATIVO AND (GVL_PESAGEM.est_TRANSPORTADOR_ESTAGIO_1 OR LA_IHM.est_TRANSPORTADOR_ESTAGIO_1) THEN
			SPEED_A_ESTAGIO_1 := TRUE;
	ELSE
			SPEED_A_ESTAGIO_1 := FALSE;
	END_IF
	
//--------------------------////--------------------------////--------------------------////--------------------------////--------------------------//
	//INVERSÃO DE ETEIRAS
	IF LA_GERAL.bit_SAFETY_ATIVO AND (LA_EMP.est_INSPECAO_EMPILHADOR_REVERSE OR LA_IHM.est_INSPECAO_EMPILHADOR_REVERSE) THEN
			REVERSE_EST_INSPECAO := TRUE;
	ELSE
			REVERSE_EST_INSPECAO := FALSE;
	END_IF
	
	IF LA_GERAL.bit_SAFETY_ATIVO AND (LA_EMP.est_ROLETES_GIRO_MESA_REVERSE OR LA_IHM.est_ROLETES_GIRO_MESA_REVERSE) THEN
			REVERSE_MESA_GIRO := TRUE;
	ELSE
			REVERSE_MESA_GIRO := FALSE;
	END_IF

	IF  (GVL_PESAGEM.est_MESA_DE_TRANSFERENCIA OR LA_IHM.est_MESA_DE_TRANSFERENCIA) 				AND
		(GVL_PESAGEM.est_MESA_DE_TRANSFERENCIA_REVERSE OR LA_IHM.est_MESA_DE_TRANSFERENCIA_REVERSE)AND
		LA_GERAL.bit_SAFETY_ATIVO			 														THEN
			est_MESA_TRANS_PESAGEM_DI3 := TRUE;
			est_MESA_TRANS_PESAGEM_DI1 := FALSE;
	ELSE
			est_MESA_TRANS_PESAGEM_DI3 := FALSE;
	END_IF
	
	IF LA_GERAL.bit_SAFETY_ATIVO AND (GVL_PESAGEM.est_TRANSPORTADOR_PESAGEM_REVERSE OR LA_IHM.est_TRANSPORTADOR_PESAGEM_REVERSE) THEN
			REVERSE_MESA_TRANSFER := TRUE;
	ELSE
			REVERSE_MESA_TRANSFER := FALSE;
	END_IF
//--------------------------////--------------------------////--------------------------////--------------------------////--------------------------//
	
//BIT MAQUINA ESTAVEL 
	tmr_MAQUINA_ESTAVEL	(IN:= LA_GERAL.bit_MAQUINA_RODANDO, PT := T#5000MS);
	LA_GERAL.bit_MAQUINA_ESTAVEL	:= tmr_MAQUINA_ESTAVEL.Q;


//---------------------//---------------------------------------------//---------------------------------------------//------------------------
//---------------------//------------------------STATUS MAQUINA---------------------//------------------------


//STATUS MAQUINA RODANDO
	IF 	LA_GERAL.bit_MAQUINA_RODANDO 			AND 
	NOT LA_GERAL.bit_STATUS_PARADA 			THEN
		 LA_GERAL.bit_STATUS_RODANDO	:=	TRUE;
	ELSE
		 LA_GERAL.bit_STATUS_RODANDO	:=	FALSE;
	END_IF
	
//STATUS MAQUINA PARADA
	IF 	NOT LA_GERAL.bit_SAFETY_ATIVO 	 	THEN
		 	LA_GERAL.bit_STATUS_PARADA		:=	TRUE;
	ELSE
			LA_GERAL.bit_STATUS_PARADA		:=	FALSE;
	END_IF
	
//STATUS MAQUINA OCIOSA
	IF  LA_GERAL.bit_SAFETY_ATIVO 				AND
		LA_GERAL.bit_MAQUINA_RODANDO				AND
	NOT LA_GERAL.bit_EIXO_GERAL_MOVENDO 			THEN
		 tmr_MAQUINA_OCIOSA.IN			:=	TRUE;
	ELSE
		tmr_MAQUINA_OCIOSA.IN			:=	FALSE;
	END_IF
	
	IF tmr_MAQUINA_OCIOSA.Q OR	(NOT LA_GERAL.bit_MAQUINA_RODANDO AND LA_GERAL.bit_SAFETY_ATIVO) THEN
		LA_GERAL.bit_STATUS_OCIOSA	:=	TRUE;
	ELSE
		LA_GERAL.bit_STATUS_OCIOSA	:=	FALSE;
	END_IF
	
	
LA_IHM.bit_PORTA_1		:= LA_GERAL.di_SEG_PORTA_1;
LA_IHM.bit_PORTA_2 		:= LA_GERAL.di_SEG_PORTA_2;
	
//TIMERS		
	tmr_MAQUINA_OCIOSA (PT:= T#15S);</Single>
            <Single Name="LineInfoPersistence" Type="string">4b1658ac-3ca5-4775-926e-d1c5e3a28b98_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM A01_COMANDOS
VAR
	tmr_AUTO_HABILITAR_EIXOS	: TON;
	tmr_RESET_GERAL				: TON;
	tmr_MAQUINA_ESTAVEL			: TON;
	tmr_MAQUINA_OCIOSA			: TON;
	MICRO_FALHA					: BOOL;
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">4b1658ac-3ca5-4775-926e-d1c5e3a28b98_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">6085</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">b8b4aea1-a84a-4c7b-aba6-e7b770a6cc4a</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">LADO_A</Single>
        <Single Type="string">01 - LA_GERAL</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">4259604c-6061-43eb-a541-99a786b31938</Single>
        <Single Name="ParentGuid" Type="System.Guid">00000000-0000-0000-0000-000000000000</Single>
        <Single Name="Name" Type="string">A02_LAMPADAS</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">21af5390-2942-461a-bf89-951aaf6999f1</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">b8b4aea1-a84a-4c7b-aba6-e7b770a6cc4a</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639240298160048067</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">//LAMPADA VERDE SÓLIDO
	IF		LA_GERAL.bit_MAQUINA_PRONTA			AND
			LA_GERAL.bit_MAQUINA_RODANDO			THEN
				LA_GERAL.bit_LAMP_VERDE				:=	TRUE;
				LA_GERAL.bit_LAMP_VERMELHO				:=	FALSE;
				LA_GERAL.bit_LAMP_VERDE_PULSO			:=	FALSE;
				LA_GERAL.bit_LAMP_VERMELHO_PULSO		:=	FALSE;
				LA_GERAL.bit_LAMP_AMARELO_PULSO		:=	FALSE;
	END_IF
	
	
//LAMPADA VERDE PULSOS
	IF		LA_GERAL.bit_MAQUINA_PRONTA			AND
		NOT	LA_GERAL.bit_MAQUINA_RODANDO		THEN
				LA_GERAL.bit_LAMP_VERMELHO				:=	FALSE;
			//GVL_CASE.bit_LAMP_AMARELO				:=	FALSE;
				LA_GERAL.bit_LAMP_VERDE_PULSO			:=	TRUE;
				LA_GERAL.bit_LAMP_VERMELHO_PULSO		:=	FALSE;
	END_IF
	
	
//LAMPADA VERMELHA SÓLIDO
	IF	NOT	LA_GERAL.bit_MAQUINA_PRONTA			AND
			LA_GERAL.bit_SAFETY_ATIVO				THEN
				LA_GERAL.bit_LAMP_VERDE				:=	FALSE;
				LA_GERAL.bit_LAMP_VERMELHO				:=	TRUE;
				LA_GERAL.bit_LAMP_VERDE_PULSO			:=	FALSE;
				LA_GERAL.bit_LAMP_VERMELHO_PULSO		:=	FALSE;
	END_IF
				
				
//LAMPADA VERMELHA PULSOS
	IF	NOT	LA_GERAL.bit_SAFETY_ATIVO				THEN
				LA_GERAL.bit_LAMP_VERDE				:=	FALSE;
				LA_GERAL.bit_LAMP_AZUL					:=	FALSE;
				LA_GERAL.bit_LAMP_VERDE_PULSO			:=	FALSE;
				LA_GERAL.bit_LAMP_VERMELHO_PULSO		:=	TRUE;
				LA_GERAL.bit_LAMP_AMARELO_PULSO		:=	FALSE;
				LA_GERAL.bit_LAMP_AZUL_PULSO			:=	FALSE;
	END_IF
	
	
//LAMPADA AZUL SÓLIDO
	IF	LA_GERAL.bit_SAFETY_ATIVO					AND
		(LA_GERAL.di_BT_CMD1_RESET OR LA_GERAL.di_BT_CMD2_RESET)	AND
		NOT	LA_GERAL.bit_RESET_GERAL				THEN
				LA_GERAL.bit_LAMP_AZUL			:=	TRUE;
				LA_GERAL.bit_LAMP_AZUL_PULSO		:=	FALSE;
	ELSIF 	LA_GERAL.bit_SAFETY_ATIVO		AND
			LA_IHM.ALARME_ATIVO			THEN
				LA_GERAL.bit_LAMP_AZUL		:=	FALSE;
				LA_GERAL.bit_LAMP_AZUL_PULSO	:=	TRUE;
	ELSE
				LA_GERAL.bit_LAMP_AZUL		:=	FALSE;
	END_IF
	
	
//LAMPADA INSPEÇÃO SÓLIDO

	IF LA_EMP.bit_OPERADOR_INSPECAO_OK	THEN
		LA_GERAL.bit_LAMP_INSPECAO		:=	TRUE;
		LA_GERAL.bit_LAMP_INSPECAO_PULSO	:=	FALSE;
	END_IF
	
	
	//LAMPADA INSPEÇÃO PULSOS
	IF	LA_EMP.bit_STATUS_INSPECAO_1 AND NOT LA_EMP.bit_OPERADOR_INSPECAO_OK			THEN
				LA_GERAL.bit_LAMP_INSPECAO_PULSO		:=	TRUE;
	END_IF
	
	
	IF NOT LA_EMP.bit_STATUS_INSPECAO_1	AND NOT LA_EMP.bit_OPERADOR_INSPECAO_OK THEN
		LA_GERAL.bit_LAMP_INSPECAO		:=	FALSE;
		LA_GERAL.bit_LAMP_INSPECAO_PULSO	:=	FALSE;
	END_IF

	
	
//================================================================================================================================================================================
//PULSOS

	//VERDE
	IF 	LA_GERAL.bit_LAMP_VERDE_PULSO	AND
		LA_GERAL.bit_LAMP_VERDE		THEN
			tmr_LAMP_VERDE_ON.IN	:= TRUE;
			IF	tmr_LAMP_VERDE_ON.Q		THEN
					tmr_LAMP_VERDE_ON.IN	:= FALSE;
					LA_GERAL.bit_LAMP_VERDE	:=	FALSE;
			END_IF
	END_IF
	
	IF 	LA_GERAL.bit_LAMP_VERDE_PULSO	AND
	NOT	LA_GERAL.bit_LAMP_VERDE		THEN
			tmr_LAMP_VERDE_OFF.IN	:= TRUE;
			IF	tmr_LAMP_VERDE_OFF.Q		THEN
					tmr_LAMP_VERDE_OFF.IN	:= FALSE;
					LA_GERAL.bit_LAMP_VERDE	:=	TRUE;
			END_IF
	END_IF

	//VERMELHO
	IF 	LA_GERAL.bit_LAMP_VERMELHO_PULSO	AND
		LA_GERAL.bit_LAMP_VERMELHO			THEN
			tmr_LAMP_VERMELHO_ON.IN	:= TRUE;
			IF	tmr_LAMP_VERMELHO_ON.Q		THEN
					tmr_LAMP_VERMELHO_ON.IN	:= FALSE;
					LA_GERAL.bit_LAMP_VERMELHO	:=	FALSE;
			END_IF
	END_IF
	
	IF 	LA_GERAL.bit_LAMP_VERMELHO_PULSO	AND
	NOT	LA_GERAL.bit_LAMP_VERMELHO		THEN
			tmr_LAMP_VERMELHO_OFF.IN	:= TRUE;
			IF	tmr_LAMP_VERMELHO_OFF.Q		THEN
					tmr_LAMP_VERMELHO_OFF.IN	:= FALSE;
					LA_GERAL.bit_LAMP_VERMELHO	:=	TRUE;
			END_IF
	END_IF
	
(*	
		//SONORO
	IF 	GVL_CELULA.bit_SONORO_PULSO	AND
		GVL_CELULA.bit_TL_SONORO		THEN
			tmr_TL_SONORO_ON.IN	:= TRUE;
			IF	tmr_TL_SONORO_ON.Q		THEN
					tmr_TL_SONORO_ON.IN	:= FALSE;
					GVL_CELULA.bit_TL_SONORO	:=	FALSE;
					GVL_CELULA.bit_LAMP_AMARELO := FALSE;
			END_IF
	END_IF
	
	IF 	GVL_CELULA.bit_SONORO_PULSO	AND
	NOT GVL_CELULA.bit_TL_SONORO		THEN
			tmr_TL_SONORO_OFF.IN	:= TRUE;
			IF	tmr_TL_SONORO_OFF.Q		THEN
					tmr_TL_SONORO_OFF.IN	:= FALSE;
					GVL_CELULA.bit_TL_SONORO	:=	TRUE;
					GVL_CELULA.bit_LAMP_AMARELO := TRUE;
			END_IF
	END_IF	
	
	//ativa alarme sonoro
	IF 	GVL_CELULA.bit_ALARME_AR_CASE_ATIVO		THEN
			GVL_CELULA.bit_SONORO_PULSO				:= TRUE;
			GVL_CELULA.bit_LAMP_AZUL_PULSO			:= TRUE;
	ELSE
			GVL_CELULA.bit_SONORO_PULSO				:= FALSE;
			GVL_CELULA.bit_LAMP_AZUL_PULSO			:= FALSE;
			GVL_CELULA.bit_LAMP_AMARELO 				:= FALSE;
			GVL_CELULA.bit_TL_SONORO					:= FALSE;
	END_IF*)
	
		//INSPECAO
	IF 	LA_GERAL.bit_LAMP_INSPECAO_PULSO	AND
		LA_GERAL.bit_LAMP_INSPECAO		THEN
			tmr_LAMP_INSPECAO_ON.IN	:= TRUE;
			IF	tmr_LAMP_INSPECAO_ON.Q		THEN
					tmr_LAMP_INSPECAO_ON.IN	:= FALSE;
					LA_GERAL.bit_LAMP_INSPECAO	:=	FALSE;
			END_IF
	END_IF
	
	IF 	LA_GERAL.bit_LAMP_INSPECAO_PULSO	AND
	NOT	LA_GERAL.bit_LAMP_INSPECAO		THEN
			tmr_LAMP_INSPECAO_OFF.IN	:= TRUE;
			IF	tmr_LAMP_INSPECAO_OFF.Q		THEN
					tmr_LAMP_INSPECAO_OFF.IN	:= FALSE;
					LA_GERAL.bit_LAMP_INSPECAO	:=	TRUE;
			END_IF
	END_IF


//================================================================================================================================================================================
//MIRRORS

	//LAMPADA VERDE
	LA_GERAL.do_TL1_VERDE		:= LA_GERAL.bit_LAMP_VERDE;
	LA_GERAL.do_TL2_VERDE		:= LA_GERAL.bit_LAMP_VERDE;

	//LAMPADA VERMELHA
	LA_GERAL.do_TL1_VERMELHO	:= LA_GERAL.bit_LAMP_VERMELHO;
	LA_GERAL.do_TL2_VERMELHO	:= LA_GERAL.bit_LAMP_VERMELHO;
	
	//LAMPADA AMARELO
	LA_GERAL.do_TL1_AMARELO		:= LA_GERAL.bit_LAMP_AZUL;
	LA_GERAL.do_TL2_AMARELO		:= LA_GERAL.bit_LAMP_AZUL;

	//SONORO
	LA_GERAL.do_TL1_SONORO		:= LA_GERAL.bit_TL_SONORO;
	
	//INSPEÇÃO
	bt_LAMP_INSPECAO_OK := LA_GERAL.bit_LAMP_INSPECAO;
	

//================================================================================================================================================================================
//TIMERS
tmr_LAMP_VERDE_ON		(PT:= T#500MS);
tmr_LAMP_VERDE_OFF		(PT:= T#500MS);
tmr_LAMP_VERMELHO_ON	(PT:= T#500MS);
tmr_LAMP_VERMELHO_OFF	(PT:= T#500MS);
tmr_LAMP_AMARELO_ON		(PT:= T#500MS);
tmr_LAMP_AMARELO_OFF	(PT:= T#500MS);
tmr_LAMP_AZUL_ON		(PT:= T#500MS);
tmr_LAMP_AZUL_OFF		(PT:= T#2400MS);
tmr_TL_SONORO_ON		(PT:= T#500MS);
tmr_TL_SONORO_OFF		(PT:= T#500MS);
tmr_ALERTA_SONORO		(PT:= T#3000MS);
tmr_LAMP_INSPECAO_ON	(PT:= T#500MS);
tmr_LAMP_INSPECAO_OFF	(PT:= T#500MS);</Single>
            <Single Name="LineInfoPersistence" Type="string">4259604c-6061-43eb-a541-99a786b31938_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM A02_LAMPADAS
VAR
	tmr_LAMP_VERDE_ON		: TON;
	tmr_LAMP_VERDE_OFF		: TON;
	tmr_LAMP_VERMELHO_ON	: TON;
	tmr_LAMP_VERMELHO_OFF	: TON;
	tmr_LAMP_AMARELO_ON		: TON;
	tmr_LAMP_AMARELO_OFF	: TON;
	tmr_LAMP_AZUL_ON		: TON;
	tmr_LAMP_AZUL_OFF		: TON;
	tmr_TL_SONORO_ON		: TON;
	tmr_TL_SONORO_OFF		: TON;
	tmr_ALERTA_SONORO		: TON;
	tmr_LAMP_INSPECAO_ON	: TON;
	tmr_LAMP_INSPECAO_OFF	: TON;
	
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">4259604c-6061-43eb-a541-99a786b31938_Decl_LineIds</Single>
