            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM C03_EST_ENTRADA
VAR
	passo_EST_ENTRADA	: INT := 9;
	RESET_ROTINA		: BOOL;
	
	f_trig_SENS_ENTRADA : F_TRIG;
	tmr_PARAR_ESTEIRA	: TON;
END_VAR
</Single>
