      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Pulso de apenas um ciclo
xDone := FALSE;

// Borda de subida para selecionar a macro
rtSelecionar(CLK := xSelecionar);


// ============================================================
// CLIENTE TCP
// ============================================================

// Entrada herdada do CBM.LTrig
fbTCPClient.xEnable := xEnable;

fbTCPClient(
    udiTimeOut  := UDINT#5_000_000,
    ipAddr      := stIPMarkem,
    uiPort      := UINT#9100,
    eError      =&gt; eErroCliente,
    xActive     =&gt; xClienteAtivo,
    hConnection =&gt; hConnectionMarkem
);

xConnected := xClienteAtivo;


// ============================================================
// MÁQUINA DE ESTADOS
// ============================================================

IF NOT xEnable THEN

    uiEstado := 0;
    xExecuteWrite := FALSE;
    xBusy := FALSE;
    xErroInterno := FALSE;

ELSE

    CASE uiEstado OF

        // ----------------------------------------------------
        // Estado 0: aguardando comando
        // ----------------------------------------------------
        0:
            xExecuteWrite := FALSE;
            xBusy := FALSE;

            IF rtSelecionar.Q THEN

                xErroInterno := FALSE;

                IF xClienteAtivo
                   AND (LEN(sNomeMacro) &gt; 0) THEN

                    // Memoriza o nome para que não mude
                    // durante o envio
                    sMacroPendente := sNomeMacro;

                    // Monta:
                    // !M "40x50"&lt;CR&gt;
                    sBufferTX := CONCAT(
                        '!M "',
                        sMacroPendente
                    );

                    sBufferTX := CONCAT(
                        sBufferTX,
                        '"$R'
                    );

                    // Converte o tamanho para CAA.SIZE
                    szTamanhoTX :=
                        CAA.UDINT_TO_SIZE(
                            TO_UDINT(LEN(sBufferTX))
                        );

                    // Gera borda de subida no TCP_Write
                    xExecuteWrite := TRUE;
                    xBusy := TRUE;

                    uiEstado := 10;

                ELSE

                    xErroInterno := TRUE;

                END_IF;

            END_IF;


        // ----------------------------------------------------
        // Estado 10: aguardando o envio terminar
        // ----------------------------------------------------
        10:
            xExecuteWrite := TRUE;
            xBusy := TRUE;

            IF fbTCPWrite.xDone THEN

                xExecuteWrite := FALSE;
                xBusy := FALSE;

                sUltimaMacroEnviada :=
                    sMacroPendente;

                xDone := TRUE;

                uiEstado := 20;

            ELSIF fbTCPWrite.xError THEN

                xExecuteWrite := FALSE;
                xBusy := FALSE;
                xErroInterno := TRUE;

                uiEstado := 20;

            ELSIF NOT xClienteAtivo THEN

                xExecuteWrite := FALSE;
                xBusy := FALSE;
                xErroInterno := TRUE;

                uiEstado := 20;

            END_IF;


        // ----------------------------------------------------
        // Estado 20: reseta o TCP_Write
        // ----------------------------------------------------
        20:
            // O TCP_Write precisa receber FALSE depois
            // da conclusão para poder detectar uma nova borda
            xExecuteWrite := FALSE;
            xBusy := FALSE;

            uiEstado := 0;


        ELSE

            uiEstado := 0;
            xExecuteWrite := FALSE;
            xBusy := FALSE;

    END_CASE;

END_IF;


// ============================================================
// ESCRITA TCP
// ============================================================

// Entradas herdadas do CBM.ETrigTo
fbTCPWrite.xExecute := xExecuteWrite;
fbTCPWrite.udiTimeOut := UDINT#0;

fbTCPWrite(
    hConnection := hConnectionMarkem,
    szSize       := szTamanhoTX,
    pData        := ADR(sBufferTX),
    eError       =&gt; eErroEscrita
);


// ============================================================
// DIAGNÓSTICO GERAL
// ============================================================

xError :=
    xErroInterno
    OR fbTCPClient.xError
    OR fbTCPWrite.xError;</Single>
            <Single Name="LineInfoPersistence" Type="string">1b95b5ac-a538-4ad9-86d1-472ad5604c87_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_Markem_SelecionarMacro
VAR_INPUT
    // Habilita a conexão TCP
    xEnable : BOOL;

    // Pulso para selecionar uma macro
    xSelecionar : BOOL;

    // Nome da macro, sem extensão
    sNomeMacro : STRING(24);
END_VAR

VAR_OUTPUT
    // Conexão estabelecida com a Markem
    xConnected : BOOL;

    // Envio em andamento
    xBusy : BOOL;

    // Pulso de conclusão
    xDone : BOOL;

    // Erro geral
    xError : BOOL;

    // Última macro enviada
    sUltimaMacroEnviada : STRING(24);

    // Diagnósticos da biblioteca
    eErroCliente : NBS.ERROR;
    eErroEscrita : NBS.ERROR;
END_VAR

VAR
    // Comunicação CAA
    fbTCPClient : NBS.TCP_Client;
    fbTCPWrite  : NBS.TCP_Write;

    // Endereço IP da impressora
    stIPMarkem : NBS.IP_ADDR :=
        (sAddr := '192.168.0.40');

    // Handle entregue pelo TCP_Client
    hConnectionMarkem : CAA.HANDLE :=
        CAA.gc_hINVALID;

    // Controle interno
    xClienteAtivo : BOOL;
    xExecuteWrite : BOOL;
    xErroInterno  : BOOL;

    // Telegrama
    sBufferTX : STRING(100);
    szTamanhoTX : CAA.SIZE;

    // Nome memorizado durante o envio
    sMacroPendente : STRING(24);

    // Máquina de estados
    uiEstado : UINT;

    // Borda de subida
    rtSelecionar : R_TRIG;
END_VAR</Single>
