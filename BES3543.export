          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639220389115088450</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">	IF LA_IHM.bit_HORARIO_DIA_COMPLETO_REAL THEN
		LA_IHM.info_DIA_ANTERIOR := LA_IHM.HORARIO_ATUAL_DIA;
		LA_IHM.info_MES_ANTERIOR := LA_IHM.HORARIO_ATUAL_MES;
	END_IF
	
//================================================================================================================================================================================
//================================================================================================================================================================================
//ARMAZENAMENTO DE DADOS DE PRODUÇÃO DE TURNO

	//ARMAZENAMENTO DE DADOS DE PRODUÇÃO TURNO A
	IF LA_IHM.turno_A	THEN
		
		PVAR.IHM_DIA_TURNO_ARRAY.PRIMEIRO[0] := LA_IHM.HORARIO_ATUAL_DIA;
		PVAR.IHM_MES_TURNO_ARRAY.PRIMEIRO[0] := LA_IHM.HORARIO_ATUAL_MES;
		
		PVAR.IHM_TEMPO_RODANDO_ARRAY.PRIMEIRO[0] := TIME_TO_DINT(pvar.RTON_tmr_MAQUINA_RODANDO_T1.RTON_ET);
		PVAR.IHM_TEMPO_PARADO_ARRAY.PRIMEIRO[0]  := TIME_TO_DINT(pvar.RTON_tmr_MAQUINA_PARADA_T1.RTON_ET);
		PVAR.IHM_TEMPO_OCIOSO_ARRAY.PRIMEIRO[0]  := TIME_TO_DINT(pvar.RTON_tmr_MAQUINA_OCIOSA_T1.RTON_ET);
	
		PVAR.ihm_PILHAS_COMPLETADAS_TURNO_ARRAY.PRIMEIRO[0]		:=	pvar.cont_PILHAS_COMPLETADAS_TURNO_1.CV;
		PVAR.ihm_PILHAS_REJEITADAS_TURNO_ARRAY.PRIMEIRO[0]		:=	pvar.cont_PILHAS_REJEITADAS_TURNO_1.CV;
		PVAR.ihm_PILHAS_TOTAL_TURNO_ARRAY.PRIMEIRO[0]			:=	pvar.cont_PILHAS_TOTAL_TURNO_1.CV;
		
		PVAR.ihm_PILHAS_COMPLETADAS_PORCENTAGEM_TURNO_ARRAY.PRIMEIRO[0]	:=	REAL_TO_DINT(LA_IHM.num_PORCENTAGEM_COMPLETADAS_T1);
		PVAR.ihm_PILHAS_REJEITADAS_PORCENTAGEM_TURNO_ARRAY.PRIMEIRO[0]	:=	REAL_TO_DINT(LA_IHM.num_PORCENTAGEM_REJEITADAS_T1);
	END_IF
	
	//ARMAZENAMENTO DE DADOS DE PRODUÇÃO TURNO B
	IF LA_IHM.turno_B	THEN
		
		PVAR.IHM_DIA_TURNO_ARRAY.SEGUNDO[0] := LA_IHM.HORARIO_ATUAL_DIA;
		PVAR.IHM_MES_TURNO_ARRAY.SEGUNDO[0] := LA_IHM.HORARIO_ATUAL_MES;
		
		PVAR.IHM_TEMPO_RODANDO_ARRAY.SEGUNDO[0] := TIME_TO_DINT(pvar.RTON_tmr_MAQUINA_RODANDO_T2.RTON_ET);
		PVAR.IHM_TEMPO_PARADO_ARRAY.SEGUNDO[0]  := TIME_TO_DINT(pvar.RTON_tmr_MAQUINA_PARADA_T2.RTON_ET);
		PVAR.IHM_TEMPO_OCIOSO_ARRAY.SEGUNDO[0]  := TIME_TO_DINT(pvar.RTON_tmr_MAQUINA_OCIOSA_T2.RTON_ET);
		
		PVAR.ihm_PILHAS_COMPLETADAS_TURNO_ARRAY.SEGUNDO[0]		:=	pvar.cont_PILHAS_COMPLETADAS_TURNO_2.CV;
		PVAR.ihm_PILHAS_REJEITADAS_TURNO_ARRAY.SEGUNDO[0]		:=	pvar.cont_PILHAS_REJEITADAS_TURNO_2.CV;
		PVAR.ihm_PILHAS_TOTAL_TURNO_ARRAY.SEGUNDO[0]			:=	pvar.cont_PILHAS_TOTAL_TURNO_2.CV;
		
		PVAR.ihm_PILHAS_COMPLETADAS_PORCENTAGEM_TURNO_ARRAY.SEGUNDO[0]	:=	REAL_TO_DINT(LA_IHM.num_PORCENTAGEM_COMPLETADAS_T2);
		PVAR.ihm_PILHAS_REJEITADAS_PORCENTAGEM_TURNO_ARRAY.SEGUNDO[0]	:=	REAL_TO_DINT(LA_IHM.num_PORCENTAGEM_REJEITADAS_T2);
	END_IF
	
	//ARMAZENAMENTO DE DADOS DE PRODUÇÃO TURNO C
	IF LA_IHM.turno_C	THEN
	
	IF LA_IHM.HORARIO_ATUAL_HORA &lt;= 5 THEN
		PVAR.IHM_DIA_TURNO_ARRAY.TERCEIRO[0] := LA_IHM.HORARIO_ATUAL_DIA - 1;
		PVAR.IHM_MES_TURNO_ARRAY.TERCEIRO[0] := LA_IHM.HORARIO_ATUAL_MES;
	ELSE
		PVAR.IHM_DIA_TURNO_ARRAY.TERCEIRO[0] := LA_IHM.HORARIO_ATUAL_DIA;
		PVAR.IHM_MES_TURNO_ARRAY.TERCEIRO[0] := LA_IHM.HORARIO_ATUAL_MES;
	END_IF
		
		PVAR.IHM_TEMPO_RODANDO_ARRAY.TERCEIRO[0] := TIME_TO_DINT(pvar.RTON_tmr_MAQUINA_RODANDO_T3.RTON_ET);
		PVAR.IHM_TEMPO_PARADO_ARRAY.TERCEIRO[0]  := TIME_TO_DINT(pvar.RTON_tmr_MAQUINA_PARADA_T3.RTON_ET);
		PVAR.IHM_TEMPO_OCIOSO_ARRAY.TERCEIRO[0]  := TIME_TO_DINT(pvar.RTON_tmr_MAQUINA_OCIOSA_T3.RTON_ET);
		
		PVAR.ihm_PILHAS_COMPLETADAS_TURNO_ARRAY.TERCEIRO[0]		:=	pvar.cont_PILHAS_COMPLETADAS_TURNO_3.CV;
		PVAR.ihm_PILHAS_REJEITADAS_TURNO_ARRAY.TERCEIRO[0]		:=	pvar.cont_PILHAS_REJEITADAS_TURNO_3.CV;
		PVAR.ihm_PILHAS_TOTAL_TURNO_ARRAY.TERCEIRO[0]			:=	pvar.cont_PILHAS_TOTAL_TURNO_3.CV;
		
		PVAR.ihm_PILHAS_COMPLETADAS_PORCENTAGEM_TURNO_ARRAY.TERCEIRO[0]	:=	REAL_TO_DINT(LA_IHM.num_PORCENTAGEM_COMPLETADAS_T3);
		PVAR.ihm_PILHAS_REJEITADAS_PORCENTAGEM_TURNO_ARRAY.TERCEIRO[0]	:=	REAL_TO_DINT(LA_IHM.num_PORCENTAGEM_REJEITADAS_T3);
	END_IF
	
	
