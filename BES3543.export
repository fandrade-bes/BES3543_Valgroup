            <Single Name="TextBlobForSerialisation" Type="string">IF LA_IHM.bit_bt_RESET_EST_TR	THEN
	 passo_EST_TRANSPORTADOR := 9;
END_IF



CASE passo_EST_TRANSPORTADOR OF

//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
09: //RESET VARIAVEIS

	//caso não há presença de sacola no sensor, declara que a pilha de sacolas está posicionada
	IF sens_POS_1_ENVOLVEDOR AND sens_POS_2_ENVOLVEDOR AND LA_GERAL.bit_SAFETY_ATIVO THEN
		LA_ENV.bit_ENVOLVEDOR_SACOLA_POSICIONADA	:= TRUE;
	ELSE
		LA_ENV.bit_ENVOLVEDOR_SACOLA_POSICIONADA	:= FALSE;
	END_IF
	
	passo_EST_TRANSPORTADOR 							:= 999;
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
999://se pilha de sacola estiver posicionada, declara que está posicionada para garra pegar e desliga esteira. Se não, mantém ela ligada

	(*IF sens_POS_2_ENVOLVEDOR (*AND sens_POS_2_ENVOLVEDOR sens_FILME_ENVOLVEDOR*) THEN
		//GVL_ENVOLVEDOR.est_TRANSPORTADOR_ENVOLVEDOR			:=	FALSE;
		tmr_PILHA_POSICIONADA.IN							:= 	TRUE;
	ELSE
		GVL_ENVOLVEDOR.est_TRANSPORTADOR_ENVOLVEDOR			:=	TRUE;
	END_IF
	
	IF tmr_PILHA_POSICIONADA.Q	THEN
		GVL_ENVOLVEDOR.bit_ENVOLVEDOR_SACOLA_POSICIONADA	:=	TRUE;
		GVL_ENVOLVEDOR.est_TRANSPORTADOR_ENVOLVEDOR			:=	FALSE;
		passo_EST_TRANSPORTADOR								:= 	1000;
	END_IF*)
	
	IF sens_POS_1_ENVOLVEDOR AND LA_GERAL.bit_MAQUINA_RODANDO THEN	
		tmr_PILHA_POSICIONADA.IN							:= 	TRUE;
	ELSE
		LA_ENV.est_TRANSPORTADOR_ENVOLVEDOR			:=	TRUE;
	END_IF
	
	IF tmr_PILHA_POSICIONADA.Q	THEN
		LA_ENV.bit_ENVOLVEDOR_SACOLA_POSICIONADA	:=	TRUE;
		LA_ENV.est_TRANSPORTADOR_ENVOLVEDOR			:=	FALSE;
		LA_ENV.est_TRANSPORTADOR_ENVOLVEDOR			:=	FALSE;
		passo_EST_TRANSPORTADOR								:= 	1000;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1000://após confirmação de que a sacola não está mais posicionada, liga esteira e reinicia ciclo

	tmr_PILHA_POSICIONADA.IN	:=	FALSE;

	IF NOT LA_ENV.bit_ENVOLVEDOR_SACOLA_POSICIONADA THEN
		LA_ENV.est_TRANSPORTADOR_ENVOLVEDOR			:=	TRUE;
		passo_EST_TRANSPORTADOR								:= 	999;
	END_IF



END_CASE



//tmr_PILHA_POSICIONADA(PT:= T#1355MS);//pilha 40x50
//tmr_PILHA_POSICIONADA(PT:= T#1325MS);//pilha 36x48
tmr_PILHA_POSICIONADA(PT:= T#18MS);//pilha 50x60</Single>
            <Single Name="LineInfoPersistence" Type="string">3c170d13-7d36-44f7-9b7e-713371ccf92a_Impl_LineIds</Single>
          </Single>
        </Single>
