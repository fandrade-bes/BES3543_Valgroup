            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM B03_INSPECAO
VAR
	passo_INSPECAO		: INT := 9;
	tmr_INSPECAO_OK		: TON;
	tmr_LIBERA_INSPECAO_OK		: TON;
END_VAR
</Single>
