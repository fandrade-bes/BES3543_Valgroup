      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">IF LA_IHM.bit_bt_RESET_EST_ENTRADA	THEN
	 passo_EST_ENTRADA := 9;
END_IF



CASE passo_EST_ENTRADA OF
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
09: //RESET VARIAVEIS

	//caso não há presença de sacola no sensor, declara que a esteira está cheia
	IF sens_EST_TRANS_PRESENCA THEN
		LA_ENV.bit_EST_ENTRADA_CHEIA	:= TRUE;
		passo_EST_ENTRADA 						:= 999;
	ELSE
		LA_ENV.bit_EST_ENTRADA_CHEIA	:=	FALSE;
		passo_EST_ENTRADA := 998;
	END_IF
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
998://Prepara para iniciar ciclo e liga esteira

	LA_ENV.est_ENTRADA_ENVOLVEDOR	:=	true;
	passo_EST_ENTRADA 						:= 	999;
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
999://se houver pilha de sacola no final da esteira, declara que está com esteira de entrada do envolvedor cheia para impedir que mesa de giro libere roletes
	//se não houver pilha de sacola na esteira transportadora, deixa esteira ligada

	
	IF NOT 	LA_ENV.bit_ENVOLVEDOR_SACOLA_POSICIONADA AND 
			LA_GERAL.bit_MAQUINA_RODANDO 					 AND 
			LA_EMP.bit_ENTREGANDO_PILHA_COMPLETA   THEN
				LA_ENV.est_ENTRADA_ENVOLVEDOR	:=	TRUE;
				passo_EST_ENTRADA 						:= 	1000;
	END_IF
	
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1000:

	IF LA_ENV.bit_ENVOLVEDOR_SACOLA_POSICIONADA AND sens_EST_TRANS_PRESENCA THEN
		LA_ENV.est_ENTRADA_ENVOLVEDOR	:=	FALSE;
	ELSE
		LA_ENV.est_ENTRADA_ENVOLVEDOR	:=	TRUE;
	END_IF
	
	
	IF f_trig_SENS_ENTRADA.Q THEN
		tmr_PARAR_ESTEIRA.IN					:=	TRUE;
		passo_EST_ENTRADA 						:= 	1001;
	END_IF
	
	
	
//--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1001:

	IF tmr_PARAR_ESTEIRA.Q	AND LA_GERAL.bit_MAQUINA_RODANDO	THEN
		tmr_PARAR_ESTEIRA.IN					:=	FALSE;
		LA_ENV.est_ENTRADA_ENVOLVEDOR	:=	FALSE;	
		passo_EST_ENTRADA 						:= 	999;
	END_IF



END_CASE


	IF sens_EST_TRANS_PRESENCA THEN
		LA_ENV.bit_EST_ENTRADA_CHEIA	:=	TRUE;
	ELSE
		LA_ENV.bit_EST_ENTRADA_CHEIA	:=	FALSE;
	END_IF
	
	tmr_PARAR_ESTEIRA(PT:= T#500MS);
	f_trig_SENS_ENTRADA(CLK:= sens_EST_TRANS_PRESENCA);</Single>
            <Single Name="LineInfoPersistence" Type="string">d1f7e7e7-14a1-44d4-8d45-75c5a32fd9e0_Impl_LineIds</Single>
